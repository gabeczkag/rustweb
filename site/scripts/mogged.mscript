const W = 1920;
const H = 1080;
const DURATION = 4;
const FPS = 60;
const FRAMES = DURATION * FPS;

const C = {
  bg: "#0f1115",
  panel: "#151920",
  panel2: "#1a1f28",
  line: "#2a3039",
  ink: "#f4f1e8",
  muted: "#8b919b",
  coral: "#ff5a4e",
  blue: "#4ea1ff",
  lime: "#b7ff4a",
  purple: "#a78bfa",
};

const SCENES = [
  { start: 0, label: "00 // RUSTWEB" },
  { start: 0.4, label: "01 // API" },
  { start: 0.8, label: "02 // MHTML" },
  { start: 1.2, label: "03 // CERT DB" },
  { start: 1.6, label: "04 // TCPs" },
  { start: 2.0, label: "05 // UC" },
  { start: 2.4, label: "06 // GAME LAB" },
  { start: 2.8, label: "07 // DEPLOY" },
  { start: 3.2, label: "08 // BENCH" },
  { start: 3.6, label: "09 // OUTRO" },
];

const TICKER = [
  "210 750 REQ/S",
  "1 FILE .RWEB",
  "56 TESTS",
  "4.7 GIB/S STREAMING",
  "0 RUNTIME TEMPLATING",
  "10 ROUTES",
  "0 PLAINTEXT UUID",
  "9 GAME SYSTEMS",
  "DOCKER READY",
  "4 KB UC PACKETS",
];

let activeReel = null;

function initReel() {
  const canvas = document.getElementById("reel-canvas");
  if (!canvas || canvas.dataset.reelBound === "1") return;
  canvas.dataset.reelBound = "1";

  let context;
  try {
    context = canvas.getContext("2d");
  } catch {
    context = null;
  }
  if (!context) return;

  if (activeReel) activeReel.destroy();
  activeReel = createReel(canvas, context);
}

function createReel(canvas, ctx) {
  const stage = document.getElementById("reel-stage");
  const playButton = document.getElementById("reel-play");
  const restartButton = document.getElementById("reel-restart");
  const fullButton = document.getElementById("reel-full");
  const scrub = document.getElementById("reel-scrub");
  const frameNode = document.getElementById("reel-frame");
  const frameHud = document.getElementById("reel-frame-hud");
  const timecode = document.getElementById("reel-timecode");
  const sceneHud = document.getElementById("reel-scene-hud");
  const playhead = document.getElementById("reel-playhead");
  const timeline = document.getElementById("reel-timeline");
  const liveTicker = document.getElementById("reel-live-ticker");
  const reduced = window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;

  const query = new URLSearchParams(location.search);
  const requestedFrame = Number(query.get("frame"));
  const still = query.get("still") === "1";
  let time = Number.isFinite(requestedFrame)
    ? Math.max(0, Math.min(FRAMES - 1, requestedFrame)) / FPS
    : 0;
  let playing = !reduced && !still;
  let destroyed = false;
  let previous = 0;
  let raf = 0;

  function clamp01(value) {
    return Math.max(0, Math.min(1, value));
  }

  function easeOutExpo(value) {
    return value >= 1 ? 1 : 1 - Math.pow(2, -10 * value);
  }

  function easeOutCubic(value) {
    return 1 - Math.pow(1 - value, 3);
  }

  function easeOutBack(value) {
    const c1 = 1.70158;
    const c3 = c1 + 1;
    return 1 + c3 * Math.pow(value - 1, 3) + c1 * Math.pow(value - 1, 2);
  }

  function clear(color = C.bg) {
    ctx.globalAlpha = 1;
    ctx.fillStyle = color;
    ctx.fillRect(0, 0, W, H);

    ctx.strokeStyle = C.line;
    ctx.globalAlpha = 0.28;
    ctx.lineWidth = 1;
    for (let x = 0; x <= W; x += 48) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, H);
      ctx.stroke();
    }
    for (let y = 0; y <= H; y += 48) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(W, y);
      ctx.stroke();
    }

    ctx.strokeStyle = C.coral;
    ctx.globalAlpha = 0.08;
    for (let x = -H; x < W + H; x += 240) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x + H, H);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
    ctx.textAlign = "left";
    ctx.textBaseline = "middle";
  }

  function font(size, family = '"Arial Black", Impact, sans-serif') {
    ctx.font = `900 ${size}px ${family}`;
    ctx.textBaseline = "middle";
  }

  function mono(size, color = C.muted) {
    ctx.font = `700 ${size}px ui-monospace, SFMono-Regular, Menlo, monospace`;
    ctx.textBaseline = "middle";
    ctx.fillStyle = color;
  }

  function label(text, x, y, size = 16, color = C.coral) {
    mono(size, color);
    ctx.textAlign = "left";
    ctx.fillText(text, x, y);
  }

  function heading(index, title, x = 90, y = 120) {
    label(index, x, y, 15, C.coral);
    font(74);
    ctx.fillStyle = C.ink;
    ctx.textAlign = "left";
    ctx.fillText(title, x, y + 74);
  }

  function panel(x, y, width, height, fill = C.panel) {
    ctx.fillStyle = fill;
    ctx.fillRect(x, y, width, height);
    ctx.strokeStyle = C.line;
    ctx.lineWidth = 2;
    ctx.strokeRect(x, y, width, height);
  }

  function chip(text, x, y, color = C.blue) {
    mono(14, color);
    const width = ctx.measureText(text).width + 26;
    ctx.strokeStyle = color;
    ctx.lineWidth = 1;
    ctx.strokeRect(x, y - 15, width, 30);
    ctx.fillText(text, x + 13, y + 1);
  }

  function bar(text, value, fraction, x, y, width, color) {
    mono(15, C.muted);
    ctx.fillText(text, x, y);
    ctx.fillStyle = C.line;
    ctx.fillRect(x, y + 18, width, 10);
    ctx.fillStyle = color;
    ctx.fillRect(x, y + 18, width * clamp01(fraction), 10);
    mono(13, color);
    ctx.textAlign = "right";
    ctx.fillText(value, x + width, y);
    ctx.textAlign = "left";
  }

  function code(lines, x, y, width, height) {
    panel(x, y, width, height, "#0b0e12");
    let lineY = y + 38;
    for (const line of lines) {
      const isComment = line.trim().startsWith("//");
      mono(17, isComment ? C.muted : line.includes("#[") ? C.coral : C.ink);
      ctx.fillText(line, x + 22, lineY);
      lineY += 30;
    }
  }

  function fileIcon(x, y, size, color) {
    ctx.fillStyle = color;
    ctx.fillRect(x, y, size * 0.72, size);
    ctx.fillStyle = C.bg;
    ctx.beginPath();
    ctx.moveTo(x + size * 0.72, y);
    ctx.lineTo(x + size, y + size * 0.28);
    ctx.lineTo(x + size * 0.72, y + size * 0.28);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x + size * 0.72, y);
    ctx.lineTo(x + size * 0.72, y + size * 0.28);
    ctx.lineTo(x + size, y + size * 0.28);
    ctx.closePath();
    ctx.fill();
  }

  function drawIntro(local) {
    clear();
    const p = clamp01(local);

    ctx.strokeStyle = C.blue;
    ctx.globalAlpha = 0.22;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(1540, 370, 250 + Math.sin(p * Math.PI) * 18, 0, Math.PI * 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(1540, 370, 180, 0, Math.PI * 2);
    ctx.stroke();
    ctx.globalAlpha = 1;

    label("PRODUCT REEL // 00", 90, 100, 15, C.lime);
    font(150);
    ctx.fillStyle = C.ink;
    ctx.fillText("RUSTWEB", 90, 280);
    font(150);
    ctx.fillStyle = C.coral;
    ctx.fillText("ONE STACK.", 90, 430);
    mono(24, C.muted);
    ctx.fillText("API / FRONTEND / CERTS / PACKETS / GAMES", 94, 520);

    const cards = [
      ["210 750", "REQ/S", C.blue],
      ["1 FILE", ".RWEB", C.lime],
      ["56", "TESTS", C.coral],
      ["4.7 GIB/S", "STREAMING", C.purple],
    ];
    for (const [index, [value, name, color]] of cards.entries()) {
      const x = 90 + index * 445;
      const y = 640 + Math.sin(p * Math.PI + index) * 6;
      panel(x, y, 410, 170);
      font(54);
      ctx.fillStyle = color;
      ctx.fillText(value, x + 24, y + 64);
      mono(14, C.muted);
      ctx.fillText(name, x + 26, y + 118);
    }

    // A dense "product bus" under the cards.
    ctx.strokeStyle = C.line;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(90, 900);
    ctx.lineTo(W - 90, 900);
    ctx.stroke();
    for (let index = 0; index < 12; index += 1) {
      const x = 90 + ((p * 1800 + index * 154) % 1740);
      ctx.fillStyle = index % 3 === 0 ? C.coral : index % 3 === 1 ? C.blue : C.lime;
      ctx.beginPath();
      ctx.arc(x, 900, 5, 0, Math.PI * 2);
      ctx.fill();
    }

  }

  function drawApi(local) {
    clear();
    const p = clamp01(local);
    heading("01 // API W RUSTCIE", "FASTAPI DX. RUST CORE.");

    font(190);
    ctx.fillStyle = C.blue;
    ctx.fillText("210 750", 90, 390);
    mono(24, C.muted);
    ctx.fillText("REQ/S", 96, 472);
    mono(17, C.lime);
    ctx.fillText("p99 0.70 MS  //  axum in the hot path", 98, 530);

    const bars = [
      ["RUSTWEB", "210 750", 1.0, C.blue],
      ["PLAIN AXUM", "208 173", 0.99, C.lime],
      ["FASTAPI", "14 000", 0.07, C.coral],
    ];
    for (const [index, [name, value, fraction, color]] of bars.entries()) {
      bar(name, value, fraction * easeOutCubic(clamp01(p * 2)), 90, 630 + index * 76, 810, color);
    }

    code(
      [
        '#[get("/users/{id}")]',
        "async fn get_user(",
        "  ApiPath(id): ApiPath<u64>",
        ") -> ApiResult<Json<User>> {",
        "  Ok(Json(User { id, .. }))",
        "}",
      ],
      1100,
      230,
      730,
      340,
    );

    ctx.strokeStyle = C.coral;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(1100, 680);
    ctx.lineTo(1830, 680);
    ctx.stroke();
    for (let index = 0; index < 8; index += 1) {
      const x = 1100 + ((p * 900 + index * 100) % 730);
      ctx.fillStyle = index % 2 === 0 ? C.coral : C.blue;
      ctx.beginPath();
      ctx.arc(x, 680, 4, 0, Math.PI * 2);
      ctx.fill();
    }
    mono(14, C.muted);
    ctx.fillText("POST /users  ->  201  ->  JSON", 1100, 730);

  }

  function drawMhtml(local) {
    clear();
    const p = clamp01(local);
    heading("02 // MHTML -> .RWEB", "ONE FILE. ZERO RUNTIME.");

    for (let index = 3; index > 0; index -= 1) {
      panel(90 + index * 16, 260 + index * 16, 500, 300, C.panel2);
    }
    panel(90, 260, 500, 300);
    fileIcon(130, 300, 100, C.coral);
    font(72);
    ctx.fillStyle = C.ink;
    ctx.fillText(".rweb", 130, 470);
    mono(15, C.muted);
    ctx.fillText("site.rweb  //  144 KB", 132, 520);

    const routes = ["/", "/about", "/bench", "/viewer", "/cert", "/game", "/deploy", "/baner", "/market", "/mogged"];
    for (const [index, route] of routes.entries()) {
      chip(route, 690 + (index % 3) * 190, 290 + Math.floor(index / 3) * 64, index % 2 === 0 ? C.lime : C.blue);
    }

    code(
      [
        "<h1>{{ title }}</h1>",
        "@if show_badge {",
        '  <span class="badge">{{ version }}</span>',
        "}",
        "@for feature in features {",
        "  <article>{{ feature.title }}</article>",
        "}",
      ],
      690,
      520,
      540,
      260,
    );

    bar("ROUTES", "10", 1, 1280, 560, 450, C.lime);
    bar("RUNTIME TEMPLATING", "0", 0, 1280, 630, 450, C.coral);
    bar("FRONTEND SIZE", "144 KB", 0.64, 1280, 700, 450, C.blue);

    ctx.globalAlpha = 0.35;
    mono(22, C.ink);
    for (let index = 0; index < 3; index += 1) {
      ctx.fillText("MHTML / MCSS / MSCRIPT", 690 + Math.sin(p * Math.PI + index) * 20, 810 - index * 24);
    }
    ctx.globalAlpha = 1;

  }

  function drawCert(local) {
    clear();
    const p = clamp01(local);
    heading("03 // CERT DB", "PUBLIC REGISTRY. SEALED KEYS.");

    font(240);
    ctx.fillStyle = C.lime;
    ctx.fillText("0", 90, 390);
    mono(24, C.ink);
    ctx.fillText("PLAINTEXT UUID", 220, 390);
    mono(16, C.muted);
    ctx.fillText("commitment + fingerprint + encrypted payload", 96, 470);

    panel(1050, 230, 780, 560, C.panel);
    label("PUBLIC ENTRY", 1080, 270, 14, C.coral);
    const rows = [
      ["APP", "RUSTWEB"],
      ["FINGERPRINT", "386BB8A5A62F36A8..."],
      ["UUID COMMITMENT", "C7E55EE139AB6D5D..."],
      ["ENCRYPTED KEY", "AES-256-GCM // SEALED"],
      ["STATUS", "VERIFIED"],
    ];
    rows.forEach(([name, value], index) => {
      const y = 340 + index * 78;
      mono(12, C.muted);
      ctx.fillText(name, 1080, y);
      mono(17, index === 4 ? C.lime : C.ink);
      ctx.fillText(value, 1080, y + 24);
    });

    ctx.strokeStyle = C.coral;
    ctx.globalAlpha = 0.7;
    ctx.beginPath();
    ctx.moveTo(1080, 650 + Math.sin(p * Math.PI * 2) * 70);
    ctx.lineTo(1800, 650 + Math.sin(p * Math.PI * 2) * 70);
    ctx.stroke();
    ctx.globalAlpha = 1;

    chip("AES-256-GCM", 90, 580, C.blue);
    chip("PBKDF2", 330, 580, C.lime);
    chip("ECDSA P-256", 500, 580, C.coral);

    // A sealed lock shape.
    ctx.strokeStyle = C.lime;
    ctx.lineWidth = 3;
    ctx.strokeRect(96, 680, 120, 100);
    ctx.beginPath();
    ctx.arc(156, 680, 42, Math.PI, 0);
    ctx.stroke();
    ctx.fillStyle = C.lime;
    ctx.fillRect(150, 720, 12, 30);

  }

  function drawTcps(local) {
    clear();
    const p = clamp01(local);
    heading("04 // TCPs", "FILES + UDP PLAYERS.");

    font(130);
    ctx.fillStyle = C.ink;
    ctx.fillText("PER-USER", 90, 350);
    ctx.fillStyle = C.blue;
    ctx.fillText("SYNC.", 90, 470);
    mono(18, C.muted);
    ctx.fillText("manifest / missing files / bandwidth", 94, 540);

    const files = ["players.json", "assets.pak", "world.bin", "config.json"];
    for (const [index, file] of files.entries()) {
      panel(90, 620 + index * 64, 520, 52, index === 2 ? C.panel2 : C.panel);
      mono(16, index === 2 ? C.lime : C.muted);
      ctx.fillText(index === 2 ? "MISSING ->" : "OK", 110, 647 + index * 64);
      mono(16, C.ink);
      ctx.fillText(file, 250, 647 + index * 64);
    }

    // File packets moving into the player on the right.
    panel(900, 250, 900, 560, C.panel);
    label("UDP PLAYER PLANE", 930, 290, 14, C.coral);
    ctx.strokeStyle = C.line;
    ctx.beginPath();
    ctx.moveTo(950, 430);
    ctx.lineTo(1750, 430);
    ctx.stroke();
    for (let index = 0; index < 9; index += 1) {
      const x = 950 + ((p * 900 + index * 90) % 790);
      ctx.fillStyle = index % 2 === 0 ? C.lime : C.blue;
      ctx.beginPath();
      ctx.arc(x, 430, 4, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.fillStyle = C.coral;
    ctx.fillRect(1680, 370, 80, 120);
    mono(13, C.bg);
    ctx.fillText("GAME", 1698, 430);

    bar("PLAYER BANDWIDTH", "1 MIB/S", 0.72, 930, 560, 810, C.lime);
    bar("MAX APPS / USER", "2", 1, 930, 650, 810, C.coral);

  }

  function drawUc(local) {
    clear();
    const p = clamp01(local);
    heading("05 // UC PACKS", "SMALLER. STILL MACHINE-READABLE.");

    font(180);
    ctx.fillStyle = C.coral;
    ctx.fillText("4 KB", 90, 350);
    mono(24, C.muted);
    ctx.fillText("PER PACKET // 4 MIB PER PACK", 96, 430);

    const compression = easeOutCubic(clamp01(p * 1.5));
    for (let index = 0; index < 16; index += 1) {
      const col = index % 4;
      const row = Math.floor(index / 4);
      const fromX = 110 + col * 74;
      const fromY = 560 + row * 74;
      const toX = 1130 + col * 18;
      const toY = 560 + row * 18;
      const x = fromX + (toX - fromX) * compression;
      const y = fromY + (toY - fromY) * compression;
      ctx.fillStyle = index % 3 === 0 ? C.blue : index % 3 === 1 ? C.lime : C.coral;
      ctx.globalAlpha = 0.85;
      ctx.fillRect(x, y, 46, 46);
    }
    ctx.globalAlpha = 1;

    panel(1080, 500, 380, 300, C.panel);
    mono(14, C.muted);
    ctx.fillText("PACKED", 1110, 540);
    font(72);
    ctx.fillStyle = C.lime;
    ctx.fillText("0.038", 1110, 620);
    mono(14, C.muted);
    ctx.fillText("RATIO", 1112, 680);
    chip("ZSTD", 1500, 570, C.blue);
    chip("CRC32", 1500, 620, C.lime);

    mono(18, C.ink);
    ctx.fillText("25 925 B", 110, 900);
    ctx.fillStyle = C.coral;
    ctx.fillRect(270, 893, 220 * (1 - compression) + 4, 8);
    mono(18, C.lime);
    ctx.fillText("-> 995 B", 520, 900);

  }

  function drawGame(local) {
    clear();
    const p = clamp01(local);
    heading("06 // GAME LAB", "9 SYSTEMS. 4096 B PER PACKET.");

    panel(90, 280, 980, 560, "#0b0e12");
    label("PACKET ARENA", 120, 320, 14, C.lime);
    for (let x = 120; x < 1040; x += 60) {
      ctx.strokeStyle = C.line;
      ctx.globalAlpha = 0.45;
      ctx.beginPath();
      ctx.moveTo(x, 350);
      ctx.lineTo(x, 800);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;

    const playerX = 420 + Math.sin(p * Math.PI * 2) * 160;
    const playerY = 580 + Math.cos(p * Math.PI * 2) * 120;
    ctx.fillStyle = C.blue;
    ctx.beginPath();
    ctx.arc(playerX, playerY, 22, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = C.coral;
    ctx.fillRect(780, 470, 38, 38);
    ctx.strokeStyle = C.lime;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(playerX, playerY);
    ctx.lineTo(780, 470);
    ctx.stroke();

    const systems = [
      "/game_chat",
      "/player_packets",
      "/game_state",
      "/inventory",
      "/trade",
      "/file_sync",
      "/leaderboard",
      "/metrics",
      "/emotes",
    ];
    systems.forEach((system, index) => {
      const y = 300 + index * 56;
      chip(system, 1130, y, index === Math.floor(p * 9) ? C.coral : C.blue);
    });

    mono(16, C.muted);
    ctx.fillText("MAX PACKET 4096 B  //  LOGS ON", 120, 800);
    bar("SYSTEMS", "9", 1, 1130, 820, 610, C.lime);

  }

  function drawDeploy(local) {
    clear();
    const p = clamp01(local);
    heading("07 // DEPLOY", "ONE COMMAND. ANYWHERE.");

    font(150);
    ctx.fillStyle = C.ink;
    ctx.fillText("DOCKER", 90, 330);
    ctx.fillStyle = C.lime;
    ctx.fillText("UP.", 90, 450);

    code(
      [
        "$ docker compose up --build",
        "site  :3000",
        "tcps  :4100 / udp :4101",
        "uc    :4200",
        "",
        "$ ./run.sh",
        "https://127.0.0.1:3000/",
      ],
      90,
      540,
      900,
      420,
    );

    // Containers/stack blocks on the right.
    for (let index = 0; index < 3; index += 1) {
      const x = 1140 + index * 30;
      const y = 360 + index * 70;
      panel(x, y, 180, 70, index === 1 ? C.panel2 : C.panel);
      mono(12, index === 1 ? C.lime : C.muted);
      ctx.fillText(["RUSTWEB", "TCPs", "UC"][index], x + 18, y + 30);
      ctx.fillStyle = index === 1 ? C.lime : C.blue;
      ctx.fillRect(x + 18, y + 46, 120 * (0.4 + p * 0.6), 6);
    }

    ctx.fillStyle = C.coral;
    ctx.fillRect(90, 970 - 8, 8, 18);
    mono(14, C.muted);
    ctx.fillText("TLS AT THE PROXY // NO SECRETS IN THE IMAGE", 120, 970);

  }

  function drawBench(local) {
    clear();
    const p = clamp01(local);
    heading("08 // BENCH", "FAST IS A FEATURE.");

    font(180);
    ctx.fillStyle = C.lime;
    ctx.fillText("4.7", 90, 370);
    mono(28, C.ink);
    ctx.fillText("GIB/S STREAMING", 320, 370);
    mono(17, C.muted);
    ctx.fillText("loopback // 64 MiB per stream // no buffering", 96, 440);

    bar("RUSTWEB", "4 672 MIB/S", 1, 90, 560, 1000, C.lime);
    bar("PLAIN AXUM", "4 692 MIB/S", 0.99, 90, 650, 1000, C.blue);
    bar("FASTAPI", "14K REQ/S", 0.08, 90, 740, 1000, C.coral);

    panel(1220, 260, 610, 520, C.panel);
    label("REQUEST PATH", 1250, 300, 14, C.coral);
    font(64);
    ctx.fillStyle = C.blue;
    ctx.fillText("210 750", 1250, 380);
    mono(14, C.muted);
    ctx.fillText("REQ/S", 1252, 430);
    font(48);
    ctx.fillStyle = C.ink;
    ctx.fillText("0.70 MS", 1250, 510);
    mono(14, C.muted);
    ctx.fillText("P99", 1252, 550);
    font(48);
    ctx.fillStyle = C.lime;
    ctx.fillText("6.6 MB", 1250, 640);
    mono(14, C.muted);
    ctx.fillText("RSS", 1252, 680);

  }

  function drawOutro(local) {
    clear();
    const p = clamp01(local);
    const alpha = 0.55 + 0.45 * easeOutExpo(p);
    ctx.globalAlpha = alpha;

    label("09 // OUTRO", 90, 120, 15, C.coral);
    font(150);
    ctx.fillStyle = C.ink;
    ctx.fillText("POSTAW", 90, 300);
    ctx.fillStyle = C.coral;
    ctx.fillText("U SIEBIE.", 90, 450);
    mono(24, C.ink);
    ctx.fillText("JEDEN PLIK. CALA STRONA. ZERO RUNTIME TEMPLATING.", 94, 540);

    panel(90, 640, 1740, 150, C.panel);
    mono(20, C.lime);
    ctx.fillText("gabeczkag.github.io/rustweb", 120, 700);
    mono(16, C.muted);
    ctx.fillText("Docker / VPS / GitHub Pages / local HTTPS", 120, 746);

    chip("10 ROUTES", 1420, 680, C.blue);
    chip("56 TESTS", 1600, 680, C.lime);
    chip("1 BINARKA", 1760, 680, C.coral);

    ctx.globalAlpha = 1;
  }

  function sceneAt(value) {
    let index = 0;
    for (let current = 0; current < SCENES.length; current += 1) {
      if (value >= SCENES[current].start) index = current;
    }
    return index;
  }

  function render(value) {
    const scene = sceneAt(value);
    const start = SCENES[scene].start;
    const end = scene + 1 < SCENES.length ? SCENES[scene + 1].start : DURATION;
    const local = (value - start) / (end - start);

    if (scene === 0) drawIntro(local);
    else if (scene === 1) drawApi(local);
    else if (scene === 2) drawMhtml(local);
    else if (scene === 3) drawCert(local);
    else if (scene === 4) drawTcps(local);
    else if (scene === 5) drawUc(local);
    else if (scene === 6) drawGame(local);
    else if (scene === 7) drawDeploy(local);
    else if (scene === 8) drawBench(local);
    else drawOutro(local);

    const frame = Math.min(FRAMES - 1, Math.floor(value * FPS));
    const seconds = Math.floor(value);
    const frameInSecond = frame % FPS;
    if (frameNode) frameNode.textContent = String(frame).padStart(3, "0");
    if (frameHud) frameHud.textContent = String(frame).padStart(3, "0");
    if (timecode) {
      timecode.textContent = `00:00:${String(seconds).padStart(2, "0")}:${String(frameInSecond).padStart(2, "0")}`;
    }
    if (sceneHud) sceneHud.textContent = SCENES[scene].label;
    if (liveTicker) liveTicker.textContent = `RUSTWEB // ${TICKER[Math.floor(value * 4) % TICKER.length]}`;
    if (playhead) playhead.style.setProperty("--playhead", `${(value / DURATION) * 100}%`);
    if (scrub && document.activeElement !== scrub) scrub.value = String(frame);
    if (timeline) {
      for (const item of timeline.querySelectorAll("[data-scene]")) {
        item.classList.toggle("is-active", Number(item.dataset.scene) === scene);
      }
    }
    if (stage) stage.dataset.scene = String(scene);
  }

  function startLoop() {
    if (raf || destroyed) return;
    raf = requestAnimationFrame(loop);
  }

  function loop(now) {
    raf = 0;
    if (destroyed) return;
    if (!canvas.isConnected) {
      destroy();
      return;
    }
    if (!playing) return;

    const delta = previous ? Math.min(0.1, (now - previous) / 1000) : 0;
    previous = now;
    time = (time + delta) % DURATION;
    render(time);
    startLoop();
  }

  function setPlaying(next) {
    playing = next;
    if (playButton) playButton.textContent = playing ? "PAUSE" : "PLAY";
    previous = 0;
    if (playing) startLoop();
  }

  function destroy() {
    destroyed = true;
    if (raf) cancelAnimationFrame(raf);
    if (activeReel === api) activeReel = null;
  }

  playButton?.addEventListener("click", () => setPlaying(!playing));
  restartButton?.addEventListener("click", () => {
    time = 0;
    render(time);
    if (!playing) setPlaying(true);
  });
  fullButton?.addEventListener("click", async () => {
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else await stage?.requestFullscreen();
    } catch {}
  });
  scrub?.addEventListener("input", () => {
    time = Number(scrub.value) / FPS;
    render(time);
  });
  canvas.addEventListener("click", () => setPlaying(!playing));
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) previous = 0;
  });

  const api = { destroy };
  render(time);
  if (playing) startLoop();
  else if (playButton) playButton.textContent = "PLAY";

  return api;
}

document.addEventListener("rweb:rendered", initReel);
initReel();
