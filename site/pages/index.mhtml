<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">RUST // FASTAPI DX // ONE FILE</p>
    <h1>API W RUSTCIE.<br><span>JAK W FASTAPI.</span></h1>
    <p class="lead">{{ tagline }}</p>
    <div class="actions">
      <a class="button" href="/bench">ZOBACZ BENCHMARK</a>
      <a class="button ghost" href="/about">JAK DZIALA MHTML</a>
    </div>
    <div class="badges">
      <span class="badge">1 PLIK .RWEB</span>
      <span class="badge">0 RUNTIME TEMPLATING</span>
      <span class="badge">30 KB</span>
      <span class="badge">ASCII ONLY</span>
    </div>
  </div>

  <div class="hero-art" aria-hidden="true">
    <div class="voxel-scene">
      <div class="voxel grass">
        <i class="top"></i><i class="left"></i><i class="right"></i>
        <span class="cube-letter">R</span>
      </div>
      <div class="voxel dirt">
        <i class="top"></i><i class="left"></i><i class="right"></i>
      </div>
      <div class="voxel stone">
        <i class="top"></i><i class="left"></i><i class="right"></i>
      </div>
      <div class="voxel gold">
        <i class="top"></i><i class="left"></i><i class="right"></i>
      </div>
    </div>
    <div class="art-tag">SINGLE FILE<br><strong>.RWEB</strong></div>
  </div>
</section>

<section class="feature-grid">
  @for feature in features {
    <article class="card">
      <div class="card-icon"></div>
      <h2>{{ feature.title }}</h2>
      <p>{{ feature.text }}</p>
    </article>
  }
</section>

<section class="split">
  <div>
    <p class="eyebrow">01 // DX</p>
    <h2>PISZ JAK W FASTAPI</h2>
    <p>{{ code_note }}</p>
    <p class="note">Makro rozwija sie w czasie kompilacji. Routing, walidacja i OpenAPI nie dodaja warstwy w request path.</p>
  </div>
  <pre><code>{{ code }}</code></pre>
</section>

<section class="bench">
  <p class="eyebrow">02 // POMIAR</p>
  <h2>RUSTWEB VS AXUM VS FASTAPI</h2>
  <p>{{ bench.note }}</p>

  <div class="stats">
    <div class="stat"><strong>210 750</strong><span>REQ/S RUSTWEB</span></div>
    <div class="stat"><strong>0.70 ms</strong><span>P99 RUSTWEB</span></div>
    <div class="stat"><strong>6.6 MB</strong><span>RSS SERWERA .RWEB</span></div>
  </div>

  <table>
    <thead>
      <tr><th>SERWER</th><th>THROUGHPUT</th><th>P99</th></tr>
    </thead>
    <tbody>
      @for row in bench.rows {
        <tr>
          <td>
            {{ row.name }}
            <div class="bar"><span style="--bar: {{ row.bar }}"></span></div>
          </td>
          <td>{{ row.throughput }}</td>
          <td>{{ row.p99 }}</td>
        </tr>
      }
    </tbody>
  </table>
  <p class="note">RustWeb i axum sa w granicach szumu. FastAPI placi za Pythona i runtime Pydantic, nie za sam ksztalt API.</p>
</section>

<section class="split">
  <div>
    <p class="eyebrow">03 // MHTML -> .RWEB</p>
    <h2>JEDEN PLIK. ZERO ZALEZNOSCI.</h2>
    <p>Strony piszesz w MHTML. Komenda <code>{{ build_command }}</code> renderuje HTML, inline'uje CSS, transpiluje TypeScript i pakuje wszystko w jeden plik.</p>
    <p>{{ linker_note }}</p>
    <div class="actions">
      <a class="button gold" href="/about">POZNAJ MHTML</a>
    </div>
  </div>
  <pre><code>{{ mhtml_syntax }}</code></pre>
</section>
