$bg: #070b14;
$bg-2: #0b1220;
$panel: #0d1526;
$panel-2: #111a2e;
$ink: #f4f7ff;
$muted: #a7b6cc;
$line: #05070d;
$sky: #7dd3fc;
$green: #6ee7a0;
$gold: #fbbf24;
$pink: #f472b6;
$red: #fb7185;

:root {
  --bg: $bg;
  --bg-2: $bg-2;
  --panel: $panel;
  --panel-2: $panel-2;
  --ink: $ink;
  --muted: $muted;
  --line: $line;
  --sky: $sky;
  --green: $green;
  --gold: $gold;
  --pink: $pink;
  --red: $red;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--ink);
  background-color: var(--bg);
  background-image:
    linear-gradient(rgba(125, 211, 252, 0.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(125, 211, 252, 0.055) 1px, transparent 1px);
  background-size: 32px 32px;
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  line-height: 1.65;
}

::selection {
  background: var(--gold);
  color: var(--line);
}

a {
  color: inherit;
  text-decoration: none;
}

a:focus-visible,
button:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 3px;
}

.topbar {
  position: sticky;
  top: 12px;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 18px;
  width: min(1120px, calc(100% - 32px));
  margin: 18px auto 0;
  padding: 12px 16px;
  border: 3px solid var(--line);
  background: var(--bg-2);
  box-shadow: 7px 7px 0 var(--line);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  flex: 0 0 auto;
  font-family: "Arial Black", "Segoe UI Black", Impact, sans-serif;
  font-size: 18px;
  letter-spacing: 0.04em;
}

.brand-mark {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
  width: 32px;
  height: 32px;
  padding: 2px;
  border: 3px solid var(--line);
  background: var(--line);
  box-shadow: 3px 3px 0 #02040a;
}

.brand-mark b:nth-child(1) { background: var(--sky); }
.brand-mark b:nth-child(2) { background: var(--green); }
.brand-mark b:nth-child(3) { background: var(--pink); }
.brand-mark b:nth-child(4) { background: var(--gold); }

.hotbar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-left: auto;
}

.hotbar a {
  padding: 8px 10px;
  border: 2px solid var(--line);
  background: var(--panel-2);
  box-shadow: 3px 3px 0 var(--line);
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hotbar a:hover,
.hotbar a.active {
  background: var(--sky);
  color: var(--line);
}

.hotbar a:active {
  translate: 2px 2px;
  box-shadow: 1px 1px 0 var(--line);
}

.status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  padding: 8px 10px;
  border: 2px solid var(--line);
  background: #0b2417;
  box-shadow: 3px 3px 0 var(--line);
  color: var(--green);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.status i {
  width: 8px;
  height: 8px;
  background: var(--green);
  box-shadow: 0 0 10px var(--green);
  animation: blink 1.6s steps(2, end) infinite;
}

main {
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
  padding: 0 0 80px;
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
  gap: 42px;
  align-items: center;
  padding: 76px 0 64px;
}

.eyebrow {
  display: inline-block;
  margin: 0 0 22px;
  padding: 6px 10px;
  border: 3px solid var(--line);
  background: var(--gold);
  box-shadow: 4px 4px 0 var(--line);
  color: var(--line);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

h1 {
  margin: 0 0 24px;
  font-family: "Arial Black", "Segoe UI Black", Impact, sans-serif;
  font-size: clamp(42px, 6.6vw, 82px);
  line-height: 0.94;
  letter-spacing: -0.045em;
  text-transform: uppercase;
  text-shadow: 5px 5px 0 var(--line);
}

h1 span {
  color: var(--sky);
}

.lead {
  max-width: 620px;
  margin: 0;
  color: var(--muted);
  font-size: clamp(16px, 1.8vw, 19px);
  line-height: 1.7;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 18px;
  border: 3px solid var(--line);
  border-radius: 0;
  background: var(--sky);
  box-shadow: 6px 6px 0 var(--line);
  color: var(--line);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  transition: translate 120ms ease, box-shadow 120ms ease;
}

.button:hover {
  translate: -2px -2px;
  box-shadow: 8px 8px 0 var(--line);
}

.button:active {
  translate: 3px 3px;
  box-shadow: 2px 2px 0 var(--line);
}

.button.ghost {
  background: var(--bg-2);
  color: var(--ink);
}

.button.gold {
  background: var(--gold);
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 24px;
}

.badge {
  padding: 5px 8px;
  border: 2px solid var(--line);
  background: var(--panel-2);
  box-shadow: 3px 3px 0 var(--line);
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.hero-art {
  position: relative;
  min-height: 430px;
  display: grid;
  place-items: center;
}

.voxel-scene {
  position: relative;
  width: 340px;
  height: 380px;
  perspective: 900px;
}

.voxel {
  position: absolute;
  width: 110px;
  height: 110px;
  transform-style: preserve-3d;
  transform: rotateX(-22deg) rotateY(-38deg);
}

.voxel i {
  position: absolute;
  inset: 0;
  display: block;
  border: 4px solid var(--line);
}

.voxel .top { transform: rotateX(90deg) translateZ(55px); }
.voxel .left { transform: rotateY(-90deg) translateZ(55px); }
.voxel .right { transform: translateZ(55px); }

.grass {
  left: 108px;
  top: 50px;
  animation: bob 5s ease-in-out infinite;
}

.grass .top { background: var(--green); }
.grass .left { background: #22c55e; }
.grass .right { background: #16a34a; }

.cube-letter {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  transform: translateZ(57px);
  color: var(--line);
  font-family: "Arial Black", Impact, sans-serif;
  font-size: 56px;
  line-height: 1;
  pointer-events: none;
}

.dirt {
  left: 126px;
  top: 166px;
  animation: bob 6s ease-in-out -1s infinite;
}

.dirt .top { background: #b07a4a; }
.dirt .left { background: #8a5a35; }
.dirt .right { background: #6f4629; }

.stone {
  left: 92px;
  top: 282px;
  animation: bob 7s ease-in-out -2s infinite;
}

.stone .top { background: #a8b3c4; }
.stone .left { background: #7c8798; }
.stone .right { background: #5c6675; }

.gold {
  left: 238px;
  top: 18px;
  width: 58px;
  height: 58px;
  animation: bob 6s ease-in-out -3s infinite;
}

.gold i { border-width: 3px; }
.gold .top { transform: rotateX(90deg) translateZ(29px); background: var(--gold); }
.gold .left { transform: rotateY(-90deg) translateZ(29px); background: #d99a06; }
.gold .right { transform: translateZ(29px); background: #b97f00; }

.voxel-scene::before,
.voxel-scene::after {
  content: "";
  position: absolute;
  width: 16px;
  height: 16px;
  border: 3px solid var(--line);
  box-shadow: 3px 3px 0 var(--line);
  animation: bob 6s ease-in-out infinite;
}

.voxel-scene::before {
  left: 12px;
  top: 76px;
  background: var(--pink);
}

.voxel-scene::after {
  right: 12px;
  bottom: 54px;
  background: var(--sky);
  animation-delay: -2s;
}

.art-tag {
  position: absolute;
  right: 10px;
  bottom: 8px;
  padding: 8px 10px;
  border: 3px solid var(--line);
  background: var(--panel-2);
  box-shadow: 4px 4px 0 var(--line);
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  line-height: 1.5;
  text-align: right;
  text-transform: uppercase;
}

.spec-board {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  width: 100%;
  max-width: 360px;
}

.spec-cell {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 105px;
  padding: 16px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 6px 6px 0 var(--line);
}

.spec-cell strong {
  color: var(--sky);
  font-family: "Arial Black", Impact, sans-serif;
  font-size: 28px;
  line-height: 1;
  letter-spacing: -0.04em;
}

.spec-cell:nth-child(2) strong { color: var(--green); }
.spec-cell:nth-child(3) strong { color: var(--gold); }
.spec-cell:nth-child(4) strong { color: var(--pink); }

.spec-cell span {
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 800;
  line-height: 1.35;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.art-tag strong {
  color: var(--sky);
  font-size: 14px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
  padding: 18px 0 20px;
}

.card {
  position: relative;
  min-height: 210px;
  padding: 22px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 7px 7px 0 var(--line);
}

.card::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 7px;
  background: var(--sky);
}

.card:nth-child(2)::before { background: var(--green); }
.card:nth-child(3)::before { background: var(--gold); }
.card:nth-child(4)::before { background: var(--pink); }

.card-icon {
  width: 34px;
  height: 34px;
  margin-bottom: 16px;
  border: 3px solid var(--line);
  background:
    linear-gradient(135deg, var(--sky) 0 48%, transparent 48% 52%, var(--line) 52% 100%);
  box-shadow: 3px 3px 0 var(--line);
}

.card:nth-child(2) .card-icon {
  background: linear-gradient(135deg, var(--green) 0 48%, transparent 48% 52%, var(--line) 52% 100%);
}

.card:nth-child(3) .card-icon {
  background: linear-gradient(135deg, var(--gold) 0 48%, transparent 48% 52%, var(--line) 52% 100%);
}

.card:nth-child(4) .card-icon {
  background: linear-gradient(135deg, var(--pink) 0 48%, transparent 48% 52%, var(--line) 52% 100%);
}

.card h2 {
  margin: 0 0 8px;
  font-family: "Arial Black", "Segoe UI Black", Impact, sans-serif;
  font-size: 15px;
  line-height: 1.15;
  letter-spacing: -0.01em;
  text-transform: uppercase;
}

.card p {
  margin: 0;
  color: var(--muted);
  font-size: 13.5px;
  line-height: 1.6;
}

.split {
  display: grid;
  grid-template-columns: 1fr 1.08fr;
  gap: 36px;
  align-items: center;
  padding: 62px 0;
  border-top: 3px solid #1e293b;
}

.split h2,
.bench h2 {
  margin: 0 0 12px;
  font-family: "Arial Black", "Segoe UI Black", Impact, sans-serif;
  font-size: clamp(25px, 3vw, 38px);
  line-height: 1;
  letter-spacing: -0.035em;
  text-transform: uppercase;
  text-shadow: 3px 3px 0 var(--line);
}

.split p,
.bench > p {
  margin: 0 0 14px;
  color: var(--muted);
}

.note {
  margin: 20px 0 0;
  padding: 14px 16px;
  border: 3px solid var(--line);
  border-left: 8px solid var(--gold);
  background: #171204;
  box-shadow: 5px 5px 0 var(--line);
  color: #fde68a;
  font-size: 13px;
}

pre {
  position: relative;
  margin: 0;
  padding: 40px 18px 18px;
  border: 3px solid var(--line);
  background: #03050b;
  box-shadow: 7px 7px 0 #1e293b;
  overflow: auto;
  font-size: 12.5px;
  line-height: 1.75;
}

pre::before {
  content: "\25CF  \25CF  \25CF";
  position: absolute;
  inset: 0 0 auto;
  padding: 8px 12px;
  border-bottom: 3px solid var(--line);
  background: var(--panel-2);
  color: var(--pink);
  font-size: 10px;
  letter-spacing: 0.18em;
}

pre code {
  color: #c9d7ea;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.bench {
  padding: 62px 0;
  border-top: 3px solid #1e293b;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin: 26px 0;
}

.stat {
  padding: 18px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 6px 6px 0 var(--line);
}

.stat strong {
  display: block;
  color: var(--green);
  font-family: "Arial Black", Impact, sans-serif;
  font-size: clamp(25px, 3vw, 36px);
  line-height: 1;
  letter-spacing: -0.04em;
}

.stat:nth-child(2) strong { color: var(--gold); }
.stat:nth-child(3) strong { color: var(--sky); }

.stat span {
  display: block;
  margin-top: 8px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

table {
  width: 100%;
  margin-top: 26px;
  border: 3px solid var(--line);
  border-collapse: separate;
  border-spacing: 0;
  background: var(--panel);
  box-shadow: 7px 7px 0 var(--line);
  font-size: 13px;
}

th,
td {
  padding: 14px 12px;
  text-align: left;
  vertical-align: top;
  border-bottom: 2px solid #1e293b;
}

th {
  background: var(--panel-2);
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

tr:last-child td {
  border-bottom: 0;
}

td:first-child {
  min-width: 210px;
  font-weight: 800;
}

.bar {
  height: 10px;
  margin-top: 8px;
  border: 2px solid var(--line);
  background: var(--line);
}

.bar span {
  display: block;
  width: var(--bar);
  height: 100%;
  background: repeating-linear-gradient(90deg, var(--green) 0 9px, var(--line) 9px 12px);
}

tr:nth-child(3) .bar span {
  background: repeating-linear-gradient(90deg, var(--red) 0 9px, var(--line) 9px 12px);
}

.footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
  padding: 20px 0 42px;
  border-top: 3px solid #1e293b;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  letter-spacing: 0.04em;
}

.footer-links {
  display: flex;
  gap: 12px;
}

.footer a:hover {
  color: var(--sky);
}

.byrust-warning {
  position: sticky;
  top: 0;
  z-index: 9999;
  padding: 10px 16px;
  background: #7f1d1d;
  color: #fff;
  font: 800 13px/1.4 ui-monospace, monospace;
  text-align: center;
}

@keyframes bob {
  50% { translate: 0 -12px; }
}

@keyframes blink {
  50% { opacity: 0.25; }
}

@media (max-width: 980px) {
  .hero {
    grid-template-columns: 1fr;
    padding-top: 52px;
  }

  .hero-art {
    min-height: 360px;
    order: 2;
  }

  .feature-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .split {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-wrap: wrap;
    gap: 10px;
  }

  .hotbar {
    order: 3;
    margin-left: 0;
  }

  .status {
    margin-left: auto;
  }
}

@media (max-width: 620px) {
  .feature-grid {
    grid-template-columns: 1fr;
  }

  .hotbar a {
    padding: 7px 8px;
    font-size: 10px;
  }

  .voxel-scene {
    scale: 0.86;
  }

  .brand {
    font-size: 16px;
  }

  table {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}

.drop-zone {
  margin-top: 20px;
  padding: 22px;
  border: 3px dashed var(--line);
  background: var(--panel);
  box-shadow: 5px 5px 0 var(--line);
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-align: center;
  cursor: pointer;
}

.drop-zone.active {
  border-color: var(--sky);
  background: #13233a;
  color: var(--sky);
}

.viewer-frame {
  display: block;
  width: 100%;
  height: 640px;
  margin-top: 22px;
  border: 3px solid var(--line);
  background: #0b1020;
  box-shadow: 7px 7px 0 var(--line);
}

#viewer-code {
  display: block;
  max-height: 520px;
  overflow: auto;
}

.cert-form {
  display: grid;
  gap: 12px;
  margin-top: 16px;
}

.cert-field {
  display: grid;
  gap: 6px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.cert-field input,
.cert-secret {
  width: 100%;
  padding: 12px;
  border: 3px solid var(--line);
  background: #03050b;
  box-shadow: 4px 4px 0 var(--line);
  color: var(--ink);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  outline: none;
}

.cert-field input:focus,
.cert-secret:focus {
  border-color: var(--sky);
}

.cert-secret {
  min-height: 48px;
  resize: vertical;
}

#cert-password {
  min-height: 96px;
  color: var(--gold);
  font-size: 11px;
  word-break: break-all;
}

#cert-check-entry {
  min-height: 130px;
}

#cert-entry {
  display: block;
  max-height: 300px;
  overflow: auto;
}

.cert-list {
  display: grid;
  gap: 12px;
  margin-top: 16px;
}

.cert-item {
  padding: 12px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 5px 5px 0 var(--line);
}

.cert-item strong {
  display: block;
  font-family: "Arial Black", Impact, sans-serif;
  font-size: 14px;
  text-transform: uppercase;
}

.cert-item small {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  word-break: break-all;
}

.cert-item .actions {
  margin-top: 10px;
}

.cert-item .badge,
button.badge {
  cursor: pointer;
}

#cert-result {
  max-height: 320px;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-word;
}

.cert-valid {
  color: var(--green) !important;
}

.cert-invalid {
  color: var(--red) !important;
}

.game-page {
  display: grid;
  gap: 22px;
}

.game-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.game-head h1 {
  margin: 8px 0 12px;
  font-size: clamp(38px, 8vw, 86px);
  line-height: 0.9;
}

.game-head h1 span {
  color: var(--sky);
}

.game-head .lead {
  max-width: 720px;
}

.game-shell {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  gap: 20px;
  align-items: start;
}

.game-stage {
  padding: 12px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 7px 7px 0 var(--line);
}

.game-canvas {
  display: block;
  width: 100%;
  height: auto;
  border: 3px solid var(--line);
  background: #070b14;
  image-rendering: pixelated;
}

.game-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.game-toolbar button,
button.badge {
  cursor: pointer;
}

.game-side {
  display: grid;
  gap: 16px;
  align-content: start;
}

.game-stats {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.game-stats .spec-cell strong {
  font-size: 18px;
}

.game-systems {
  display: grid;
  gap: 8px;
  margin-top: 10px;
}

.game-system {
  padding: 8px 10px;
  border: 2px solid var(--line);
  background: var(--panel-2);
  box-shadow: 3px 3px 0 var(--line);
}

.game-system strong {
  display: block;
  color: var(--sky);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
}

.game-system small {
  display: block;
  margin-top: 4px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
}

.game-chat {
  display: flex;
  gap: 6px;
}

.game-chat input {
  min-width: 0;
  flex: 1;
  padding: 10px;
  border: 3px solid var(--line);
  background: #03050b;
  color: var(--ink);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  outline: none;
}

.game-chat input:focus {
  border-color: var(--sky);
}

.game-bottom {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  gap: 20px;
}

.game-log {
  height: 360px;
  margin-top: 10px;
  overflow: auto;
  border: 3px solid var(--line);
  background: #03050b;
  box-shadow: 5px 5px 0 var(--line);
  padding: 8px;
}

.game-log-entry {
  padding: 3px 7px;
  border-left: 3px solid var(--muted);
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  line-height: 1.55;
  word-break: break-word;
}

.game-log-entry.out {
  border-color: var(--sky);
  color: var(--sky);
}

.game-log-entry.in {
  border-color: var(--green);
  color: var(--green);
}

.game-log-entry.route {
  border-color: var(--gold);
  color: var(--gold);
}

.game-log-entry.err {
  border-color: var(--red);
  color: var(--red);
}

.game-log-entry.sys {
  border-color: var(--pink);
  color: var(--pink);
}

#game-packet {
  max-height: 360px;
  overflow: auto;
}

@media (max-width: 980px) {
  .game-shell,
  .game-bottom {
    grid-template-columns: 1fr;
  }
}

[data-theme="light"] {
  --bg: #f4efe4;
  --bg-2: #fffaf0;
  --panel: #fff6e5;
  --panel-2: #ffe9c7;
  --ink: #17120a;
  --muted: #635845;
  --line: #17120a;
  --sky: #0369a1;
  --green: #15803d;
  --gold: #b45309;
  --pink: #be185d;
  --red: #b91c1c;
}

[data-theme="light"] body {
  background-image:
    linear-gradient(rgba(23, 18, 10, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(23, 18, 10, 0.06) 1px, transparent 1px);
}

.theme-toggle {
  padding: 8px 10px;
  border: 2px solid var(--line);
  background: var(--panel-2);
  box-shadow: 3px 3px 0 var(--line);
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  cursor: pointer;
}

.theme-toggle:hover {
  background: var(--gold);
  color: var(--line);
}

[data-theme="light"] .status {
  background: #dcfce7;
  color: #166534;
}

[data-theme="light"] pre,
[data-theme="light"] .drop-zone,
[data-theme="light"] .cert-field input,
[data-theme="light"] .cert-secret,
[data-theme="light"] .game-chat input,
[data-theme="light"] .game-log {
  background: #fffdf5;
  color: var(--ink);
}

[data-theme="light"] pre code {
  color: #292217;
}

[data-theme="light"] .note {
  background: #fff7d6;
  color: #713f12;
}

[data-theme="light"] .drop-zone.active {
  background: #e0f2fe;
  color: var(--sky);
}

[data-theme="light"] .viewer-frame {
  background: #fff;
}

[data-theme="light"] .split,
[data-theme="light"] .bench,
[data-theme="light"] .footer {
  border-color: #d8cbb6;
}

[data-theme="light"] .topbar,
[data-theme="light"] .footer {
  background-color: var(--bg-2);
}

.deploy-hero {
  padding: 70px 0 30px;
}

.deploy-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  padding: 26px 0 60px;
}

.deploy-card {
  padding: 20px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 7px 7px 0 var(--line);
}

.deploy-card h2 {
  margin: 0 0 10px;
  font-family: "Arial Black", Impact, sans-serif;
  font-size: 22px;
  line-height: 1;
  text-transform: uppercase;
}

.deploy-card p {
  color: var(--muted);
  font-size: 13px;
}

.code-block {
  position: relative;
  margin-top: 14px;
}

.copy-button {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 3;
  padding: 5px 8px;
  border: 2px solid var(--line);
  background: var(--gold);
  box-shadow: 3px 3px 0 var(--line);
  color: var(--line);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
  cursor: pointer;
}

.copy-button:hover {
  background: var(--sky);
}

.code-block pre {
  margin: 0;
  padding-top: 48px;
}

.service-table {
  display: grid;
  gap: 8px;
}

.service-row {
  display: grid;
  grid-template-columns: 100px minmax(0, 1fr) auto;
  gap: 10px;
  align-items: center;
  padding: 10px 12px;
  border: 3px solid var(--line);
  background: var(--panel-2);
  box-shadow: 4px 4px 0 var(--line);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
}

.service-row strong {
  color: var(--sky);
  text-transform: uppercase;
}

.service-row span {
  color: var(--muted);
}

.service-row code {
  color: var(--gold);
  font-size: 9px;
  white-space: nowrap;
}

[data-theme="light"] .deploy-card,
[data-theme="light"] .service-row {
  background: #fffdf5;
}

@media (max-width: 820px) {
  .deploy-grid {
    grid-template-columns: 1fr;
  }

  .service-row {
    grid-template-columns: 80px minmax(0, 1fr);
  }

  .service-row code {
    grid-column: 1 / -1;
  }
}

.suite-section {
  padding: 62px 0;
  border-top: 3px solid #1e293b;
}

.suite-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-top: 26px;
}

.suite-card {
  display: grid;
  align-content: start;
  gap: 10px;
  min-height: 190px;
  padding: 18px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 6px 6px 0 var(--line);
}

.suite-card:hover {
  background: var(--panel-2);
  translate: -2px -2px;
  box-shadow: 8px 8px 0 var(--line);
}

.suite-card strong {
  color: var(--gold);
  font-family: "Arial Black", Impact, sans-serif;
  font-size: 18px;
  letter-spacing: -0.02em;
}

.suite-card span {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.55;
}

.suite-card em {
  margin-top: auto;
  color: var(--sky);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-style: normal;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.compare-table {
  margin-top: 0;
  font-size: 11px;
}

.compare-table td:first-child {
  min-width: 0;
  font-weight: 700;
}

.compare-table th:nth-child(2),
.compare-table td:nth-child(2) {
  color: var(--green);
}

[data-theme="light"] .suite-section {
  border-color: #d8cbb6;
}

[data-theme="light"] .suite-card {
  background: #fffdf5;
}

@media (max-width: 980px) {
  .suite-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .suite-grid {
    grid-template-columns: 1fr;
  }
}

.baner-page {
  overflow: hidden;
}

.baner-stage {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
  gap: 42px;
  align-items: center;
  min-height: 760px;
  padding: 60px 0 70px;
}

.baner-grid {
  position: absolute;
  inset: -20%;
  z-index: 0;
  background-image:
    linear-gradient(rgba(125, 211, 252, 0.09) 1px, transparent 1px),
    linear-gradient(90deg, rgba(125, 211, 252, 0.09) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: radial-gradient(circle at 50% 50%, #000 20%, transparent 72%);
  animation: baner-grid-drift 9s linear infinite;
}

.baner-orb {
  position: absolute;
  z-index: 0;
  width: 180px;
  height: 180px;
  border: 3px solid var(--line);
  border-radius: 50%;
  opacity: 0.75;
  filter: blur(1px);
  animation: baner-float 5s ease-in-out infinite;
}

.orb-a {
  top: 12%;
  right: 30%;
  background: radial-gradient(circle at 32% 28%, #7dd3fc, #0369a1 65%, #070b14);
}

.orb-b {
  right: 5%;
  bottom: 12%;
  width: 110px;
  height: 110px;
  background: radial-gradient(circle at 32% 28%, #6ee7a0, #15803d 65%, #070b14);
  animation-delay: -1.7s;
}

.orb-c {
  left: 4%;
  bottom: 18%;
  width: 76px;
  height: 76px;
  background: radial-gradient(circle at 32% 28%, #fbbf24, #b45309 65%, #070b14);
  animation-delay: -3.1s;
}

.baner-copy,
.baner-proof {
  position: relative;
  z-index: 2;
}

.baner-copy h1 {
  margin: 0 0 22px;
  font-size: clamp(58px, 10vw, 132px);
  line-height: 0.82;
  letter-spacing: -0.07em;
  text-transform: uppercase;
  text-shadow: 7px 7px 0 var(--line);
}

.baner-copy h1 span {
  color: var(--sky);
}

.baner-copy .lead {
  max-width: 640px;
}

.baner-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 28px;
}

.baner-controls button {
  cursor: pointer;
}

.baner-index {
  margin-left: 4px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.baner-live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-left: auto;
  color: var(--green);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.baner-live i,
.market-live-dot {
  width: 8px;
  height: 8px;
  background: var(--green);
  border-radius: 50%;
  box-shadow: 0 0 12px var(--green);
  animation: baner-pulse 1s steps(2, end) infinite;
}

.baner-proof {
  padding: 26px;
  border: 3px solid var(--line);
  background: rgba(13, 21, 38, 0.94);
  box-shadow: 10px 10px 0 var(--line);
  transition: border-color 160ms ease, transform 160ms ease;
}

.baner-proof.flip {
  animation: baner-flip 240ms ease;
}

.baner-proof[data-accent="sky"] strong,
.baner-proof[data-accent="sky"] .baner-proof-link {
  color: var(--sky);
}

.baner-proof[data-accent="green"] strong,
.baner-proof[data-accent="green"] .baner-proof-link {
  color: var(--green);
}

.baner-proof[data-accent="gold"] strong,
.baner-proof[data-accent="gold"] .baner-proof-link {
  color: var(--gold);
}

.baner-proof[data-accent="pink"] strong,
.baner-proof[data-accent="pink"] .baner-proof-link {
  color: var(--pink);
}

.baner-proof-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.baner-proof > strong {
  display: block;
  font-family: "Arial Black", Impact, sans-serif;
  font-size: clamp(56px, 8vw, 104px);
  line-height: 0.82;
  letter-spacing: -0.06em;
}

.baner-proof > span {
  display: block;
  margin-top: 8px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.baner-proof p {
  margin: 20px 0;
  color: var(--ink);
  font-size: 14px;
  line-height: 1.55;
}

.baner-proof-link {
  display: inline-block;
  color: var(--sky);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.baner-proof-link:hover {
  text-decoration: underline;
}

.baner-progress {
  height: 8px;
  margin-top: 22px;
  border: 2px solid var(--line);
  background: var(--bg);
}

.baner-progress span {
  display: block;
  width: 0;
  height: 100%;
  background: var(--sky);
}

.baner-progress span.run {
  animation: baner-progress 500ms linear forwards;
}

.baner-proof-note {
  display: block;
  margin-top: 10px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 8px;
  letter-spacing: 0.04em;
}

.baner-ticker,
.market-ticker {
  overflow: hidden;
  border-top: 3px solid var(--line);
  border-bottom: 3px solid var(--line);
  background: var(--gold);
  color: var(--line);
}

.baner-track,
.market-track {
  display: flex;
  width: max-content;
  gap: 18px;
  padding: 10px 0;
  animation: baner-marquee 18s linear infinite;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.baner-track b,
.market-track b {
  color: var(--line);
}

.baner-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  padding: 34px 0 70px;
}

.baner-strip article {
  padding: 20px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 6px 6px 0 var(--line);
}

.baner-strip strong {
  display: block;
  color: var(--sky);
  font-family: "Arial Black", Impact, sans-serif;
  font-size: 28px;
  line-height: 1;
}

.baner-strip span {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.baner-strip p {
  color: var(--muted);
  font-size: 13px;
}

.baner-strip a {
  color: var(--gold);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.market-hero {
  padding: 70px 0 26px;
}

.market-hero h1 {
  margin: 0 0 20px;
  font-size: clamp(52px, 9vw, 112px);
  line-height: 0.84;
  letter-spacing: -0.06em;
  text-transform: uppercase;
  text-shadow: 6px 6px 0 var(--line);
}

.market-hero h1 span {
  color: var(--gold);
}

.market-live {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-top: 24px;
  padding: 10px 12px;
  border: 3px solid var(--line);
  background: var(--panel-2);
  box-shadow: 4px 4px 0 var(--line);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.market-live strong {
  color: var(--sky);
}

.market-live button {
  margin-left: auto;
  cursor: pointer;
}

.market-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 22px 0 16px;
}

.market-filters .badge {
  cursor: pointer;
}

.market-filters .badge.is-active {
  background: var(--sky);
  color: var(--line);
}

.market-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  padding: 10px 0 50px;
}

.market-card {
  display: grid;
  align-content: start;
  gap: 10px;
  min-height: 250px;
  padding: 18px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 6px 6px 0 var(--line);
  transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
}

.market-card.is-featured {
  border-color: var(--sky);
  box-shadow: 9px 9px 0 var(--sky);
  transform: translateY(-4px);
}

.market-card[hidden] {
  display: none;
}

.market-card-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.market-card h2 {
  margin: 0;
  font-family: "Arial Black", Impact, sans-serif;
  font-size: 23px;
  line-height: 1;
  text-transform: uppercase;
}

.market-card p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.55;
}

.market-card > strong {
  margin-top: auto;
  color: var(--gold);
  font-family: "Arial Black", Impact, sans-serif;
  font-size: 26px;
  line-height: 1;
}

.market-card > strong small {
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 8px;
  letter-spacing: 0.08em;
}

.market-card a {
  color: var(--sky);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.market-card a:hover {
  text-decoration: underline;
}

[data-theme="light"] .baner-proof {
  background: #fffdf5;
}

[data-theme="light"] .baner-grid {
  background-image:
    linear-gradient(rgba(23, 18, 10, 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(23, 18, 10, 0.07) 1px, transparent 1px);
}

[data-theme="light"] .baner-strip article,
[data-theme="light"] .market-card {
  background: #fffdf5;
}

[data-theme="light"] .baner-ticker,
[data-theme="light"] .market-ticker {
  background: var(--gold);
}

@keyframes baner-grid-drift {
  50% { transform: translate3d(22px, 18px, 0); }
}

@keyframes baner-float {
  50% { transform: translate3d(0, -22px, 0) rotate(8deg); }
}

@keyframes baner-flip {
  0% { transform: translateY(8px) scale(0.985); opacity: 0.78; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

@keyframes baner-progress {
  from { width: 0; }
  to { width: 100%; }
}

@keyframes baner-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

@keyframes baner-pulse {
  50% { opacity: 0.25; }
}

@media (max-width: 980px) {
  .baner-stage {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: 42px;
  }

  .baner-proof {
    max-width: 560px;
  }

  .baner-strip,
  .market-grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 620px) {
  .baner-copy h1,
  .market-hero h1 {
    font-size: clamp(48px, 16vw, 76px);
  }

  .baner-strip,
  .market-grid {
    grid-template-columns: 1fr;
  }

  .baner-live {
    margin-left: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .baner-grid,
  .baner-orb,
  .baner-track,
  .market-track,
  .baner-live i,
  .market-live-dot {
    animation: none;
  }

  .baner-proof.flip {
    animation: none;
  }
}

.baner-stage {
  --mx: 50%;
  --my: 50%;
}

.baner-spotlight,
.market-spotlight {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: radial-gradient(circle at var(--mx) var(--my), rgba(125, 211, 252, 0.17), transparent 38%);
  pointer-events: none;
  transition: background 120ms linear;
}

.baner-particles {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.baner-particles i {
  position: absolute;
  width: 6px;
  height: 6px;
  background: var(--sky);
  box-shadow: 0 0 12px var(--sky);
  animation: baner-particle 4.8s linear infinite;
}

.baner-particles i:nth-child(1) { left: 8%; top: 22%; animation-delay: -0.4s; }
.baner-particles i:nth-child(2) { left: 18%; top: 78%; animation-delay: -1.1s; background: var(--gold); }
.baner-particles i:nth-child(3) { left: 31%; top: 38%; animation-delay: -2.4s; background: var(--green); }
.baner-particles i:nth-child(4) { left: 43%; top: 86%; animation-delay: -0.8s; }
.baner-particles i:nth-child(5) { left: 55%; top: 16%; animation-delay: -3.2s; background: var(--pink); }
.baner-particles i:nth-child(6) { left: 66%; top: 70%; animation-delay: -1.8s; }
.baner-particles i:nth-child(7) { left: 76%; top: 32%; animation-delay: -2.9s; background: var(--gold); }
.baner-particles i:nth-child(8) { left: 87%; top: 62%; animation-delay: -0.2s; background: var(--green); }
.baner-particles i:nth-child(9) { left: 94%; top: 18%; animation-delay: -2.1s; }
.baner-particles i:nth-child(10) { left: 12%; top: 52%; animation-delay: -3.7s; background: var(--pink); }
.baner-particles i:nth-child(11) { left: 60%; top: 48%; animation-delay: -1.4s; background: var(--green); }
.baner-particles i:nth-child(12) { left: 82%; top: 86%; animation-delay: -2.7s; background: var(--gold); }

.baner-scan {
  position: absolute;
  left: 0;
  right: 0;
  top: -10%;
  z-index: 1;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--sky), transparent);
  opacity: 0.6;
  animation: baner-scan 4s linear infinite;
  pointer-events: none;
}

.baner-chip {
  position: absolute;
  z-index: 2;
  padding: 5px 8px;
  border: 2px solid var(--line);
  background: var(--panel);
  box-shadow: 3px 3px 0 var(--line);
  color: var(--muted);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
  animation: baner-chip-float 5.5s ease-in-out infinite;
  pointer-events: none;
}

.chip-a { left: 48%; top: 17%; color: var(--sky); }
.chip-b { right: 4%; top: 48%; color: var(--gold); animation-delay: -1.8s; }
.chip-c { left: 4%; top: 77%; color: var(--green); animation-delay: -3.1s; }
.chip-d { right: 27%; bottom: 7%; color: var(--pink); animation-delay: -2.4s; }

.baner-proof {
  animation: baner-proof-pulse 2.6s ease-in-out infinite;
}

.market-hero {
  position: relative;
  --mx: 50%;
  --my: 50%;
}

.market-hero > p,
.market-hero > h1,
.market-hero > .market-live {
  position: relative;
  z-index: 2;
}

.market-orb {
  position: absolute;
  z-index: 0;
  border: 3px solid var(--line);
  border-radius: 50%;
  animation: baner-float 6s ease-in-out infinite;
}

.market-orb-a {
  top: 4%;
  right: 12%;
  width: 120px;
  height: 120px;
  background: radial-gradient(circle at 30% 25%, #f472b6, #9d174d 70%, #070b14);
}

.market-orb-b {
  top: 30%;
  left: 48%;
  width: 58px;
  height: 58px;
  background: radial-gradient(circle at 30% 25%, #6ee7a0, #15803d 70%, #070b14);
  animation-delay: -2.2s;
}

.market-card {
  position: relative;
  animation: market-card-float 7s ease-in-out infinite;
}

.market-card:nth-child(2n) {
  animation-delay: -2.1s;
}

.market-card:nth-child(3n) {
  animation-delay: -4.2s;
}

.market-card.is-featured {
  animation:
    market-card-float 7s ease-in-out infinite,
    market-featured-pulse 1.25s ease-in-out infinite;
}

.market-card::after {
  content: "";
  position: absolute;
  inset: -3px;
  border: 2px solid transparent;
  pointer-events: none;
}

.market-card.is-featured::after {
  animation: market-outline 1.25s ease-in-out infinite;
}

.baner-track,
.market-track {
  animation-duration: 11s;
}

@keyframes baner-particle {
  0% { transform: translate3d(0, 40px, 0) scale(0.4); opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { transform: translate3d(20px, -120px, 0) scale(1.1); opacity: 0; }
}

@keyframes baner-scan {
  from { transform: translateY(0); }
  to { transform: translateY(900px); }
}

@keyframes baner-chip-float {
  50% { translate: 0 -14px; rotate: 3deg; }
}

@keyframes baner-proof-pulse {
  50% { border-color: var(--sky); box-shadow: 12px 12px 0 var(--sky); }
}

@keyframes market-card-float {
  50% { translate: 0 -7px; }
}

@keyframes market-featured-pulse {
  50% { border-color: var(--gold); }
}

@keyframes market-outline {
  50% { border-color: var(--sky); box-shadow: 0 0 24px var(--sky); }
}

[data-theme="light"] .baner-spotlight,
[data-theme="light"] .market-spotlight {
  background: radial-gradient(circle at var(--mx) var(--my), rgba(3, 105, 161, 0.12), transparent 38%);
}

[data-theme="light"] .baner-chip {
  background: #fffdf5;
}

@media (prefers-reduced-motion: reduce) {
  .baner-particles i,
  .baner-scan,
  .baner-chip,
  .baner-proof,
  .market-orb,
  .market-card,
  .market-card.is-featured,
  .market-card.is-featured::after {
    animation: none !important;
  }
}

[data-scene="orbit"],
[data-scene="core"] {
  --scene-a: #7dd3fc;
  --scene-b: #6ee7a0;
  --scene-c: #fbbf24;
}

[data-scene="grid"] {
  --scene-a: #a78bfa;
  --scene-b: #22d3ee;
  --scene-c: #f472b6;
}

[data-scene="neon"] {
  --scene-a: #f472b6;
  --scene-b: #7dd3fc;
  --scene-c: #fbbf24;
}

[data-scene="signal"] {
  --scene-a: #6ee7a0;
  --scene-b: #fbbf24;
  --scene-c: #7dd3fc;
}

[data-scene="heat"] {
  --scene-a: #fb7185;
  --scene-b: #fbbf24;
  --scene-c: #f472b6;
}

[data-scene="paper"] {
  --scene-a: #c4b5fd;
  --scene-b: #fbbf24;
  --scene-c: #6ee7a0;
}

.baner-page,
.market-page {
  position: relative;
  isolation: isolate;
}

.baner-page > *,
.market-page > * {
  position: relative;
  z-index: 1;
}

.baner-page::before,
.market-page::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background:
    radial-gradient(circle at 82% 8%, var(--scene-a), transparent 45%),
    radial-gradient(circle at 8% 76%, var(--scene-b), transparent 42%),
    radial-gradient(circle at 58% 48%, var(--scene-c), transparent 55%);
  opacity: 0.13;
  filter: blur(34px);
  pointer-events: none;
  transition: opacity 220ms ease;
}

.baner-page.scene-shift::before,
.market-page.scene-shift::before {
  animation: scene-flash 360ms ease;
}

.baner-scene,
.market-scene {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.scene-ring {
  position: absolute;
  border: 2px solid var(--scene-a);
  border-radius: 50%;
  box-shadow: 0 0 70px var(--scene-a);
  opacity: 0.18;
  animation: scene-spin 18s linear infinite;
}

.scene-ring-a {
  width: 680px;
  height: 680px;
  right: -190px;
  top: -210px;
}

.scene-ring-b {
  width: 420px;
  height: 420px;
  left: -170px;
  bottom: -180px;
  border-color: var(--scene-b);
  animation-direction: reverse;
  animation-duration: 13s;
}

.scene-blob {
  position: absolute;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--scene-b), transparent 68%);
  filter: blur(20px);
  opacity: 0.2;
  animation: scene-blob 9s ease-in-out infinite;
}

.scene-blob-a {
  right: 12%;
  bottom: 8%;
}

.scene-blob-b {
  left: 8%;
  top: 18%;
  width: 180px;
  height: 180px;
  background: radial-gradient(circle, var(--scene-c), transparent 68%);
  animation-delay: -3s;
}

.scene-beam {
  position: absolute;
  left: -40%;
  top: 38%;
  width: 180%;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--scene-c), transparent);
  opacity: 0.45;
  transform: rotate(-11deg);
  animation: scene-beam 5s linear infinite;
}

.baner-scene-label,
.market-scene-label {
  color: var(--scene-a);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.market-scene-label {
  margin-left: 4px;
}

.baner-copy h1 {
  animation: baner-title-breathe 4.5s ease-in-out infinite;
}

.baner-strip article {
  animation: baner-card-float 6s ease-in-out infinite;
}

.baner-strip article:nth-child(2n) {
  animation-delay: -2s;
}

.baner-strip article:nth-child(3n) {
  animation-delay: -4s;
}

[data-theme="light"] .baner-page::before,
[data-theme="light"] .market-page::before {
  opacity: 0.08;
}

@keyframes scene-spin {
  to { transform: rotate(360deg); }
}

@keyframes scene-blob {
  50% { transform: translate3d(40px, -24px, 0) scale(1.18); }
}

@keyframes scene-beam {
  from { transform: translateX(-18%) rotate(-11deg); }
  to { transform: translateX(18%) rotate(-11deg); }
}

@keyframes scene-flash {
  0% { opacity: 0.04; }
  45% { opacity: 0.28; }
  100% { opacity: 0.13; }
}

@keyframes baner-title-breathe {
  50% { translate: 0 -6px; }
}

@keyframes baner-card-float {
  50% { translate: 0 -8px; }
}

@media (prefers-reduced-motion: reduce) {
  .baner-page::before,
  .market-page::before,
  .scene-ring,
  .scene-blob,
  .scene-beam,
  .baner-copy h1,
  .baner-strip article {
    animation: none !important;
  }
}

.reel-page {
  --reel-bg: #0f1115;
  --reel-coral: #ff5a4e;
  --reel-blue: #4ea1ff;
  --reel-lime: #b7ff4a;
  --reel-ink: #f4f1e8;
  --reel-line: #2a3039;
  display: grid;
  gap: 22px;
  padding: 30px 0 80px;
}

.reel-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}

.reel-head h1 {
  margin: 8px 0 14px;
  font-size: clamp(48px, 8vw, 108px);
  line-height: 0.84;
  letter-spacing: -0.06em;
}

.reel-head h1 span {
  color: var(--reel-coral);
}

.reel-head .lead {
  max-width: 760px;
}

.reel-meta {
  display: grid;
  grid-template-columns: repeat(2, auto);
  gap: 8px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.reel-meta span {
  padding: 7px 9px;
  border: 2px solid var(--line);
  background: var(--panel-2);
  box-shadow: 3px 3px 0 var(--line);
}

.reel-stage {
  position: relative;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  border: 3px solid var(--line);
  background: var(--reel-bg);
  box-shadow: 10px 10px 0 var(--line);
  cursor: pointer;
}

.reel-stage:fullscreen {
  width: 100vw;
  height: 100vh;
  aspect-ratio: auto;
  border: 0;
  box-shadow: none;
}

.reel-stage:fullscreen .reel-canvas {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.reel-canvas {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
  min-width: 0;
}

.reel-hud {
  position: absolute;
  inset: 0;
  pointer-events: none;
  color: var(--reel-ink);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.reel-hud-tl,
.reel-hud-tr,
.reel-hud-bl,
.reel-hud-br,
.reel-scene-hud,
.reel-rec {
  position: absolute;
  padding: 6px 8px;
  border: 1px solid rgba(244, 241, 232, 0.28);
  background: rgba(15, 17, 21, 0.72);
}

.reel-hud-tl { left: 16px; top: 16px; }
.reel-hud-tr { right: 16px; top: 16px; color: var(--reel-lime); }
.reel-hud-bl { left: 16px; bottom: 16px; }
.reel-hud-br { right: 16px; bottom: 16px; color: var(--reel-coral); }
.reel-scene-hud { left: 50%; top: 16px; translate: -50% 0; color: var(--reel-blue); }
.reel-rec { right: 16px; top: 46px; color: var(--reel-coral); }

.reel-rec i {
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-right: 5px;
  background: var(--reel-coral);
  border-radius: 50%;
  box-shadow: 0 0 10px var(--reel-coral);
  animation: reel-blink 1s steps(2, end) infinite;
}

.reel-corner {
  position: absolute;
  color: rgba(244, 241, 232, 0.62);
  font: 24px/1 ui-monospace, monospace;
}

.reel-corner-tl { left: 12px; top: 10px; }
.reel-corner-tr { right: 12px; top: 10px; }
.reel-corner-bl { left: 12px; bottom: 10px; }
.reel-corner-br { right: 12px; bottom: 10px; }

.reel-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  padding: 12px;
  border: 3px solid var(--line);
  background: var(--panel);
  box-shadow: 5px 5px 0 var(--line);
}

.reel-controls button {
  cursor: pointer;
}

.reel-controls input[type="range"] {
  min-width: 160px;
  flex: 1;
  accent-color: var(--reel-coral);
}

.reel-counter,
.reel-timecode {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.reel-counter b {
  color: var(--reel-coral);
}

.reel-timecode {
  color: var(--muted);
}

.reel-timeline {
  position: relative;
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 0 0 10px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.reel-timeline span {
  padding: 6px 8px;
  border: 2px solid var(--line);
  background: var(--panel-2);
  color: var(--muted);
  white-space: nowrap;
}

.reel-timeline span.is-active {
  background: var(--reel-coral);
  color: var(--reel-bg);
}

.reel-timeline i {
  position: absolute;
  left: var(--playhead, 0%);
  bottom: 0;
  width: 2px;
  height: 10px;
  background: var(--reel-lime);
  transition: left 80ms linear;
}

.reel-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
  padding-top: 20px;
  border-top: 3px solid #1e293b;
}

.reel-bottom h2 {
  margin: 0 0 10px;
  font-family: "Arial Black", Impact, sans-serif;
  font-size: clamp(24px, 3vw, 38px);
  line-height: 1;
}

.reel-bottom p {
  max-width: 760px;
  color: var(--muted);
}

.reel-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

[data-theme="light"] .reel-stage {
  border-color: #0f1115;
  box-shadow: 10px 10px 0 #0f1115;
}

[data-theme="light"] .reel-timeline span {
  background: #fffdf5;
}

[data-theme="light"] .reel-timeline span.is-active {
  background: var(--reel-coral);
}

[data-theme="light"] .reel-controls {
  background: #fffdf5;
}

@keyframes reel-blink {
  50% { opacity: 0.2; }
}

@media (max-width: 700px) {
  .reel-hud {
    font-size: 8px;
  }

  .reel-hud-tl,
  .reel-hud-tr,
  .reel-hud-bl,
  .reel-hud-br,
  .reel-scene-hud,
  .reel-rec {
    padding: 4px 6px;
  }

  .reel-scene-hud {
    display: none;
  }

  .reel-timecode {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .reel-rec i {
    animation: none;
  }
}
