<script type="application/json" id="byrust-config">{"protocol":{"name":"byrust","version":1,"https":true,"alias":"byrust","alt_svc":null,"headers":{"X-Byrust-Site":"rustweb"}},"app":{"name":"RustWeb","uuid":"c5319283-50e1-5a0e-984e-97033f25f18e","trust":"app"}}</script>
<title>RustWeb - FastAPI dla Rusta</title>
<style>:root{--bg:#070b14;--bg-2:#0b1220;--panel:#0d1526;--panel-2:#111a2e;--ink:#f4f7ff;--muted:#a7b6cc;--line:#05070d;--sky:#7dd3fc;--green:#6ee7a0;--gold:#fbbf24;--pink:#f472b6;--red:#fb7185}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;color:var(--ink);background-color:var(--bg);background-image:linear-gradient(rgba(125,211,252,0.055) 1px,transparent 1px),linear-gradient(90deg,rgba(125,211,252,0.055) 1px,transparent 1px);background-size:32px 32px;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.65}::selection{background:var(--gold);color:var(--line)}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:3px solid var(--gold);outline-offset:3px}.topbar{position:sticky;top:12px;z-index:50;display:flex;align-items:center;gap:18px;width:min(1120px,calc(100% - 32px));margin:18px auto 0;padding:12px 16px;border:3px solid var(--line);background:var(--bg-2);box-shadow:7px 7px 0 var(--line)}.brand{display:inline-flex;align-items:center;gap:12px;flex:0 0 auto;font-family:"Arial Black","Segoe UI Black",Impact,sans-serif;font-size:18px;letter-spacing:0.04em}.brand-mark{display:grid;grid-template-columns:1fr 1fr;gap:2px;width:32px;height:32px;padding:2px;border:3px solid var(--line);background:var(--line);box-shadow:3px 3px 0 #02040a}.brand-mark b:nth-child(1){background:var(--sky)}.brand-mark b:nth-child(2){background:var(--green)}.brand-mark b:nth-child(3){background:var(--pink)}.brand-mark b:nth-child(4){background:var(--gold)}.hotbar{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto}.hotbar a{padding:8px 10px;border:2px solid var(--line);background:var(--panel-2);box-shadow:3px 3px 0 var(--line);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase}.hotbar a:hover,.hotbar a.active{background:var(--sky);color:var(--line)}.hotbar a:active{translate:2px 2px;box-shadow:1px 1px 0 var(--line)}.status{display:inline-flex;align-items:center;gap:8px;flex:0 0 auto;padding:8px 10px;border:2px solid var(--line);background:#0b2417;box-shadow:3px 3px 0 var(--line);color:var(--green);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:800;letter-spacing:0.1em}.status i{width:8px;height:8px;background:var(--green);box-shadow:0 0 10px var(--green);animation:blink 1.6s steps(2,end) infinite}main{width:min(1120px,calc(100% - 32px));margin:0 auto;padding:0 0 80px}.hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,0.85fr);gap:42px;align-items:center;padding:76px 0 64px}.eyebrow{display:inline-block;margin:0 0 22px;padding:6px 10px;border:3px solid var(--line);background:var(--gold);box-shadow:4px 4px 0 var(--line);color:var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:900;letter-spacing:0.14em;text-transform:uppercase}h1{margin:0 0 24px;font-family:"Arial Black","Segoe UI Black",Impact,sans-serif;font-size:clamp(42px,6.6vw,82px);line-height:0.94;letter-spacing:-0.045em;text-transform:uppercase;text-shadow:5px 5px 0 var(--line)}h1 span{color:var(--sky)}.lead{max-width:620px;margin:0;color:var(--muted);font-size:clamp(16px,1.8vw,19px);line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:center;padding:13px 18px;border:3px solid var(--line);border-radius:0;background:var(--sky);box-shadow:6px 6px 0 var(--line);color:var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-weight:900;letter-spacing:0.07em;text-transform:uppercase;transition:translate 120ms ease,box-shadow 120ms ease}.button:hover{translate:-2px -2px;box-shadow:8px 8px 0 var(--line)}.button:active{translate:3px 3px;box-shadow:2px 2px 0 var(--line)}.button.ghost{background:var(--bg-2);color:var(--ink)}.button.gold{background:var(--gold)}.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.badge{padding:5px 8px;border:2px solid var(--line);background:var(--panel-2);box-shadow:3px 3px 0 var(--line);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:800;letter-spacing:0.06em;text-transform:uppercase}.hero-art{position:relative;min-height:430px;display:grid;place-items:center}.voxel-scene{position:relative;width:340px;height:380px;perspective:900px}.voxel{position:absolute;width:110px;height:110px;transform-style:preserve-3d;transform:rotateX(-22deg) rotateY(-38deg)}.voxel i{position:absolute;inset:0;display:block;border:4px solid var(--line)}.voxel .top{transform:rotateX(90deg) translateZ(55px)}.voxel .left{transform:rotateY(-90deg) translateZ(55px)}.voxel .right{transform:translateZ(55px)}.grass{left:108px;top:50px;animation:bob 5s ease-in-out infinite}.grass .top{background:var(--green)}.grass .left{background:#22c55e}.grass .right{background:#16a34a}.cube-letter{position:absolute;inset:0;display:grid;place-items:center;transform:translateZ(57px);color:var(--line);font-family:"Arial Black",Impact,sans-serif;font-size:56px;line-height:1;pointer-events:none}.dirt{left:126px;top:166px;animation:bob 6s ease-in-out -1s infinite}.dirt .top{background:#b07a4a}.dirt .left{background:#8a5a35}.dirt .right{background:#6f4629}.stone{left:92px;top:282px;animation:bob 7s ease-in-out -2s infinite}.stone .top{background:#a8b3c4}.stone .left{background:#7c8798}.stone .right{background:#5c6675}.gold{left:238px;top:18px;width:58px;height:58px;animation:bob 6s ease-in-out -3s infinite}.gold i{border-width:3px}.gold .top{transform:rotateX(90deg) translateZ(29px);background:var(--gold)}.gold .left{transform:rotateY(-90deg) translateZ(29px);background:#d99a06}.gold .right{transform:translateZ(29px);background:#b97f00}.voxel-scene::before,.voxel-scene::after{content:"";position:absolute;width:16px;height:16px;border:3px solid var(--line);box-shadow:3px 3px 0 var(--line);animation:bob 6s ease-in-out infinite}.voxel-scene::before{left:12px;top:76px;background:var(--pink)}.voxel-scene::after{right:12px;bottom:54px;background:var(--sky);animation-delay:-2s}.art-tag{position:absolute;right:10px;bottom:8px;padding:8px 10px;border:3px solid var(--line);background:var(--panel-2);box-shadow:4px 4px 0 var(--line);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;line-height:1.5;text-align:right;text-transform:uppercase}.spec-board{display:grid;grid-template-columns:1fr 1fr;gap:12px;width:100%;max-width:360px}.spec-cell{display:flex;flex-direction:column;justify-content:space-between;min-height:105px;padding:16px;border:3px solid var(--line);background:var(--panel);box-shadow:6px 6px 0 var(--line)}.spec-cell strong{color:var(--sky);font-family:"Arial Black",Impact,sans-serif;font-size:28px;line-height:1;letter-spacing:-0.04em}.spec-cell:nth-child(2) strong{color:var(--green)}.spec-cell:nth-child(3) strong{color:var(--gold)}.spec-cell:nth-child(4) strong{color:var(--pink)}.spec-cell span{color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-weight:800;line-height:1.35;letter-spacing:0.08em;text-transform:uppercase}.art-tag strong{color:var(--sky);font-size:14px}.feature-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;padding:18px 0 20px}.card{position:relative;min-height:210px;padding:22px;border:3px solid var(--line);background:var(--panel);box-shadow:7px 7px 0 var(--line)}.card::before{content:"";position:absolute;inset:0 0 auto;height:7px;background:var(--sky)}.card:nth-child(2)::before{background:var(--green)}.card:nth-child(3)::before{background:var(--gold)}.card:nth-child(4)::before{background:var(--pink)}.card-icon{width:34px;height:34px;margin-bottom:16px;border:3px solid var(--line);background:linear-gradient(135deg,var(--sky) 0 48%,transparent 48% 52%,var(--line) 52% 100%);box-shadow:3px 3px 0 var(--line)}.card:nth-child(2) .card-icon{background:linear-gradient(135deg,var(--green) 0 48%,transparent 48% 52%,var(--line) 52% 100%)}.card:nth-child(3) .card-icon{background:linear-gradient(135deg,var(--gold) 0 48%,transparent 48% 52%,var(--line) 52% 100%)}.card:nth-child(4) .card-icon{background:linear-gradient(135deg,var(--pink) 0 48%,transparent 48% 52%,var(--line) 52% 100%)}.card h2{margin:0 0 8px;font-family:"Arial Black","Segoe UI Black",Impact,sans-serif;font-size:15px;line-height:1.15;letter-spacing:-0.01em;text-transform:uppercase}.card p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.6}.split{display:grid;grid-template-columns:1fr 1.08fr;gap:36px;align-items:center;padding:62px 0;border-top:3px solid #1e293b}.split h2,.bench h2{margin:0 0 12px;font-family:"Arial Black","Segoe UI Black",Impact,sans-serif;font-size:clamp(25px,3vw,38px);line-height:1;letter-spacing:-0.035em;text-transform:uppercase;text-shadow:3px 3px 0 var(--line)}.split p,.bench > p{margin:0 0 14px;color:var(--muted)}.note{margin:20px 0 0;padding:14px 16px;border:3px solid var(--line);border-left:8px solid var(--gold);background:#171204;box-shadow:5px 5px 0 var(--line);color:#fde68a;font-size:13px}pre{position:relative;margin:0;padding:40px 18px 18px;border:3px solid var(--line);background:#03050b;box-shadow:7px 7px 0 #1e293b;overflow:auto;font-size:12.5px;line-height:1.75}pre::before{content:"\25CF  \25CF  \25CF";position:absolute;inset:0 0 auto;padding:8px 12px;border-bottom:3px solid var(--line);background:var(--panel-2);color:var(--pink);font-size:10px;letter-spacing:0.18em}pre code{color:#c9d7ea;white-space:pre-wrap;overflow-wrap:anywhere}.bench{padding:62px 0;border-top:3px solid #1e293b}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:26px 0}.stat{padding:18px;border:3px solid var(--line);background:var(--panel);box-shadow:6px 6px 0 var(--line)}.stat strong{display:block;color:var(--green);font-family:"Arial Black",Impact,sans-serif;font-size:clamp(25px,3vw,36px);line-height:1;letter-spacing:-0.04em}.stat:nth-child(2) strong{color:var(--gold)}.stat:nth-child(3) strong{color:var(--sky)}.stat span{display:block;margin-top:8px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase}table{width:100%;margin-top:26px;border:3px solid var(--line);border-collapse:separate;border-spacing:0;background:var(--panel);box-shadow:7px 7px 0 var(--line);font-size:13px}th,td{padding:14px 12px;text-align:left;vertical-align:top;border-bottom:2px solid #1e293b}th{background:var(--panel-2);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:900;letter-spacing:0.12em;text-transform:uppercase}tr:last-child td{border-bottom:0}td:first-child{min-width:210px;font-weight:800}.bar{height:10px;margin-top:8px;border:2px solid var(--line);background:var(--line)}.bar span{display:block;width:var(--bar);height:100%;background:repeating-linear-gradient(90deg,var(--green) 0 9px,var(--line) 9px 12px)}tr:nth-child(3) .bar span{background:repeating-linear-gradient(90deg,var(--red) 0 9px,var(--line) 9px 12px)}.footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;width:min(1120px,calc(100% - 32px));margin:0 auto;padding:20px 0 42px;border-top:3px solid #1e293b;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;letter-spacing:0.04em}.footer-links{display:flex;gap:12px}.footer a:hover{color:var(--sky)}.byrust-warning{position:sticky;top:0;z-index:9999;padding:10px 16px;background:#7f1d1d;color:#fff;font:800 13px/1.4 ui-monospace,monospace;text-align:center}@keyframes bob{50%{translate:0 -12px}}@keyframes blink{50%{opacity:0.25}}@media (max-width:980px){.hero{grid-template-columns:1fr;padding-top:52px}.hero-art{min-height:360px;order:2}.feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.split{grid-template-columns:1fr;gap:24px}.stats{grid-template-columns:1fr}.topbar{flex-wrap:wrap;gap:10px}.hotbar{order:3;margin-left:0}.status{margin-left:auto}}@media (max-width:620px){.feature-grid{grid-template-columns:1fr}.hotbar a{padding:7px 8px;font-size:10px}.voxel-scene{scale:0.86}.brand{font-size:16px}table{display:block;overflow-x:auto;white-space:nowrap}}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none !important;transition:none !important}}.drop-zone{margin-top:20px;padding:22px;border:3px dashed var(--line);background:var(--panel);box-shadow:5px 5px 0 var(--line);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;font-weight:800;letter-spacing:0.06em;text-align:center;cursor:pointer}.drop-zone.active{border-color:var(--sky);background:#13233a;color:var(--sky)}.viewer-frame{display:block;width:100%;height:640px;margin-top:22px;border:3px solid var(--line);background:#0b1020;box-shadow:7px 7px 0 var(--line)}#viewer-code{display:block;max-height:520px;overflow:auto}.cert-form{display:grid;gap:12px;margin-top:16px}.cert-field{display:grid;gap:6px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase}.cert-field input,.cert-secret{width:100%;padding:12px;border:3px solid var(--line);background:#03050b;box-shadow:4px 4px 0 var(--line);color:var(--ink);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;outline:none}.cert-field input:focus,.cert-secret:focus{border-color:var(--sky)}.cert-secret{min-height:48px;resize:vertical}#cert-password{min-height:96px;color:var(--gold);font-size:11px;word-break:break-all}#cert-check-entry{min-height:130px}#cert-entry{display:block;max-height:300px;overflow:auto}.cert-list{display:grid;gap:12px;margin-top:16px}.cert-item{padding:12px;border:3px solid var(--line);background:var(--panel);box-shadow:5px 5px 0 var(--line)}.cert-item strong{display:block;font-family:"Arial Black",Impact,sans-serif;font-size:14px;text-transform:uppercase}.cert-item small{display:block;margin-top:4px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;word-break:break-all}.cert-item .actions{margin-top:10px}.cert-item .badge,button.badge{cursor:pointer}#cert-result{max-height:320px;overflow:auto;white-space:pre-wrap;word-break:break-word}.cert-valid{color:var(--green) !important}.cert-invalid{color:var(--red) !important}.game-page{display:grid;gap:22px}.game-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}.game-head h1{margin:8px 0 12px;font-size:clamp(38px,8vw,86px);line-height:0.9}.game-head h1 span{color:var(--sky)}.game-head .lead{max-width:720px}.game-shell{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:20px;align-items:start}.game-stage{padding:12px;border:3px solid var(--line);background:var(--panel);box-shadow:7px 7px 0 var(--line)}.game-canvas{display:block;width:100%;height:auto;border:3px solid var(--line);background:#070b14;image-rendering:pixelated}.game-toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.game-toolbar button,button.badge{cursor:pointer}.game-side{display:grid;gap:16px;align-content:start}.game-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.game-stats .spec-cell strong{font-size:18px}.game-systems{display:grid;gap:8px;margin-top:10px}.game-system{padding:8px 10px;border:2px solid var(--line);background:var(--panel-2);box-shadow:3px 3px 0 var(--line)}.game-system strong{display:block;color:var(--sky);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}.game-system small{display:block;margin-top:4px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px}.game-chat{display:flex;gap:6px}.game-chat input{min-width:0;flex:1;padding:10px;border:3px solid var(--line);background:#03050b;color:var(--ink);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;outline:none}.game-chat input:focus{border-color:var(--sky)}.game-bottom{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,0.85fr);gap:20px}.game-log{height:360px;margin-top:10px;overflow:auto;border:3px solid var(--line);background:#03050b;box-shadow:5px 5px 0 var(--line);padding:8px}.game-log-entry{padding:3px 7px;border-left:3px solid var(--muted);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;line-height:1.55;word-break:break-word}.game-log-entry.out{border-color:var(--sky);color:var(--sky)}.game-log-entry.in{border-color:var(--green);color:var(--green)}.game-log-entry.route{border-color:var(--gold);color:var(--gold)}.game-log-entry.err{border-color:var(--red);color:var(--red)}.game-log-entry.sys{border-color:var(--pink);color:var(--pink)}#game-packet{max-height:360px;overflow:auto}@media (max-width:980px){.game-shell,.game-bottom{grid-template-columns:1fr}}[data-theme="light"]{--bg:#f4efe4;--bg-2:#fffaf0;--panel:#fff6e5;--panel-2:#ffe9c7;--ink:#17120a;--muted:#635845;--line:#17120a;--sky:#0369a1;--green:#15803d;--gold:#b45309;--pink:#be185d;--red:#b91c1c}[data-theme="light"] body{background-image:linear-gradient(rgba(23,18,10,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(23,18,10,0.06) 1px,transparent 1px)}.theme-toggle{padding:8px 10px;border:2px solid var(--line);background:var(--panel-2);box-shadow:3px 3px 0 var(--line);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:800;letter-spacing:0.08em;cursor:pointer}.theme-toggle:hover{background:var(--gold);color:var(--line)}[data-theme="light"] .status{background:#dcfce7;color:#166534}[data-theme="light"] pre,[data-theme="light"] .drop-zone,[data-theme="light"] .cert-field input,[data-theme="light"] .cert-secret,[data-theme="light"] .game-chat input,[data-theme="light"] .game-log{background:#fffdf5;color:var(--ink)}[data-theme="light"] pre code{color:#292217}[data-theme="light"] .note{background:#fff7d6;color:#713f12}[data-theme="light"] .drop-zone.active{background:#e0f2fe;color:var(--sky)}[data-theme="light"] .viewer-frame{background:#fff}[data-theme="light"] .split,[data-theme="light"] .bench,[data-theme="light"] .footer{border-color:#d8cbb6}[data-theme="light"] .topbar,[data-theme="light"] .footer{background-color:var(--bg-2)}.deploy-hero{padding:70px 0 30px}.deploy-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;padding:26px 0 60px}.deploy-card{padding:20px;border:3px solid var(--line);background:var(--panel);box-shadow:7px 7px 0 var(--line)}.deploy-card h2{margin:0 0 10px;font-family:"Arial Black",Impact,sans-serif;font-size:22px;line-height:1;text-transform:uppercase}.deploy-card p{color:var(--muted);font-size:13px}.code-block{position:relative;margin-top:14px}.copy-button{position:absolute;top:10px;right:10px;z-index:3;padding:5px 8px;border:2px solid var(--line);background:var(--gold);box-shadow:3px 3px 0 var(--line);color:var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-weight:900;letter-spacing:0.08em;cursor:pointer}.copy-button:hover{background:var(--sky)}.code-block pre{margin:0;padding-top:48px}.service-table{display:grid;gap:8px}.service-row{display:grid;grid-template-columns:100px minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px 12px;border:3px solid var(--line);background:var(--panel-2);box-shadow:4px 4px 0 var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px}.service-row strong{color:var(--sky);text-transform:uppercase}.service-row span{color:var(--muted)}.service-row code{color:var(--gold);font-size:9px;white-space:nowrap}[data-theme="light"] .deploy-card,[data-theme="light"] .service-row{background:#fffdf5}@media (max-width:820px){.deploy-grid{grid-template-columns:1fr}.service-row{grid-template-columns:80px minmax(0,1fr)}.service-row code{grid-column:1 / -1}}.suite-section{padding:62px 0;border-top:3px solid #1e293b}.suite-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:26px}.suite-card{display:grid;align-content:start;gap:10px;min-height:190px;padding:18px;border:3px solid var(--line);background:var(--panel);box-shadow:6px 6px 0 var(--line)}.suite-card:hover{background:var(--panel-2);translate:-2px -2px;box-shadow:8px 8px 0 var(--line)}.suite-card strong{color:var(--gold);font-family:"Arial Black",Impact,sans-serif;font-size:18px;letter-spacing:-0.02em}.suite-card span{color:var(--muted);font-size:13px;line-height:1.55}.suite-card em{margin-top:auto;color:var(--sky);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-style:normal;font-weight:900;letter-spacing:0.1em}.compare-table{margin-top:0;font-size:11px}.compare-table td:first-child{min-width:0;font-weight:700}.compare-table th:nth-child(2),.compare-table td:nth-child(2){color:var(--green)}[data-theme="light"] .suite-section{border-color:#d8cbb6}[data-theme="light"] .suite-card{background:#fffdf5}@media (max-width:980px){.suite-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (max-width:620px){.suite-grid{grid-template-columns:1fr}}.baner-page{overflow:hidden}.baner-stage{position:relative;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,0.85fr);gap:42px;align-items:center;min-height:760px;padding:60px 0 70px}.baner-grid{position:absolute;inset:-20%;z-index:0;background-image:linear-gradient(rgba(125,211,252,0.09) 1px,transparent 1px),linear-gradient(90deg,rgba(125,211,252,0.09) 1px,transparent 1px);background-size:44px 44px;mask-image:radial-gradient(circle at 50% 50%,#000 20%,transparent 72%);animation:baner-grid-drift 9s linear infinite}.baner-orb{position:absolute;z-index:0;width:180px;height:180px;border:3px solid var(--line);border-radius:50%;opacity:0.75;filter:blur(1px);animation:baner-float 5s ease-in-out infinite}.orb-a{top:12%;right:30%;background:radial-gradient(circle at 32% 28%,#7dd3fc,#0369a1 65%,#070b14)}.orb-b{right:5%;bottom:12%;width:110px;height:110px;background:radial-gradient(circle at 32% 28%,#6ee7a0,#15803d 65%,#070b14);animation-delay:-1.7s}.orb-c{left:4%;bottom:18%;width:76px;height:76px;background:radial-gradient(circle at 32% 28%,#fbbf24,#b45309 65%,#070b14);animation-delay:-3.1s}.baner-copy,.baner-proof{position:relative;z-index:2}.baner-copy h1{margin:0 0 22px;font-size:clamp(58px,10vw,132px);line-height:0.82;letter-spacing:-0.07em;text-transform:uppercase;text-shadow:7px 7px 0 var(--line)}.baner-copy h1 span{color:var(--sky)}.baner-copy .lead{max-width:640px}.baner-controls{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:28px}.baner-controls button{cursor:pointer}.baner-index{margin-left:4px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;font-weight:800;letter-spacing:0.1em}.baner-live{display:inline-flex;align-items:center;gap:7px;margin-left:auto;color:var(--green);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-weight:900;letter-spacing:0.1em}.baner-live i,.market-live-dot{width:8px;height:8px;background:var(--green);border-radius:50%;box-shadow:0 0 12px var(--green);animation:baner-pulse 1s steps(2,end) infinite}.baner-proof{padding:26px;border:3px solid var(--line);background:rgba(13,21,38,0.94);box-shadow:10px 10px 0 var(--line);transition:border-color 160ms ease,transform 160ms ease}.baner-proof.flip{animation:baner-flip 240ms ease}.baner-proof[data-accent="sky"] strong,.baner-proof[data-accent="sky"] .baner-proof-link{color:var(--sky)}.baner-proof[data-accent="green"] strong,.baner-proof[data-accent="green"] .baner-proof-link{color:var(--green)}.baner-proof[data-accent="gold"] strong,.baner-proof[data-accent="gold"] .baner-proof-link{color:var(--gold)}.baner-proof[data-accent="pink"] strong,.baner-proof[data-accent="pink"] .baner-proof-link{color:var(--pink)}.baner-proof-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:900;letter-spacing:0.12em}.baner-proof > strong{display:block;font-family:"Arial Black",Impact,sans-serif;font-size:clamp(56px,8vw,104px);line-height:0.82;letter-spacing:-0.06em}.baner-proof > span{display:block;margin-top:8px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;font-weight:900;letter-spacing:0.16em}.baner-proof p{margin:20px 0;color:var(--ink);font-size:14px;line-height:1.55}.baner-proof-link{display:inline-block;color:var(--sky);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:900;letter-spacing:0.1em}.baner-proof-link:hover{text-decoration:underline}.baner-progress{height:8px;margin-top:22px;border:2px solid var(--line);background:var(--bg)}.baner-progress span{display:block;width:0;height:100%;background:var(--sky)}.baner-progress span.run{animation:baner-progress 500ms linear forwards}.baner-proof-note{display:block;margin-top:10px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:8px;letter-spacing:0.04em}.baner-ticker,.market-ticker{overflow:hidden;border-top:3px solid var(--line);border-bottom:3px solid var(--line);background:var(--gold);color:var(--line)}.baner-track,.market-track{display:flex;width:max-content;gap:18px;padding:10px 0;animation:baner-marquee 18s linear infinite;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;font-weight:900;letter-spacing:0.08em;white-space:nowrap}.baner-track b,.market-track b{color:var(--line)}.baner-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;padding:34px 0 70px}.baner-strip article{padding:20px;border:3px solid var(--line);background:var(--panel);box-shadow:6px 6px 0 var(--line)}.baner-strip strong{display:block;color:var(--sky);font-family:"Arial Black",Impact,sans-serif;font-size:28px;line-height:1}.baner-strip span{display:block;margin-top:6px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-weight:900;letter-spacing:0.1em}.baner-strip p{color:var(--muted);font-size:13px}.baner-strip a{color:var(--gold);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-weight:900;letter-spacing:0.1em}.market-hero{padding:70px 0 26px}.market-hero h1{margin:0 0 20px;font-size:clamp(52px,9vw,112px);line-height:0.84;letter-spacing:-0.06em;text-transform:uppercase;text-shadow:6px 6px 0 var(--line)}.market-hero h1 span{color:var(--gold)}.market-live{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:24px;padding:10px 12px;border:3px solid var(--line);background:var(--panel-2);box-shadow:4px 4px 0 var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:900;letter-spacing:0.08em}.market-live strong{color:var(--sky)}.market-live button{margin-left:auto;cursor:pointer}.market-filters{display:flex;flex-wrap:wrap;gap:8px;padding:22px 0 16px}.market-filters .badge{cursor:pointer}.market-filters .badge.is-active{background:var(--sky);color:var(--line)}.market-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;padding:10px 0 50px}.market-card{display:grid;align-content:start;gap:10px;min-height:250px;padding:18px;border:3px solid var(--line);background:var(--panel);box-shadow:6px 6px 0 var(--line);transition:transform 140ms ease,border-color 140ms ease,box-shadow 140ms ease}.market-card.is-featured{border-color:var(--sky);box-shadow:9px 9px 0 var(--sky);transform:translateY(-4px)}.market-card[hidden]{display:none}.market-card-top{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-weight:900;letter-spacing:0.08em}.market-card h2{margin:0;font-family:"Arial Black",Impact,sans-serif;font-size:23px;line-height:1;text-transform:uppercase}.market-card p{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.market-card > strong{margin-top:auto;color:var(--gold);font-family:"Arial Black",Impact,sans-serif;font-size:26px;line-height:1}.market-card > strong small{color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:8px;letter-spacing:0.08em}.market-card a{color:var(--sky);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-weight:900;letter-spacing:0.1em}.market-card a:hover{text-decoration:underline}[data-theme="light"] .baner-proof{background:#fffdf5}[data-theme="light"] .baner-grid{background-image:linear-gradient(rgba(23,18,10,0.07) 1px,transparent 1px),linear-gradient(90deg,rgba(23,18,10,0.07) 1px,transparent 1px)}[data-theme="light"] .baner-strip article,[data-theme="light"] .market-card{background:#fffdf5}[data-theme="light"] .baner-ticker,[data-theme="light"] .market-ticker{background:var(--gold)}@keyframes baner-grid-drift{50%{transform:translate3d(22px,18px,0)}}@keyframes baner-float{50%{transform:translate3d(0,-22px,0) rotate(8deg)}}@keyframes baner-flip{0%{transform:translateY(8px) scale(0.985);opacity:0.78}100%{transform:translateY(0) scale(1);opacity:1}}@keyframes baner-progress{from{width:0}to{width:100%}}@keyframes baner-marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}@keyframes baner-pulse{50%{opacity:0.25}}@media (max-width:980px){.baner-stage{grid-template-columns:1fr;min-height:auto;padding-top:42px}.baner-proof{max-width:560px}.baner-strip,.market-grid{grid-template-columns:1fr 1fr}}@media (max-width:620px){.baner-copy h1,.market-hero h1{font-size:clamp(48px,16vw,76px)}.baner-strip,.market-grid{grid-template-columns:1fr}.baner-live{margin-left:0}}@media (prefers-reduced-motion:reduce){.baner-grid,.baner-orb,.baner-track,.market-track,.baner-live i,.market-live-dot{animation:none}.baner-proof.flip{animation:none}}.byrust-warning{position:sticky;top:0;z-index:9999;padding:10px 16px;background:#7f1d1d;color:#fff;font:600 13px/1.4 system-ui,sans-serif;text-align:center}</style>
</head>
<body>
<div class="topbar"> <a class="brand" href="/rustweb/" aria-label="RustWeb"> <span class="brand-mark" aria-hidden="true"><b></b><b></b><b></b><b></b></span> <span>RUSTWEB</span> </a> <nav class="hotbar" aria-label="Glowne"> <a href="/rustweb/" data-nav="home">01 START</a> <a href="/rustweb/about" data-nav="about">02 MHTML</a> <a href="/rustweb/bench" data-nav="bench">03 BENCH</a> <a href="/rustweb/viewer" data-nav="viewer">04 VIEWER</a> <a href="/rustweb/cert" data-nav="cert">05 CERT</a> <a href="/rustweb/game" data-nav="game">06 GAME</a> <a href="/rustweb/deploy" data-nav="deploy">07 DEPLOY</a> </nav> <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Przelacz motyw">JASNY</button> <span class="status"><i></i> BYRUST/1</span> </div><main id="rweb-app"></main><footer class="footer"> <span>RUSTWEB 0.1.0 // MHTML + .RWEB // <span id="year"></span></span> <span class="footer-links"><a href="/rustweb/">START</a><a href="/rustweb/about">MHTML</a><a href="/rustweb/bench">BENCH</a><a href="/rustweb/viewer">VIEWER</a><a href="/rustweb/cert">CERT</a><a href="/rustweb/game">GAME</a><a href="/rustweb/deploy">DEPLOY</a><a href="/rustweb/market">MARKET</a><a href="/rustweb/baner">BANER</a></span> </footer>
<noscript>MHTML needs JavaScript.</noscript>
<template data-rweb-route="/" data-rweb-title="RustWeb - FastAPI dla Rusta"><section class="hero"><div class="hero-copy"><p class="eyebrow">RUST // FASTAPI DX // ONE FILE</p><h1>API W RUSTCIE.<br><span>JAK W FASTAPI.</span></h1><p class="lead">Deklarujesz typy wejscia i wyjscia. RustWeb daje walidacje, bledy 422 w ksztalcie FastAPI, OpenAPI i Swagger UI. Bez warstwy posredniej w hot path.</p><div class="actions"> <a class="button" href="/rustweb/deploy">POSTAW U SIEBIE</a> <a class="button ghost" href="/rustweb/bench">ZOBACZ BENCHMARK</a> <a class="button ghost" href="/rustweb/about">JAK DZIALA MHTML</a> </div><div class="badges"> <span class="badge">1 PLIK .RWEB</span> <span class="badge">0 RUNTIME TEMPLATING</span> <span class="badge">112 KB</span> <span class="badge">ASCII ONLY</span> <span class="badge">DOCKER READY</span> </div></div><div class="hero-art" aria-hidden="true"><div class="voxel-scene"><div class="voxel grass"> <i class="top"></i><i class="left"></i><i class="right"></i> <span class="cube-letter">R</span> </div><div class="voxel dirt"> <i class="top"></i><i class="left"></i><i class="right"></i> </div><div class="voxel stone"> <i class="top"></i><i class="left"></i><i class="right"></i> </div><div class="voxel gold"> <i class="top"></i><i class="left"></i><i class="right"></i> </div></div><div class="art-tag">SINGLE FILE<br><strong>.RWEB</strong></div></div></section><section class="feature-grid"> <article class="card"><div class="card-icon"></div><h2>Makra zamiast boilerplate'u</h2><p>#[get], #[post] i #[model] zamieniaja sygnatury funkcji w routing, walidacje i schematy OpenAPI. Rozwijaja sie w czasie kompilacji.</p></article><article class="card"><div class="card-icon"></div><h2>Bledy, ktorych nie trzeba mapowac</h2><p>ApiJson, ApiPath i ApiQuery zwracaja 422 z detail[]{type, loc, msg, ctx}. Ksztalt znany z FastAPI, bez recznego klejenia JSON-a.</p></article><article class="card"><div class="card-icon"></div><h2>MHTML zamiast szablonow</h2><p>Mini-HTML z interpolacja, @if i @for, pelny HTML, MCSS ze zmiennymi i MScript z modulami. Kompilator sklada wszystko w jeden plik .rweb.</p></article><article class="card"><div class="card-icon"></div><h2>Zero narzutu w hot path</h2><p>Cienka warstwa nad axum. Benchmark na tej samej maszynie: 210 750 req/s dla RustWeb i 208 173 req/s dla czystego axum.</p></article> </section><section class="split"><div><p class="eyebrow">01 // DX</p><h2>PISZ JAK W FASTAPI</h2><p>Makro rozwija sie w czasie kompilacji, wiec routing i dokumentacja nie kosztuja nic w czasie zadania. Walidacja jest jedyna dodatkowa praca i dzieje sie tylko wtedy, gdy jej uzyjesz.</p><p class="note">Makro rozwija sie w czasie kompilacji. Routing, walidacja i OpenAPI nie dodaja warstwy w request path.</p></div><pre><code>#[rustweb::get("/users/{id}")]
async fn get_user(ApiPath(id): ApiPath&lt;u64&gt;) -&gt; ApiResult&lt;Json&lt;User&gt;&gt; {
    Ok(Json(User { id, name: "Ada".into(), age: 36 }))
}</code></pre></section><section class="bench"><p class="eyebrow">02 // POMIAR</p><h2>RUSTWEB VS AXUM VS FASTAPI</h2><p>Ten sam komputer, ta sama trasa /hello, ten sam load generator: 64 polaczenia keep-alive, 200 000 requestow, serwer przypiety do 2 rdzeni. FastAPI to uvicorn z 2 workerami.</p><div class="stats"><div class="stat"><strong>210 750</strong><span>REQ/S RUSTWEB</span></div><div class="stat"><strong>0.70 ms</strong><span>P99 RUSTWEB</span></div><div class="stat"><strong>6.6 MB</strong><span>RSS SERWERA .RWEB</span></div></div><table><thead><tr><th>SERWER</th><th>THROUGHPUT</th><th>P99</th></tr></thead><tbody> <tr><td> RustWeb <div class="bar"><span style="--bar: 100%"></span></div></td><td>210 750 req/s</td><td>0.70 ms</td></tr><tr><td> plain axum <div class="bar"><span style="--bar: 99%"></span></div></td><td>208 173 req/s</td><td>0.74 ms</td></tr><tr><td> FastAPI + uvicorn <div class="bar"><span style="--bar: 7%"></span></div></td><td>13.8-14.3k req/s</td><td>4.5-5.0 ms</td></tr> </tbody></table><p class="note">RustWeb i axum sa w granicach szumu. FastAPI placi za Pythona i runtime Pydantic, nie za sam ksztalt API.</p></section><section class="split"><div><p class="eyebrow">03 // MHTML -> .RWEB</p><h2>JEDEN PLIK. ZERO ZALEZNOSCI.</h2><p>Strony piszesz w MHTML. Komenda <code>rweb build site</code> renderuje HTML, inline'uje CSS, transpiluje TypeScript i pakuje wszystko w jeden plik.</p><p>linker.json wskazuje strony, style, skrypty i assety. Kompilator renderuje MHTML, inline'uje CSS, transpiluje TypeScript i zamienia obrazy na data URI. Wynik to jeden plik .rweb.</p><div class="actions"> <a class="button gold" href="/rustweb/about">POZNAJ MHTML</a> </div></div><pre><code>&lt;h1&gt;{{ title }}&lt;/h1&gt;
@if show_badge {
  &lt;span class="badge"&gt;{{ version }}&lt;/span&gt;
}
@for feature in features {
  &lt;article&gt;{{ feature.title }}&lt;/article&gt;
}
{{{ trusted_html }}}</code></pre></section><section class="suite-section"><p class="eyebrow">04 // PAKIET, NIE FRAMEWORK</p><h2>WIECEJ NIZ API.</h2><p class="lead">RustWeb to jedna binarka, jeden plik strony i zestaw uslug, ktorych normalnie szukasz w pieciu osobnych projektach.</p><div class="actions"> <a class="button gold" href="/rustweb/market">WEJDZ DO MARKET</a> <a class="button ghost" href="/rustweb/baner">ZOBACZ BANER</a> </div><div class="suite-grid"> <a class="suite-card" href="/rustweb/cert"> <strong>CERT DB</strong> <span>Publiczny rejestr aplikacji, fingerprinty i jednorazowe klucze. Bez plaintext UUID w bazie.</span> <em>OTWORZ /cert</em> </a> <a class="suite-card" href="/rustweb/deploy"> <strong>TCPS</strong> <span>Per-user pliki, manifest, sync brakujacych plikow i sesje graczy po UDP z limitem bandwidth.</span> <em>JAK POSTAWIC</em> </a> <a class="suite-card" href="/rustweb/deploy"> <strong>UC PACKS</strong> <span>Binarne compression packi dla malych pakietow. Zstd, CRC32, limit 4 KB na pakiet.</span> <em>JAK POSTAWIC</em> </a> <a class="suite-card" href="/rustweb/game"> <strong>GAME LAB</strong> <span>Packet Arena z dziewiecioma systemami, logami i twardym limitem 4096 B.</span> <em>ZAGRAJ</em> </a> </div></section><section class="split"><div><p class="eyebrow">05 // DLACZEGO TO INNE</p><h2>NIE DOKLADAJ KOLEJNEJ WARSTWY.</h2><p>Wiekszosc stackow optymalizuje jeden fragment. RustWeb laczy API, statyczny frontend, certyfikacje, transport plikow, kompresje pakietow i testowy game lab w jednym repo.</p><p class="note">To nie jest benchmark marketingowy. Liczby sa w `bench/RESULTS.md`, a kazda usluga ma wlasny test i komende startowa.</p></div><table class="compare-table"><thead><tr><th>FUNKCJA</th><th>RUSTWEB</th><th>TYPOWY STACK</th></tr></thead><tbody><tr><td>Runtime templating</td><td>0</td><td>Jinja / RSC / Node</td></tr><tr><td>Deploy strony</td><td>1 plik .rweb</td><td>build + serwer + CDN</td></tr><tr><td>Publiczny cert DB</td><td>w repo</td><td>osobny serwis</td></tr><tr><td>Per-user file sync</td><td>tcps</td><td>osobny backend</td></tr><tr><td>Compression packs</td><td>uc</td><td>wlasny format</td></tr><tr><td>Game packet lab</td><td>/game</td><td>osobny prototyp</td></tr></tbody></table></section><section class="split"><div><p class="eyebrow">06 // START</p><h2>OD ZERA DO HTTPS.</h2><p>Jedna komenda buduje strone i uruchamia lokalny serwer z certyfikatem Byrust. Docker jest dla tych, ktorzy chca od razu kontener.</p><div class="actions"> <a class="button" href="/rustweb/deploy">ZOBACZ DEPLOY</a> <a class="button ghost" href="https://github.com/gabeczkag/rustweb" target="_blank" rel="noreferrer">GITHUB</a> </div></div><div class="code-block"> <button class="copy-button" data-copy="#home-start" type="button">KOPIUJ</button> <pre><code id="home-start">git clone https://github.com/gabeczkag/rustweb.git
cd rustweb
./run.sh

# albo kontener:
docker compose up --build</code></pre></div></section><section class="bench"><p class="eyebrow">07 // WYBOR</p><h2>POSTAW TO U SIEBIE.</h2><p>Masz jeden plik strony, jedna binarke i siedem tras. Reszta to opcjonalne uslugi, ktore mozesz wlaczac po kolei.</p><div class="actions"> <a class="button" href="/rustweb/deploy">WDROZ TERAZ</a> <a class="button ghost" href="/rustweb/bench">SPRAWDZ BENCHMARK</a> </div></section></template>
<template data-rweb-route="/about" data-rweb-title="MHTML i .rweb - RustWeb"><section class="hero"><div class="hero-copy"><p class="eyebrow">MHTML // MINI-HTML // ONE FILE</p><h1>HTML.<br><span>ALE W BLOKACH.</span></h1><p class="lead">MHTML to mini-HTML: znaczniki, interpolacja i dwie dyrektywy. Kompilator <code>rweb</code> sklada strony, MCSS, MScript, TypeScript i assety w jeden <code>.rweb</code>, ktory uruchamia RustWeb.</p><div class="actions"> <a class="button" href="/rustweb/bench">ZOBACZ WYNIKI</a> <a class="button ghost" href="/rustweb/">WROC NA START</a> </div><div class="badges"> <span class="badge">MHTML</span> <span class="badge">LINKER.JSON</span> <span class="badge">MCSS</span> <span class="badge">MSCRIPT</span> </div></div><div class="hero-art" aria-hidden="true"><div class="spec-board"><div class="spec-cell"><strong>9</strong><span>STRONY W JEDNYM PLIKU</span></div><div class="spec-cell"><strong>1</strong><span>PLIK .RWEB</span></div><div class="spec-cell"><strong>0</strong><span>RUNTIME TEMPLATING</span></div><div class="spec-cell"><strong>112 KB</strong><span>WAGA PLIKU .RWEB</span></div></div><div class="art-tag">BUILD<br><strong>RWEB</strong></div></div></section><section class="feature-grid"><article class="card"><div class="card-icon"></div><h2>{{ expression }}</h2><p>Wartosci pochodza z JSON-a w <code>linker.json</code> i sa escapowane w tekscie oraz atrybutach. Dane uzytkownika nie wstrzykna HTML-a.</p></article><article class="card"><div class="card-icon"></div><h2>&#64;if i &#64;for</h2><p>Warunki i petle dzialaja na danych projektu. W petli masz <code>loop.index</code>, <code>loop.first</code> i <code>loop.last</code>.</p></article><article class="card"><div class="card-icon"></div><h2>linker.json</h2><p>Jeden manifest wskazuje strony, style, skrypty i assety. Wszystkie sciezki sa rozwiazywane wzgledem pliku manifestu.</p></article><article class="card"><div class="card-icon"></div><h2>ZERO RUNTIME</h2><p>Strony sa renderowane przy budowaniu. RustWeb serwuje gotowy HTML, wiec request nie placi za parser ani evaluator.</p></article></section><section class="split"><div><p class="eyebrow">01 // SKLADNIA</p><h2>MALY JEZYK, KTORY WYSTARCZA</h2><p>Bez wbudowanego JavaScriptu i setek helperow. HTML, interpolacja, <code>&#64;if</code>, <code>&#64;else</code> i <code>&#64;for</code>. Pelny HTML jest wspierany - kompilator redukuje dokument do <code>&lt;body&gt;</code>.</p><p class="note">Literalny szablon jest zaufany; escapowane sa tylko wartosci interpolowane. <code>&#123;&#123;&#123; trusted_html &#125;&#125;&#125;</code> wstawia surowy HTML bez escapowania - uzywaj tylko dla zaufanych fragmentow.</p></div><pre><code>&lt;h1&gt;{{ title }}&lt;/h1&gt;
@if show_badge {
  &lt;span class="badge"&gt;{{ version }}&lt;/span&gt;
}
@for feature in features {
  &lt;article&gt;{{ feature.title }}&lt;/article&gt;
}
{{{ trusted_html }}}</code></pre></section><section class="split"><div><p class="eyebrow">02 // KOMPILACJA</p><h2>JEDEN PLIK .RWEB</h2><p><code>linker.json</code> opisuje strony i zasoby. Kompilator renderuje MHTML, inline'uje CSS, transpiluje TypeScript przez <code>tsc</code> i zamienia obrazy na data URI.</p><p>Build: <code>rweb build site</code>. Podglad: <code>rweb inspect site/site.rweb</code>. Uruchomienie: <code>rustweb site/site.rweb</code>.</p><p class="note">Strony moga byc <code>.mhtml</code> albo zwyklym <code>.html</code>; pelny dokument jest redukowany do <code>&lt;body&gt;</code>.</p></div><pre><code>{
  "site": { "title": "RustWeb", "version": "0.1.0" },
  "app": { "name": "RustWeb", "uuid": "..." },
  "frame": "frame.mhtml",
  "base": "/rustweb",
  "ascii": true,
  "styles": ["assets/style.css"],
  "scripts": ["scripts/app.ts"],
  "pages": [
    { "route": "/", "file": "pages/index.mhtml" }
  ]
}</code></pre></section><section class="split"><div><p class="eyebrow">03 // MCSS + MSCRIPT</p><h2>MINI STACK, NIE FRAMEWORK</h2><p><code>.mcss</code> to CSS ze zmiennymi <code>$name</code>. Kompilator rozwiazuje je przed minifikacja, wiec w <code>.rweb</code> zostaje zwykly, maly CSS.</p><p><code>.mscript</code> to Node-owy styl modulow dla MHTML: relatywne <code>import</code>, <code>export</code> i <code>require</code> sa bundlowane do jednego klasycznego skryptu. Nie emuluje built-inow Node'a - dziala na API przegladarki.</p><p class="note">Viewer na tej stronie jest napisany w MScript i importuje <code>format.mscript</code>.</p><div class="actions"> <a class="button" href="/rustweb/viewer">OTWORZ VIEWER</a> </div></div><pre><code>$sky: #7dd3fc;
$line: #05070d;
.button { background: $sky; border: 3px solid $line; }

import { bytes } from "./format.mscript";
export function size(n) { return bytes(n); }</code></pre></section><section class="bench"><p class="eyebrow">04 // BYRUST</p><h2>HTTPS, KTORE MOWI WICEJ</h2><p><code>linker.json</code> ustawia <code>protocol.name = "byrust"</code>, wersje, wymog HTTPS, alias i wlasne naglowki. Kompilator wpisuje je do <code>.rweb</code> jako meta i <code>byrust-config</code>.</p><div class="stats"><div class="stat"><strong>v1</strong><span>PROTOCOL BYRUST</span></div><div class="stat"><strong>RustWeb</strong><span>APP // c5319283-50e1-5a0e-984e-97033f25f18e</span></div><div class="stat"><strong>LOCAL CA</strong><span>NO SELF-SIGNED LEAF</span></div></div><p>Puste <code>app.uuid</code> generuje stabilny UUID, a <code>"universal"</code> oznacza niskie zaufanie. Universal UUID dostaje certyfikat z osobnego, celowo niezaufanego CA: przegladarka ostrzega, a strona pokazuje czerwony banner <strong>Page is not safe</strong>.</p><p class="note">Przegladarka nadal widzi <code>https://</code> - tylko TLS z zaufanym certyfikatem daje bezpieczny kontekst. <code>byrust://</code> jest aliasem routera, a <code>web+byrust</code> moze byc handlerem przegladarki.</p><pre><code>"protocol": {
  "name": "byrust",
  "version": 1,
  "https": true,
  "alias": "byrust"
}</code></pre></section><section class="bench"><p class="eyebrow">05 // HOSTING</p><h2>JEDEN PLIK, MNIEJ RAM-U</h2><p>Pomiar RSS po starcie, bez ruchu: ~6,6 MB dla rustweb i ~153 MB dla FastAPI + uvicorn z dwoma workerami. Jeden proces, jeden plik HTML, zero runtime'owego templatingu.</p><p class="note">GitHub Pages serwuje ten sam <code>.rweb</code> statycznie przez certyfikat GitHuba. Lokalny Byrust CA, klucze aplikacji i Universal CA zostaja poza repozytorium.</p><p>Sprobuj aliasu: <a href="byrust://self/bench">byrust://self/bench</a></p></section></template>
<template data-rweb-route="/bench" data-rweb-title="Benchmark - RustWeb"><section class="hero"><div class="hero-copy"><p class="eyebrow">BENCHMARK // NIE MARKETING</p><h1>ILE KOSZTUJE<br><span>WARSTWA FRAMEWORKA?</span></h1><p class="lead">Ten sam komputer, ta sama trasa /hello, ten sam load generator: 64 polaczenia keep-alive, 200 000 requestow, serwer przypiety do 2 rdzeni. FastAPI to uvicorn z 2 workerami.</p><div class="actions"> <a class="button" href="/rustweb/about">JAK DZIALA MHTML</a> <a class="button ghost" href="/rustweb/">WROC NA START</a> </div></div><div class="hero-art" aria-hidden="true"><div class="spec-board"><div class="spec-cell"><strong>210k</strong><span>RUSTWEB REQ/S</span></div><div class="spec-cell"><strong>208k</strong><span>AXUM REQ/S</span></div><div class="spec-cell"><strong>14k</strong><span>FASTAPI REQ/S</span></div><div class="spec-cell"><strong>6.6</strong><span>MB RSS SERWERA</span></div></div><div class="art-tag">P99<br><strong>0.70 MS</strong></div></div></section><section class="bench"><div class="stats"><div class="stat"><strong>210 750</strong><span>RUSTWEB REQ/S</span></div><div class="stat"><strong>0.70 ms</strong><span>RUSTWEB P99</span></div><div class="stat"><strong>6.6 MB</strong><span>RSS PO STARCIE</span></div></div><table><thead><tr><th>SERWER</th><th>THROUGHPUT</th><th>P99</th></tr></thead><tbody> <tr><td> RustWeb <div class="bar"><span style="--bar: 100%"></span></div></td><td>210 750 req/s</td><td>0.70 ms</td></tr><tr><td> plain axum <div class="bar"><span style="--bar: 99%"></span></div></td><td>208 173 req/s</td><td>0.74 ms</td></tr><tr><td> FastAPI + uvicorn <div class="bar"><span style="--bar: 7%"></span></div></td><td>13.8-14.3k req/s</td><td>4.5-5.0 ms</td></tr> </tbody></table><p class="note">RustWeb i axum mieszcza sie w granicach szumu: raz RustWeb jest o 1-2% szybszy, raz o 1% wolniejszy. FastAPI jest wolniejsze o rzad wielkosci, bo placi za Pythona i runtime Pydantic.</p></section><section class="split"><div><p class="eyebrow">01 // METODOLOGIA</p><h2>CO DOKLADNIE ZMIERZONO</h2><p>Trasa <code>GET /hello</code> zwracajaca <code>Hello, World!</code>. 64 polaczenia keep-alive, 200 000 requestow, 10 000 warmup. Serwer przypiety do rdzeni 0-1, load generator do 2-5 przez <code>taskset</code>.</p><p>FastAPI: uvicorn 0.54 z dwoma workerami na tych samych dwoch rdzeniach. To porownanie runtime'ow na jednej maszynie, nie ranking absolutny.</p></div><div><p class="eyebrow">02 // REPRODUKCJA</p><h2>URUCHOM TO SAM</h2><pre><code>bash bench/run.sh</code></pre><p>Wyniki i warianty sa w <code>bench/RESULTS.md</code>. Walidacja nie jest czescia tego pomiaru - <code>ApiJson</code> doklada deserializacje i prace <code>validator</code>, zalezna od modelu i payloadu.</p></div></section><section class="bench"><p class="eyebrow">03 // STREAMING</p><h2>NIE TYLKO REQ/S. TAKZE BANDWIDTH.</h2><p>Osobny benchmark wysyla 64 MiB na strumien w chunkach po 64 KiB. Klient liczy ramki body bez buforowania calosci, wiec mierzy transfer, nie alokacje.</p><div class="stats"><div class="stat"><strong>4.7 GiB/s</strong><span>RUSTWEB LOOPBACK</span></div><div class="stat"><strong>39 Gbit/s</strong><span>RUSTWEB PEAK</span></div><div class="stat"><strong>4.1-4.7</strong><span>GIB/S ZAKRES</span></div></div><table><thead><tr><th>SERWER</th><th>MIB/S</th><th>GBIT/S</th></tr></thead><tbody><tr><td>RustWeb</td><td>4 536-4 672</td><td>38.05-39.19</td></tr><tr><td>plain axum</td><td>4 121-4 692</td><td>34.57-39.36</td></tr></tbody></table><p class="note">To loopback na jednej maszynie, nie realne lacze. Szczegoly i komenda: <code>bash bench/streaming.sh</code>.</p></section><section class="bench"><p class="eyebrow">04 // WNIOSEK</p><h2>NIE NAJSZYBSZY NA SWIECIE. PO PROSTU BEZ NARZUTU.</h2><p>RustWeb nie probuje pobic axum wlasnym routerem. Bierze sprawdzony stos i doklada makra, walidacje oraz OpenAPI. Dlatego na trasie bez walidacji zostaje tyle samo pracy co w czystym axum.</p><p class="note">To jest cel: FastAPI-owe DX bez FastAPI-owego kosztu. Nie TechEmpower, nie benchmark marketingowy.</p><div class="actions"> <a class="button gold" href="/rustweb/about">POZNAJ MHTML</a> <a class="button ghost" href="/rustweb/">WROC NA START</a> </div></section></template>
<template data-rweb-route="/viewer" data-rweb-title="RWeb Viewer - RustWeb"><section class="hero"><div class="hero-copy"><p class="eyebrow">RWEB VIEWER // LOCAL ONLY</p><h1>WGLAD<br><span>W .RWEB.</span></h1><p class="lead">Wrzuc plik <code>.rweb</code> albo zaladuj biezaca strone. Viewer pokaze trasy, protokol, APP UUID, rozmiar, gzip i podglad w sandboxie.</p><div class="actions"> <label class="button" for="rweb-file">WYBIERZ .RWEB</label> <button class="button ghost" id="load-current" type="button">ZALADUJ TA STRONE</button> <a class="button gold" href="/rustweb/site.rweb" download>POBIERZ .RWEB</a> </div> <input id="rweb-file" type="file" accept=".rweb,text/html" hidden> <p class="note">Plik nie jest wysylany na serwer. Parsowanie i preview dzieja sie w przegladarce.</p></div><div class="hero-art" aria-hidden="true"><div class="spec-board"><div class="spec-cell"><strong id="viewer-bytes">--</strong><span>ROZMIAR</span></div><div class="spec-cell"><strong id="viewer-routes">--</strong><span>TRASY</span></div><div class="spec-cell"><strong id="viewer-gzip">--</strong><span>GZIP</span></div><div class="spec-cell"><strong id="viewer-ascii">--</strong><span>ASCII</span></div></div><div class="art-tag">SANDBOX<br><strong>PREVIEW</strong></div></div></section><section class="split"><div><p class="eyebrow">01 // METADANE</p><h2>CO JEST W SRODKU</h2><div id="viewer-meta" class="note">Zaladuj plik .rweb albo biezaca strone.</div><p>Viewer czyta meta tagi, <code>byrust-config</code>, trasy z <code>&lt;template&gt;</code> i liczy rozmiar oraz gzip w przegladarce.</p><div id="viewer-drop" class="drop-zone">PRZECIAGNIJ .RWEB TUTAJ</div></div><pre><code id="viewer-code">// .rweb source</code></pre></section><section class="bench"><p class="eyebrow">02 // PREVIEW</p><h2>SANDBOX</h2><p>Iframe ma <code>sandbox="allow-scripts"</code>, wiec podglad nie dostaje dostepu do rodzica ani do danych strony.</p><iframe id="viewer-preview" class="viewer-frame" sandbox="allow-scripts" title="RWeb preview"></iframe></section></template>
<template data-rweb-route="/cert" data-rweb-title="Certification Database - RustWeb"><section class="hero"><div class="hero-copy"><p class="eyebrow">CERTIFICATION DB // PUBLIC</p><h1>CERTYFIKATY<br><span>W JEDNYM MIEJSCU.</span></h1><p class="lead">Zarejestruj aplikacje, opublikuj publiczny identyfikator i fingerprint. Klucz dostepu pokazuje sie raz i nie jest nigdzie zapisywany.</p><div class="badges"> <span class="badge">PUBLIC REGISTRY</span> <span class="badge">APP ID</span> <span class="badge">FINGERPRINT</span> <span class="badge">ONE-TIME KEY</span> </div></div><div class="hero-art" aria-hidden="true"><div class="spec-board"><div class="spec-cell"><strong id="cert-count">0</strong><span>PUBLIC ENTRIES</span></div><div class="spec-cell"><strong>2</strong><span>LIMIT APLIKACJI</span></div><div class="spec-cell"><strong>APP</strong><span>PUBLIC ID</span></div><div class="spec-cell"><strong>FP</strong><span>FINGERPRINT</span></div></div><div class="art-tag">ONE-TIME<br><strong>KEY</strong></div></div></section><section class="split"><div><p class="eyebrow">01 // REGISTER</p><h2>ZAREJESTRUJ APLIKACJE</h2><form id="cert-register-form" class="cert-form"> <label class="cert-field">APP NAME<input id="cert-app-name" required maxlength="64" placeholder="RustWeb"></label> <label class="cert-field">UUID (BLANK = GENERATE)<input id="cert-app-uuid" placeholder="xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"></label> <button class="button" type="submit">ZAREJESTRUJ APLIKACJE</button> </form><div id="cert-register-error" class="note">Puste pole generuje nowy identyfikator. Klucz dostepu pokaze sie tylko raz.</div></div><div><p class="eyebrow">02 // ONE-TIME KEY</p><h2>KLUCZ DOSTEPU</h2> <textarea id="cert-password" class="cert-secret" readonly placeholder="Pojawi sie po rejestracji"></textarea> <div id="cert-output" hidden><div class="actions"> <button id="cert-copy-password" class="badge" type="button">KOPIUJ KLUCZ</button> <button id="cert-copy-entry" class="badge" type="button">KOPIUJ ENTRY</button> <button id="cert-download-entry" class="badge" type="button">POBIERZ ENTRY</button> <button id="cert-check-now" class="badge" type="button">WSTAW ENTRY</button> </div><pre><code id="cert-entry"></code></pre></div></div></section><section class="split"><div><p class="eyebrow">03 // CHECKER</p><h2>SPRAWDZ CERTYFIKAT</h2> <textarea id="cert-check-entry" class="cert-secret" placeholder="Wklej publiczny entry..."></textarea> <input id="cert-check-password" class="cert-secret" type="password" autocomplete="off" placeholder="Klucz dostepu"> <div class="actions"> <button id="cert-check-button" class="button" type="button">SPRAWDZ</button> </div><div id="cert-result" class="note">Wynik pojawi sie tutaj.</div></div><div><p class="eyebrow">04 // DATABASE</p><h2>PUBLICZNE WPISY</h2><div id="cert-api-status" class="note">LACZENIE Z REJESTREM PUBLICZNYM...</div><div id="cert-db" class="cert-list"></div><div class="actions"> <button id="cert-export" class="badge" type="button">EKSPORT LOKALNYCH</button> </div></div></section><section class="bench"><p class="eyebrow">05 // SECURITY</p><h2>CO JEST PUBLICZNE</h2><p>Baza pokazuje publiczny app ID, fingerprint i zabezpieczony wpis. Prywatne dane nie sa publikowane.</p><p class="note">Publiczny rejestr: odczyt i zapis przez API. Limit 2 aplikacje na uzytkownika. Gdy rejestr jest niedostepny, wpis zostaje lokalnie i nie jest publiczny. Utrata klucza = brak recovery.</p></section> <textarea id="cert-seed" hidden data-registry-url="https://cupqcdjwhwhqiwqpamft.supabase.co" data-registry-key="sb_publishable_1P--g-axixiM9pH4RQQhww_1LgV6TJq">[{"app":"RustWeb Site","app_id":"9f1c2d3e-4b5a-4c6d-8e7f-0123456789ab","ciphertext":"","created":"2026-11-01T15:23:11.552Z","iterations":210000,"iv":"7dpYhA6ArOR8La8n","key_fingerprint":"386bb8a5a62f36a83e32251772abe302039a69d548324fd4b312fb9643ddcb2d","public_key":"MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEChLGPBfkOCiU4siP1xd+WsaiVqRoTJh2jgFlN+aK0+XgLShzvy1rkzHtAFAY09Z0qiogMtPzCliUepe8NCYV2g==","salt":"AK259VMdkRCpDuyOqr37PA==","status":"SEALED","uuid_commitment":"c7e55ee139ab6d5de486e3e7b0277e6652eedf88991e1435c814178ecffba330","version":1}]</textarea> </template>
<template data-rweb-route="/game" data-rweb-title="Game Lab - RustWeb"><section class="game-page"><div class="game-head"><div><p class="eyebrow">06 // GAME LAB // PACKET SYSTEMS</p><h1>PACKET<br><span>ARENA.</span></h1><p class="lead">Mini gra do testu systemow pakietowych. Kazdy pakiet ma maksymalnie 4096 B, a kazdy kanal jest funkcja z mozliwoscia nadpisania pakietu.</p></div><div class="badges"> <span class="badge">MAX 4096 B</span> <span class="badge">9 SYSTEMOW</span> <span class="badge">LOG NA ZYWO</span> <span class="badge">UDP/TCPS TEST</span> </div></div><div class="game-shell"><div class="game-stage"><canvas id="game-canvas" class="game-canvas" width="960" height="540" tabindex="0"></canvas><div class="game-toolbar"> <button id="game-start" class="button" type="button">START / PAUSE</button> <button id="game-reset" class="badge" type="button">RESET</button> <button id="game-clear" class="badge" type="button">CZYSC LOG</button> <button id="game-ping" class="badge" type="button">PING</button> <button id="game-sync" class="badge" type="button">SYNC</button> <button id="game-emote" class="badge" type="button">EMOTE</button> <button id="game-trade" class="badge" type="button">TRADE</button> <button id="game-test-4k" class="badge" type="button">TEST 4 KB</button> <button id="game-test-over" class="badge" type="button">TEST &gt; 4 KB</button> </div></div><aside class="game-side"><div class="spec-board game-stats"><div class="spec-cell"><strong id="game-status">PAUSED</strong><span>STATUS</span></div><div class="spec-cell"><strong id="game-packets">0 / 0</strong><span>OUT / IN</span></div><div class="spec-cell"><strong id="game-bytes">0 B</strong><span>BANDWIDTH</span></div><div class="spec-cell"><strong id="game-oversize">0</strong><span>OVERSIZE</span></div><div class="spec-cell"><strong id="game-packet-types">0</strong><span>PAKETY</span></div><div class="spec-cell"><strong id="game-max-packet">4096 B</strong><span>LIMIT</span></div></div><div><p class="eyebrow">SYSTEMY</p><div id="game-systems" class="game-systems"></div></div><form id="game-chat-form" class="game-chat"> <input id="game-chat-input" maxlength="180" placeholder="Napisz na /game_chat..." autocomplete="off"> <button class="badge" type="submit">WYSLIJ</button> </form></aside></div><div class="game-bottom"><section><p class="eyebrow">LOG PAKIETOW</p><div id="game-log" class="game-log"></div></section><section><p class="eyebrow">OSTATNI PAKIET</p><pre><code id="game-packet">// brak pakietu</code></pre><p class="note">WASD / strzalki = move. LPM = left_click. PPM = right_click. Mysz = look. Chat = /game_chat.</p></section></div></section></template>
<template data-rweb-route="/deploy" data-rweb-title="Deploy - RustWeb"><section class="deploy-hero"><p class="eyebrow">07 // DEPLOY // SELF HOST</p><h1>POSTAW TO<br><span>U SIEBIE.</span></h1><p class="lead">Jeden plik `.rweb`, jeden binarny serwer i zero runtime templatingu. Od `docker compose up` do wlasnego VPS albo GitHub Pages - bez klejenia pieciu frameworkow.</p><div class="actions"> <a class="button" href="#deploy-docker">DOCKER</a> <a class="button ghost" href="#deploy-local">LOKALNIE</a> <a class="button gold" href="https://github.com/gabeczkag/rustweb" target="_blank" rel="noreferrer">GITHUB</a> </div><div class="badges"> <span class="badge">1 BINARKA</span> <span class="badge">1 PLIK .RWEB</span> <span class="badge">DOCKER READY</span> <span class="badge">BEZ BAZY DLA STRONY</span> </div></section><section class="stats"><div class="stat"><strong>1</strong><span>PLIK STRONY</span></div><div class="stat"><strong>0</strong><span>RUNTIME TEMPLATING</span></div><div class="stat"><strong>56</strong><span>TESTOW W REPO</span></div></section><section class="deploy-grid"><article class="deploy-card"><p class="eyebrow">01 // DOCKER</p><h2>NAJSZYBSZY START</h2><p>Zbuduj obraz i uruchom strone oraz uslugi TCPs i UC. W produkcji postaw to za Caddy, Traefik albo Nginx z TLS.</p><div class="code-block"> <button class="copy-button" data-copy="#deploy-docker" type="button">KOPIUJ</button> <pre><code id="deploy-docker">git clone https://github.com/gabeczkag/rustweb.git
cd rustweb
docker compose up --build
# strona:  http://127.0.0.1:3000
# tcps:    http://127.0.0.1:4100  (UDP 4101)
# uc:      http://127.0.0.1:4200
# zmien token w tcps/tcps.container.json</code></pre></div></article><article class="deploy-card"><p class="eyebrow">02 // LOCAL HTTPS</p><h2>BYRUST + LOCAL CA</h2><p>Jeden skrypt buduje `.rweb` i uruchamia RustWeb po HTTPS. Pierwszy start tworzy lokalne CA i cert aplikacji.</p><div class="code-block"> <button class="copy-button" data-copy="#deploy-local" type="button">KOPIUJ</button> <pre><code id="deploy-local">./run.sh
# https://127.0.0.1:3000/
# zaufaj ~/.config/byrust/ca.crt</code></pre></div></article><article class="deploy-card"><p class="eyebrow">03 // VPS</p><h2>WLASNY SERWER</h2><p>Zbuduj release raz i uruchom binarke z prawdziwym certyfikatem Let's Encrypt. Bez Node, bez Pythona, bez runtime template engine.</p><div class="code-block"> <button class="copy-button" data-copy="#deploy-vps" type="button">KOPIUJ</button> <pre><code id="deploy-vps">cargo build --release -p rustweb
./target/release/rustweb site/site.rweb \
  --host 0.0.0.0 \
  --tls-cert /etc/letsencrypt/live/example/fullchain.pem \
  --tls-key /etc/letsencrypt/live/example/privkey.pem</code></pre></div></article><article class="deploy-card"><p class="eyebrow">04 // GITHUB PAGES</p><h2>STATICZNY DEPLOY</h2><p>Fork repo, wlacz Pages i pozwol workflow zbudowac `.rweb` oraz opublikowac go jako `index.html`, `404.html` i `site.rweb`.</p><div class="code-block"> <button class="copy-button" data-copy="#deploy-pages" type="button">KOPIUJ</button> <pre><code id="deploy-pages">git clone https://github.com/gabeczkag/rustweb.git
# GitHub -> Settings -> Pages -> Source: GitHub Actions
# push na main uruchamia build i deploy</code></pre></div></article></section><section class="split"><div><p class="eyebrow">05 // CO DOSTAJESZ</p><h2>NIE TYLKO STRONE.</h2><p>RustWeb to pakiet narzedzi, nie pojedynczy landing page. Strona, certyfikaty, transport plikow, kompresja pakietow i game lab sa w jednym repo.</p><div class="actions"> <a class="button" href="/rustweb/cert">CERT DB</a> <a class="button ghost" href="/rustweb/game">GAME LAB</a> <a class="button ghost" href="/rustweb/about">MHTML</a> </div></div><div class="service-table"><div class="service-row"><strong>rustweb</strong><span>strona + API + TLS</span><code>:3000</code></div><div class="service-row"><strong>tcps</strong><span>pliki per-user + UDP player</span><code>:4100 / :4101</code></div><div class="service-row"><strong>uc</strong><span>compression packs + zstd</span><code>:4200</code></div><div class="service-row"><strong>cert</strong><span>publiczny rejestr aplikacji</span><code>/cert</code></div><div class="service-row"><strong>game</strong><span>packet arena + logi</span><code>/game</code></div></div></section><section class="bench"><p class="eyebrow">06 // PRODUKCJA</p><h2>CO SPRAWDZIC PRZED STARTEM</h2><p>Ustaw TLS na reverse proxy, jesli kontener dziala po HTTP. Dla lokalnego HTTPS uzyj CA z `~/.config/byrust/ca.crt`. Nie publikuj `ca.key`, `app.key` ani sekretow z `tcps.json`.</p><p class="note">Docker domyslnie wystawia HTTP na porcie 3000. To celowe: TLS powinien konczyc Caddy, Traefik albo Nginx, a nie kontener aplikacji.</p><div class="actions"> <a class="button" href="/rustweb/">WROC NA START</a> <a class="button ghost" href="/rustweb/bench">ZOBACZ BENCHMARK</a> </div></section></template>
<template data-rweb-route="/baner" data-rweb-title="Banner Engine - RustWeb"><section class="baner-page"><div class="baner-stage" id="baner-stage"><div class="baner-grid" aria-hidden="true"></div><div class="baner-orb orb-a" aria-hidden="true"></div><div class="baner-orb orb-b" aria-hidden="true"></div><div class="baner-orb orb-c" aria-hidden="true"></div><div class="baner-copy"><p class="eyebrow">RUSTWEB // BANNER ENGINE // 500 MS</p><h1>JEDEN PLIK.<br><span>CALA STRONA.</span></h1><p class="lead">API, frontend, certyfikaty, transport plikow i compression packi w jednym repo. Bez runtime templatingu. Bez pieciu frameworkow. Bez wymowek.</p><div class="actions"> <a class="button" href="/rustweb/deploy">POSTAW U SIEBIE</a> <a class="button ghost" href="/rustweb/market">ZOBACZ MARKET</a> </div><div class="baner-controls"> <button id="baner-pause" class="badge" type="button">PAUZA</button> <button id="baner-prev" class="badge" type="button" aria-label="Poprzedni proof">?</button> <button id="baner-next" class="badge" type="button" aria-label="Nastepny proof">?</button> <span id="baner-index" class="baner-index">01 / 06</span> <span class="baner-live"><i></i> AUTO 500 MS</span> </div></div><aside class="baner-proof" id="baner-proof" data-accent="sky"><div class="baner-proof-top"> <span class="badge">PROOF</span> <span id="baner-proof-tag">SPEED</span> </div> <strong id="baner-proof-value">210 750</strong> <span id="baner-proof-label">REQ/S</span> <p id="baner-proof-body">Ten sam stos axum. Bez warstwy frameworka w hot path.</p> <a id="baner-proof-link" class="baner-proof-link" href="/rustweb/bench">SPRAWDZ BENCHMARK</a> <div class="baner-progress"><span id="baner-progress"></span></div> <span class="baner-proof-note">Pauza na hover. Reduced motion respektowane.</span> </aside></div><div class="baner-ticker" aria-hidden="true"><div class="baner-track"> <span>SINGLE FILE</span><b>?</b><span>ZERO RUNTIME TEMPLATING</span><b>?</b><span>56 TESTS</span><b>?</b><span>DOCKER READY</span><b>?</b><span>4.7 GIB/S STREAMING</span><b>?</b><span>CERT DB</span><b>?</b><span>TCPs + UDP</span><b>?</b><span>UC PACKS</span><b>?</b> <span>SINGLE FILE</span><b>?</b><span>ZERO RUNTIME TEMPLATING</span><b>?</b><span>56 TESTS</span><b>?</b><span>DOCKER READY</span><b>?</b><span>4.7 GIB/S STREAMING</span><b>?</b><span>CERT DB</span><b>?</b><span>TCPs + UDP</span><b>?</b><span>UC PACKS</span><b>?</b> </div></div><section class="baner-strip"><article> <strong>112 KB</strong> <span>CALY FRONTEND</span> <p>Strona, style, skrypty i routing w jednym `.rweb`. Bez CDN, bez buildu w runtime.</p> <a href="/rustweb/viewer">OTWORZ VIEWER</a> </article><article> <strong>1 BINARKA</strong> <span>BEZ NODE I PYTHONA</span> <p>RustWeb serwuje statyczny plik i API. Docker, VPS albo lokalny HTTPS jednym poleceniem.</p> <a href="/rustweb/deploy">JAK WDROZYC</a> </article><article> <strong>56</strong> <span>TESTOW W REPO</span> <p>Routing, walidacja, MHTML, certyfikaty, TCPs, UC i benchmarki. Kazda usluga ma dowod.</p> <a href="https://github.com/gabeczkag/rustweb" target="_blank" rel="noreferrer">GITHUB</a> </article></section></section></template>
<template data-rweb-route="/market" data-rweb-title="Market - RustWeb"><section class="market-hero"><p class="eyebrow">RUSTWEB // MARKET // MODULES</p><h1>MODULY,<br><span>NIE OBIETNICE.</span></h1><p class="lead">Wybierz kawalek stacku, ktory naprawde istnieje w repo. Kazda karta ma dowod, test i komende startowa.</p><div class="market-live"> <span class="market-live-dot"></span> <span>FEATURED</span> <strong id="market-live">RUSTWEB CORE</strong> <button id="market-pause" class="badge" type="button">PAUZA</button> </div></section><div class="market-ticker" aria-hidden="true"><div class="market-track"> <span>CORE</span><b>?</b><span>MHTML</span><b>?</b><span>CERT DB</span><b>?</b><span>TCPs</span><b>?</b><span>UC</span><b>?</b><span>GAME LAB</span><b>?</b><span>VIEWER</span><b>?</b><span>DEPLOY</span><b>?</b><span>BENCH</span><b>?</b> <span>CORE</span><b>?</b><span>MHTML</span><b>?</b><span>CERT DB</span><b>?</b><span>TCPs</span><b>?</b><span>UC</span><b>?</b><span>GAME LAB</span><b>?</b><span>VIEWER</span><b>?</b><span>DEPLOY</span><b>?</b><span>BENCH</span><b>?</b> </div></div><div class="market-filters" role="group" aria-label="Filtruj moduly"> <button class="badge is-active" data-filter="all" type="button">WSZYSTKO</button> <button class="badge" data-filter="core" type="button">CORE</button> <button class="badge" data-filter="service" type="button">SERVICE</button> <button class="badge" data-filter="lab" type="button">LAB</button> <button class="badge" data-filter="ops" type="button">OPS</button> </div><section class="market-grid" id="market-grid"><article class="market-card is-featured" data-market-card data-tags="core" data-title="RUSTWEB CORE"><div class="market-card-top"><span class="badge">CORE</span><span>READY</span></div><h2>RUSTWEB</h2><p>Routing, walidacja 422, OpenAPI i Swagger bez runtime templatingu.</p> <strong>210 750 <small>REQ/S</small></strong> <a href="/rustweb/">OTWORZ</a> </article><article class="market-card" data-market-card data-tags="core" data-title="MHTML"><div class="market-card-top"><span class="badge">CORE</span><span>READY</span></div><h2>MHTML</h2><p>Mini-HTML, MCSS i MScript. Caly frontend w jednym pliku `.rweb`.</p> <strong>112 KB <small>FRONTEND</small></strong> <a href="/rustweb/about">POZNAJ</a> </article><article class="market-card" data-market-card data-tags="service" data-title="CERT DB"><div class="market-card-top"><span class="badge">SERVICE</span><span>READY</span></div><h2>CERT DB</h2><p>Publiczny rejestr aplikacji, fingerprinty i jednorazowe klucze.</p> <strong>0 <small>PLAINTEXT UUID</small></strong> <a href="/rustweb/cert">OTWORZ</a> </article><article class="market-card" data-market-card data-tags="service" data-title="TCPs"><div class="market-card-top"><span class="badge">SERVICE</span><span>READY</span></div><h2>TCPs</h2><p>Pliki per-user, manifest, sync brakow i sesje graczy po UDP.</p> <strong>2 <small>APLIKACJE / USER</small></strong> <a href="/rustweb/deploy">JAK POSTAWIC</a> </article><article class="market-card" data-market-card data-tags="service" data-title="UC PACKS"><div class="market-card-top"><span class="badge">SERVICE</span><span>READY</span></div><h2>UC</h2><p>Compression packi dla malych pakietow. Zstd, CRC32, limit 4 KB.</p> <strong>4 KB <small>PER PACKET</small></strong> <a href="/rustweb/deploy">JAK POSTAWIC</a> </article><article class="market-card" data-market-card data-tags="lab" data-title="GAME LAB"><div class="market-card-top"><span class="badge">LAB</span><span>LIVE</span></div><h2>GAME LAB</h2><p>Packet Arena z dziewiecioma systemami, logami i limitem 4096 B.</p> <strong>9 <small>SYSTEMOW</small></strong> <a href="/rustweb/game">ZAGRAJ</a> </article><article class="market-card" data-market-card data-tags="ops" data-title="VIEWER"><div class="market-card-top"><span class="badge">OPS</span><span>READY</span></div><h2>VIEWER</h2><p>Wrzuc `.rweb`, zobacz trasy, protokol, APP UUID, gzip i preview.</p> <strong>1 <small>PLIK</small></strong> <a href="/rustweb/viewer">OTWORZ</a> </article><article class="market-card" data-market-card data-tags="ops" data-title="DEPLOY"><div class="market-card-top"><span class="badge">OPS</span><span>READY</span></div><h2>DEPLOY</h2><p>Docker, lokalny HTTPS, VPS z Let's Encrypt albo GitHub Pages.</p> <strong>1 <small>KOMENDA</small></strong> <a href="/rustweb/deploy">WDROZ</a> </article><article class="market-card" data-market-card data-tags="lab" data-title="BENCH"><div class="market-card-top"><span class="badge">LAB</span><span>READY</span></div><h2>BENCH</h2><p>Request throughput, streaming bandwidth i porownanie z FastAPI.</p> <strong>4.7 <small>GIB/S</small></strong> <a href="/rustweb/bench">ZOBACZ</a> </article></section><section class="bench"><p class="eyebrow">MARKET // CTA</p><h2>BIERZ CALY STACK.</h2><p>Kazdy modul jest w tym samym repo i ma jedna komende startowa. Nie musisz kupowac siedmiu subskrypcji, zeby zlozyc jedna strone.</p><div class="actions"> <a class="button" href="/rustweb/deploy">POSTAW U SIEBIE</a> <a class="button ghost" href="/rustweb/baner">ZOBACZ BANER</a> </div></section></template>
