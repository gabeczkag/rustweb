<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="rweb-version" content="0.1.0">
<meta name="rweb-base" content="/rustweb">
<meta name="description" content="FastAPI-style web framework for Rust with MHTML single-file sites.">
<meta name="byrust" content="byrust">
<meta name="byrust-alias" content="byrust">
<script type="application/json" id="byrust-config">{"protocol":{"name":"byrust","version":1,"https":true,"alias":"byrust","alt_svc":null,"headers":{"X-Byrust-Site":"rustweb"}},"app":{"name":"RustWeb","uuid":"c5319283-50e1-5a0e-984e-97033f25f18e","trust":"app"}}</script>
<title>RustWeb - FastAPI dla Rusta</title>
<style>:root{--bg:#070b14;--bg-2:#0b1220;--panel:#0d1526;--panel-2:#111a2e;--ink:#f4f7ff;--muted:#a7b6cc;--line:#05070d;--sky:#7dd3fc;--green:#6ee7a0;--gold:#fbbf24;--pink:#f472b6;--red:#fb7185}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;color:var(--ink);background-color:var(--bg);background-image:linear-gradient(rgba(125,211,252,0.055) 1px,transparent 1px),linear-gradient(90deg,rgba(125,211,252,0.055) 1px,transparent 1px);background-size:32px 32px;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.65}::selection{background:var(--gold);color:var(--line)}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:3px solid var(--gold);outline-offset:3px}.topbar{position:sticky;top:12px;z-index:50;display:flex;align-items:center;gap:18px;width:min(1120px,calc(100% - 32px));margin:18px auto 0;padding:12px 16px;border:3px solid var(--line);background:var(--bg-2);box-shadow:7px 7px 0 var(--line)}.brand{display:inline-flex;align-items:center;gap:12px;flex:0 0 auto;font-family:"Arial Black","Segoe UI Black",Impact,sans-serif;font-size:18px;letter-spacing:0.04em}.brand-mark{display:grid;grid-template-columns:1fr 1fr;gap:2px;width:32px;height:32px;padding:2px;border:3px solid var(--line);background:var(--line);box-shadow:3px 3px 0 #02040a}.brand-mark b:nth-child(1){background:var(--sky)}.brand-mark b:nth-child(2){background:var(--green)}.brand-mark b:nth-child(3){background:var(--pink)}.brand-mark b:nth-child(4){background:var(--gold)}.hotbar{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto}.hotbar a{padding:8px 10px;border:2px solid var(--line);background:var(--panel-2);box-shadow:3px 3px 0 var(--line);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase}.hotbar a:hover,.hotbar a.active{background:var(--sky);color:var(--line)}.hotbar a:active{translate:2px 2px;box-shadow:1px 1px 0 var(--line)}.status{display:inline-flex;align-items:center;gap:8px;flex:0 0 auto;padding:8px 10px;border:2px solid var(--line);background:#0b2417;box-shadow:3px 3px 0 var(--line);color:var(--green);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:800;letter-spacing:0.1em}.status i{width:8px;height:8px;background:var(--green);box-shadow:0 0 10px var(--green);animation:blink 1.6s steps(2,end) infinite}main{width:min(1120px,calc(100% - 32px));margin:0 auto;padding:0 0 80px}.hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,0.85fr);gap:42px;align-items:center;padding:76px 0 64px}.eyebrow{display:inline-block;margin:0 0 22px;padding:6px 10px;border:3px solid var(--line);background:var(--gold);box-shadow:4px 4px 0 var(--line);color:var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:900;letter-spacing:0.14em;text-transform:uppercase}h1{margin:0 0 24px;font-family:"Arial Black","Segoe UI Black",Impact,sans-serif;font-size:clamp(42px,6.6vw,82px);line-height:0.94;letter-spacing:-0.045em;text-transform:uppercase;text-shadow:5px 5px 0 var(--line)}h1 span{color:var(--sky)}.lead{max-width:620px;margin:0;color:var(--muted);font-size:clamp(16px,1.8vw,19px);line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.button{display:inline-flex;align-items:center;justify-content:center;padding:13px 18px;border:3px solid var(--line);border-radius:0;background:var(--sky);box-shadow:6px 6px 0 var(--line);color:var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-weight:900;letter-spacing:0.07em;text-transform:uppercase;transition:translate 120ms ease,box-shadow 120ms ease}.button:hover{translate:-2px -2px;box-shadow:8px 8px 0 var(--line)}.button:active{translate:3px 3px;box-shadow:2px 2px 0 var(--line)}.button.ghost{background:var(--bg-2);color:var(--ink)}.button.gold{background:var(--gold)}.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.badge{padding:5px 8px;border:2px solid var(--line);background:var(--panel-2);box-shadow:3px 3px 0 var(--line);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:800;letter-spacing:0.06em;text-transform:uppercase}.hero-art{position:relative;min-height:430px;display:grid;place-items:center}.voxel-scene{position:relative;width:340px;height:380px;perspective:900px}.voxel{position:absolute;width:110px;height:110px;transform-style:preserve-3d;transform:rotateX(-22deg) rotateY(-38deg)}.voxel i{position:absolute;inset:0;display:block;border:4px solid var(--line)}.voxel .top{transform:rotateX(90deg) translateZ(55px)}.voxel .left{transform:rotateY(-90deg) translateZ(55px)}.voxel .right{transform:translateZ(55px)}.grass{left:108px;top:50px;animation:bob 5s ease-in-out infinite}.grass .top{background:var(--green)}.grass .left{background:#22c55e}.grass .right{background:#16a34a}.cube-letter{position:absolute;inset:0;display:grid;place-items:center;transform:translateZ(57px);color:var(--line);font-family:"Arial Black",Impact,sans-serif;font-size:56px;line-height:1;pointer-events:none}.dirt{left:126px;top:166px;animation:bob 6s ease-in-out -1s infinite}.dirt .top{background:#b07a4a}.dirt .left{background:#8a5a35}.dirt .right{background:#6f4629}.stone{left:92px;top:282px;animation:bob 7s ease-in-out -2s infinite}.stone .top{background:#a8b3c4}.stone .left{background:#7c8798}.stone .right{background:#5c6675}.gold{left:238px;top:18px;width:58px;height:58px;animation:bob 6s ease-in-out -3s infinite}.gold i{border-width:3px}.gold .top{transform:rotateX(90deg) translateZ(29px);background:var(--gold)}.gold .left{transform:rotateY(-90deg) translateZ(29px);background:#d99a06}.gold .right{transform:translateZ(29px);background:#b97f00}.voxel-scene::before,.voxel-scene::after{content:"";position:absolute;width:16px;height:16px;border:3px solid var(--line);box-shadow:3px 3px 0 var(--line);animation:bob 6s ease-in-out infinite}.voxel-scene::before{left:12px;top:76px;background:var(--pink)}.voxel-scene::after{right:12px;bottom:54px;background:var(--sky);animation-delay:-2s}.art-tag{position:absolute;right:10px;bottom:8px;padding:8px 10px;border:3px solid var(--line);background:var(--panel-2);box-shadow:4px 4px 0 var(--line);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;line-height:1.5;text-align:right;text-transform:uppercase}.spec-board{display:grid;grid-template-columns:1fr 1fr;gap:12px;width:100%;max-width:360px}.spec-cell{display:flex;flex-direction:column;justify-content:space-between;min-height:105px;padding:16px;border:3px solid var(--line);background:var(--panel);box-shadow:6px 6px 0 var(--line)}.spec-cell strong{color:var(--sky);font-family:"Arial Black",Impact,sans-serif;font-size:28px;line-height:1;letter-spacing:-0.04em}.spec-cell:nth-child(2) strong{color:var(--green)}.spec-cell:nth-child(3) strong{color:var(--gold)}.spec-cell:nth-child(4) strong{color:var(--pink)}.spec-cell span{color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:9px;font-weight:800;line-height:1.35;letter-spacing:0.08em;text-transform:uppercase}.art-tag strong{color:var(--sky);font-size:14px}.feature-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;padding:18px 0 20px}.card{position:relative;min-height:210px;padding:22px;border:3px solid var(--line);background:var(--panel);box-shadow:7px 7px 0 var(--line)}.card::before{content:"";position:absolute;inset:0 0 auto;height:7px;background:var(--sky)}.card:nth-child(2)::before{background:var(--green)}.card:nth-child(3)::before{background:var(--gold)}.card:nth-child(4)::before{background:var(--pink)}.card-icon{width:34px;height:34px;margin-bottom:16px;border:3px solid var(--line);background:linear-gradient(135deg,var(--sky) 0 48%,transparent 48% 52%,var(--line) 52% 100%);box-shadow:3px 3px 0 var(--line)}.card:nth-child(2) .card-icon{background:linear-gradient(135deg,var(--green) 0 48%,transparent 48% 52%,var(--line) 52% 100%)}.card:nth-child(3) .card-icon{background:linear-gradient(135deg,var(--gold) 0 48%,transparent 48% 52%,var(--line) 52% 100%)}.card:nth-child(4) .card-icon{background:linear-gradient(135deg,var(--pink) 0 48%,transparent 48% 52%,var(--line) 52% 100%)}.card h2{margin:0 0 8px;font-family:"Arial Black","Segoe UI Black",Impact,sans-serif;font-size:15px;line-height:1.15;letter-spacing:-0.01em;text-transform:uppercase}.card p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.6}.split{display:grid;grid-template-columns:1fr 1.08fr;gap:36px;align-items:center;padding:62px 0;border-top:3px solid #1e293b}.split h2,.bench h2{margin:0 0 12px;font-family:"Arial Black","Segoe UI Black",Impact,sans-serif;font-size:clamp(25px,3vw,38px);line-height:1;letter-spacing:-0.035em;text-transform:uppercase;text-shadow:3px 3px 0 var(--line)}.split p,.bench > p{margin:0 0 14px;color:var(--muted)}.note{margin:20px 0 0;padding:14px 16px;border:3px solid var(--line);border-left:8px solid var(--gold);background:#171204;box-shadow:5px 5px 0 var(--line);color:#fde68a;font-size:13px}pre{position:relative;margin:0;padding:40px 18px 18px;border:3px solid var(--line);background:#03050b;box-shadow:7px 7px 0 #1e293b;overflow:auto;font-size:12.5px;line-height:1.75}pre::before{content:"\25CF  \25CF  \25CF";position:absolute;inset:0 0 auto;padding:8px 12px;border-bottom:3px solid var(--line);background:var(--panel-2);color:var(--pink);font-size:10px;letter-spacing:0.18em}pre code{color:#c9d7ea;white-space:pre-wrap;overflow-wrap:anywhere}.bench{padding:62px 0;border-top:3px solid #1e293b}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin:26px 0}.stat{padding:18px;border:3px solid var(--line);background:var(--panel);box-shadow:6px 6px 0 var(--line)}.stat strong{display:block;color:var(--green);font-family:"Arial Black",Impact,sans-serif;font-size:clamp(25px,3vw,36px);line-height:1;letter-spacing:-0.04em}.stat:nth-child(2) strong{color:var(--gold)}.stat:nth-child(3) strong{color:var(--sky)}.stat span{display:block;margin-top:8px;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:800;letter-spacing:0.1em;text-transform:uppercase}table{width:100%;margin-top:26px;border:3px solid var(--line);border-collapse:separate;border-spacing:0;background:var(--panel);box-shadow:7px 7px 0 var(--line);font-size:13px}th,td{padding:14px 12px;text-align:left;vertical-align:top;border-bottom:2px solid #1e293b}th{background:var(--panel-2);color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10px;font-weight:900;letter-spacing:0.12em;text-transform:uppercase}tr:last-child td{border-bottom:0}td:first-child{min-width:210px;font-weight:800}.bar{height:10px;margin-top:8px;border:2px solid var(--line);background:var(--line)}.bar span{display:block;width:var(--bar);height:100%;background:repeating-linear-gradient(90deg,var(--green) 0 9px,var(--line) 9px 12px)}tr:nth-child(3) .bar span{background:repeating-linear-gradient(90deg,var(--red) 0 9px,var(--line) 9px 12px)}.footer{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;width:min(1120px,calc(100% - 32px));margin:0 auto;padding:20px 0 42px;border-top:3px solid #1e293b;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;letter-spacing:0.04em}.footer-links{display:flex;gap:12px}.footer a:hover{color:var(--sky)}.byrust-warning{position:sticky;top:0;z-index:9999;padding:10px 16px;background:#7f1d1d;color:#fff;font:800 13px/1.4 ui-monospace,monospace;text-align:center}@keyframes bob{50%{translate:0 -12px}}@keyframes blink{50%{opacity:0.25}}@media (max-width:980px){.hero{grid-template-columns:1fr;padding-top:52px}.hero-art{min-height:360px;order:2}.feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.split{grid-template-columns:1fr;gap:24px}.stats{grid-template-columns:1fr}.topbar{flex-wrap:wrap;gap:10px}.hotbar{order:3;margin-left:0}.status{margin-left:auto}}@media (max-width:620px){.feature-grid{grid-template-columns:1fr}.hotbar a{padding:7px 8px;font-size:10px}.voxel-scene{scale:0.86}.brand{font-size:16px}table{display:block;overflow-x:auto;white-space:nowrap}}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none !important;transition:none !important}}.byrust-warning{position:sticky;top:0;z-index:9999;padding:10px 16px;background:#7f1d1d;color:#fff;font:600 13px/1.4 system-ui,sans-serif;text-align:center}</style>
</head>
<body>
<div class="topbar"> <a class="brand" href="/rustweb/" aria-label="RustWeb"> <span class="brand-mark" aria-hidden="true"><b></b><b></b><b></b><b></b></span> <span>RUSTWEB</span> </a> <nav class="hotbar" aria-label="Glowne"> <a href="/rustweb/" data-nav="home">01 START</a> <a href="/rustweb/about" data-nav="about">02 MHTML</a> <a href="/rustweb/bench" data-nav="bench">03 BENCH</a> </nav> <span class="status"><i></i> BYRUST/1</span> </div><main id="rweb-app"></main><footer class="footer"> <span>RUSTWEB 0.1.0 // MHTML + .RWEB // <span id="year"></span></span> <span class="footer-links"><a href="/rustweb/">START</a><a href="/rustweb/about">MHTML</a><a href="/rustweb/bench">BENCH</a></span> </footer>
<noscript>MHTML needs JavaScript.</noscript>
<template data-rweb-route="/" data-rweb-title="RustWeb - FastAPI dla Rusta"><section class="hero"><div class="hero-copy"><p class="eyebrow">RUST // FASTAPI DX // ONE FILE</p><h1>API W RUSTCIE.<br><span>JAK W FASTAPI.</span></h1><p class="lead">Deklarujesz typy wejscia i wyjscia. RustWeb daje walidacje, bledy 422 w ksztalcie FastAPI, OpenAPI i Swagger UI. Bez warstwy posredniej w hot path.</p><div class="actions"> <a class="button" href="/rustweb/bench">ZOBACZ BENCHMARK</a> <a class="button ghost" href="/rustweb/about">JAK DZIALA MHTML</a> </div><div class="badges"> <span class="badge">1 PLIK .RWEB</span> <span class="badge">0 RUNTIME TEMPLATING</span> <span class="badge">30 KB</span> <span class="badge">ASCII ONLY</span> </div></div><div class="hero-art" aria-hidden="true"><div class="voxel-scene"><div class="voxel grass"> <i class="top"></i><i class="left"></i><i class="right"></i> <span class="cube-letter">R</span> </div><div class="voxel dirt"> <i class="top"></i><i class="left"></i><i class="right"></i> </div><div class="voxel stone"> <i class="top"></i><i class="left"></i><i class="right"></i> </div><div class="voxel gold"> <i class="top"></i><i class="left"></i><i class="right"></i> </div></div><div class="art-tag">SINGLE FILE<br><strong>.RWEB</strong></div></div></section><section class="feature-grid"> <article class="card"><div class="card-icon"></div><h2>Makra zamiast boilerplate'u</h2><p>#[get], #[post] i #[model] zamieniaja sygnatury funkcji w routing, walidacje i schematy OpenAPI. Rozwijaja sie w czasie kompilacji.</p></article><article class="card"><div class="card-icon"></div><h2>Bledy, ktorych nie trzeba mapowac</h2><p>ApiJson, ApiPath i ApiQuery zwracaja 422 z detail[]{type, loc, msg, ctx}. Ksztalt znany z FastAPI, bez recznego klejenia JSON-a.</p></article><article class="card"><div class="card-icon"></div><h2>MHTML zamiast szablonow</h2><p>Mini-HTML z interpolacja, @if i @for. Kompilator rweb sklada strony, CSS, TypeScript i assety w jeden plik .rweb.</p></article><article class="card"><div class="card-icon"></div><h2>Zero narzutu w hot path</h2><p>Cienka warstwa nad axum. Benchmark na tej samej maszynie: 210 750 req/s dla RustWeb i 208 173 req/s dla czystego axum.</p></article> </section><section class="split"><div><p class="eyebrow">01 // DX</p><h2>PISZ JAK W FASTAPI</h2><p>Makro rozwija sie w czasie kompilacji, wiec routing i dokumentacja nie kosztuja nic w czasie zadania. Walidacja jest jedyna dodatkowa praca i dzieje sie tylko wtedy, gdy jej uzyjesz.</p><p class="note">Makro rozwija sie w czasie kompilacji. Routing, walidacja i OpenAPI nie dodaja warstwy w request path.</p></div><pre><code>#[rustweb::get("/users/{id}")]
async fn get_user(ApiPath(id): ApiPath&lt;u64&gt;) -&gt; ApiResult&lt;Json&lt;User&gt;&gt; {
    Ok(Json(User { id, name: "Ada".into(), age: 36 }))
}</code></pre></section><section class="bench"><p class="eyebrow">02 // POMIAR</p><h2>RUSTWEB VS AXUM VS FASTAPI</h2><p>Ten sam komputer, ta sama trasa /hello, ten sam load generator: 64 polaczenia keep-alive, 200 000 requestow, serwer przypiety do 2 rdzeni. FastAPI to uvicorn z 2 workerami.</p><div class="stats"><div class="stat"><strong>210 750</strong><span>REQ/S RUSTWEB</span></div><div class="stat"><strong>0.70 ms</strong><span>P99 RUSTWEB</span></div><div class="stat"><strong>6.6 MB</strong><span>RSS SERWERA .RWEB</span></div></div><table><thead><tr><th>SERWER</th><th>THROUGHPUT</th><th>P99</th></tr></thead><tbody> <tr><td> RustWeb <div class="bar"><span style="--bar: 100%"></span></div></td><td>210 750 req/s</td><td>0.70 ms</td></tr><tr><td> plain axum <div class="bar"><span style="--bar: 99%"></span></div></td><td>208 173 req/s</td><td>0.74 ms</td></tr><tr><td> FastAPI + uvicorn <div class="bar"><span style="--bar: 7%"></span></div></td><td>13.8-14.3k req/s</td><td>4.5-5.0 ms</td></tr> </tbody></table><p class="note">RustWeb i axum sa w granicach szumu. FastAPI placi za Pythona i runtime Pydantic, nie za sam ksztalt API.</p></section><section class="split"><div><p class="eyebrow">03 // MHTML -> .RWEB</p><h2>JEDEN PLIK. ZERO ZALEZNOSCI.</h2><p>Strony piszesz w MHTML. Komenda <code>rweb build site</code> renderuje HTML, inline'uje CSS, transpiluje TypeScript i pakuje wszystko w jeden plik.</p><p>linker.json wskazuje strony, style, skrypty i assety. Kompilator renderuje MHTML, inline'uje CSS, transpiluje TypeScript i zamienia obrazy na data URI. Wynik to jeden plik .rweb.</p><div class="actions"> <a class="button gold" href="/rustweb/about">POZNAJ MHTML</a> </div></div><pre><code>&lt;h1&gt;{{ title }}&lt;/h1&gt;
@if show_badge {
  &lt;span class="badge"&gt;{{ version }}&lt;/span&gt;
}
@for feature in features {
  &lt;article&gt;{{ feature.title }}&lt;/article&gt;
}</code></pre></section></template>
<template data-rweb-route="/about" data-rweb-title="MHTML i .rweb - RustWeb"><section class="hero"><div class="hero-copy"><p class="eyebrow">MHTML // MINI-HTML // ONE FILE</p><h1>HTML.<br><span>ALE W BLOKACH.</span></h1><p class="lead">MHTML to mini-HTML: znaczniki, interpolacja i dwie dyrektywy. Kompilator <code>rweb</code> sklada strony, CSS, TypeScript i assety w jeden <code>.rweb</code>, ktory uruchamia RustWeb.</p><div class="actions"> <a class="button" href="/rustweb/bench">ZOBACZ WYNIKI</a> <a class="button ghost" href="/rustweb/">WROC NA START</a> </div><div class="badges"> <span class="badge">MHTML</span> <span class="badge">LINKER.JSON</span> <span class="badge">TSC</span> <span class="badge">ASCII</span> </div></div><div class="hero-art" aria-hidden="true"><div class="spec-board"><div class="spec-cell"><strong>3</strong><span>STRONY W JEDNYM PLIKU</span></div><div class="spec-cell"><strong>1</strong><span>PLIK .RWEB</span></div><div class="spec-cell"><strong>0</strong><span>RUNTIME TEMPLATING</span></div><div class="spec-cell"><strong>30 KB</strong><span>WAGA PLIKU .RWEB</span></div></div><div class="art-tag">BUILD<br><strong>RWEB</strong></div></div></section><section class="feature-grid"><article class="card"><div class="card-icon"></div><h2>{{ expression }}</h2><p>Wartosci pochodza z JSON-a w <code>linker.json</code> i sa escapowane w tekscie oraz atrybutach. Dane uzytkownika nie wstrzykna HTML-a.</p></article><article class="card"><div class="card-icon"></div><h2>&#64;if i &#64;for</h2><p>Warunki i petle dzialaja na danych projektu. W petli masz <code>loop.index</code>, <code>loop.first</code> i <code>loop.last</code>.</p></article><article class="card"><div class="card-icon"></div><h2>linker.json</h2><p>Jeden manifest wskazuje strony, style, skrypty i assety. Wszystkie sciezki sa rozwiazywane wzgledem pliku manifestu.</p></article><article class="card"><div class="card-icon"></div><h2>ZERO RUNTIME</h2><p>Strony sa renderowane przy budowaniu. RustWeb serwuje gotowy HTML, wiec request nie placi za parser ani evaluator.</p></article></section><section class="split"><div><p class="eyebrow">01 // SKLADNIA</p><h2>MALY JEZYK, KTORY WYSTARCZA</h2><p>Bez wbudowanego JavaScriptu i setek helperow. HTML, interpolacja, <code>&#64;if</code>, <code>&#64;else</code> i <code>&#64;for</code>.</p><p class="note">Literalny szablon jest zaufany; escapowane sa tylko wartosci interpolowane. Mozesz pisac encje HTML i wlasne znaczniki bez podwojnego escapowania.</p></div><pre><code>&lt;h1&gt;{{ title }}&lt;/h1&gt;
@if show_badge {
  &lt;span class="badge"&gt;{{ version }}&lt;/span&gt;
}
@for feature in features {
  &lt;article&gt;{{ feature.title }}&lt;/article&gt;
}</code></pre></section><section class="split"><div><p class="eyebrow">02 // KOMPILACJA</p><h2>JEDEN PLIK .RWEB</h2><p><code>linker.json</code> opisuje strony i zasoby. Kompilator renderuje MHTML, inline'uje CSS, transpiluje TypeScript przez <code>tsc</code> i zamienia obrazy na data URI.</p><p>Build: <code>rweb build site</code>. Podglad: <code>rweb inspect site/site.rweb</code>. Uruchomienie: <code>rustweb site/site.rweb</code>.</p><p class="note">Strony moga byc <code>.mhtml</code> albo zwyklym <code>.html</code>; pelny dokument jest redukowany do <code>&lt;body&gt;</code>.</p></div><pre><code>{ "site": { "title": "RustWeb", "version": "0.1.0" }, "app": { "name": "RustWeb", "uuid": "..." }, "frame": "frame.mhtml", "base": "/rustweb", "ascii": true, "styles": ["assets/style.css"], "scripts": ["scripts/app.ts"], "pages": [ { "route": "/", "file": "pages/index.mhtml" } ] }</code></pre></section><section class="bench"><p class="eyebrow">03 // BYRUST</p><h2>HTTPS, KTORE MOWI WICEJ</h2><p><code>linker.json</code> ustawia <code>protocol.name = "byrust"</code>, wersje, wymog HTTPS, alias i wlasne naglowki. Kompilator wpisuje je do <code>.rweb</code> jako meta i <code>byrust-config</code>.</p><div class="stats"><div class="stat"><strong>v1</strong><span>PROTOCOL BYRUST</span></div><div class="stat"><strong>RustWeb</strong><span>APP // c5319283-50e1-5a0e-984e-97033f25f18e</span></div><div class="stat"><strong>LOCAL CA</strong><span>NO SELF-SIGNED LEAF</span></div></div><p>Puste <code>app.uuid</code> generuje stabilny UUID, a <code>"universal"</code> oznacza niskie zaufanie. Universal UUID dostaje certyfikat z osobnego, celowo niezaufanego CA: przegladarka ostrzega, a strona pokazuje czerwony banner <strong>Page is not safe</strong>.</p><p class="note">Przegladarka nadal widzi <code>https://</code> - tylko TLS z zaufanym certyfikatem daje bezpieczny kontekst. <code>byrust://</code> jest aliasem routera, a <code>web+byrust</code> moze byc handlerem przegladarki.</p><pre><code>"protocol": {
  "name": "byrust",
  "version": 1,
  "https": true,
  "alias": "byrust"
}</code></pre></section><section class="bench"><p class="eyebrow">04 // HOSTING</p><h2>JEDEN PLIK, MNIEJ RAM-U</h2><p>Pomiar RSS po starcie, bez ruchu: ~6,6 MB dla rustweb i ~153 MB dla FastAPI + uvicorn z dwoma workerami. Jeden proces, jeden plik HTML, zero runtime'owego templatingu.</p><p class="note">GitHub Pages serwuje ten sam <code>.rweb</code> statycznie przez certyfikat GitHuba. Lokalny Byrust CA, klucze aplikacji i Universal CA zostaja poza repozytorium.</p><p>Sprobuj aliasu: <a href="byrust://self/bench">byrust://self/bench</a></p></section></template>
<template data-rweb-route="/bench" data-rweb-title="Benchmark - RustWeb"><section class="hero"><div class="hero-copy"><p class="eyebrow">BENCHMARK // NIE MARKETING</p><h1>ILE KOSZTUJE<br><span>WARSTWA FRAMEWORKA?</span></h1><p class="lead">Ten sam komputer, ta sama trasa /hello, ten sam load generator: 64 polaczenia keep-alive, 200 000 requestow, serwer przypiety do 2 rdzeni. FastAPI to uvicorn z 2 workerami.</p><div class="actions"> <a class="button" href="/rustweb/about">JAK DZIALA MHTML</a> <a class="button ghost" href="/rustweb/">WROC NA START</a> </div></div><div class="hero-art" aria-hidden="true"><div class="spec-board"><div class="spec-cell"><strong>210k</strong><span>RUSTWEB REQ/S</span></div><div class="spec-cell"><strong>208k</strong><span>AXUM REQ/S</span></div><div class="spec-cell"><strong>14k</strong><span>FASTAPI REQ/S</span></div><div class="spec-cell"><strong>6.6</strong><span>MB RSS SERWERA</span></div></div><div class="art-tag">P99<br><strong>0.70 MS</strong></div></div></section><section class="bench"><div class="stats"><div class="stat"><strong>210 750</strong><span>RUSTWEB REQ/S</span></div><div class="stat"><strong>0.70 ms</strong><span>RUSTWEB P99</span></div><div class="stat"><strong>6.6 MB</strong><span>RSS PO STARCIE</span></div></div><table><thead><tr><th>SERWER</th><th>THROUGHPUT</th><th>P99</th></tr></thead><tbody> <tr><td> RustWeb <div class="bar"><span style="--bar: 100%"></span></div></td><td>210 750 req/s</td><td>0.70 ms</td></tr><tr><td> plain axum <div class="bar"><span style="--bar: 99%"></span></div></td><td>208 173 req/s</td><td>0.74 ms</td></tr><tr><td> FastAPI + uvicorn <div class="bar"><span style="--bar: 7%"></span></div></td><td>13.8-14.3k req/s</td><td>4.5-5.0 ms</td></tr> </tbody></table><p class="note">RustWeb i axum mieszcza sie w granicach szumu: raz RustWeb jest o 1-2% szybszy, raz o 1% wolniejszy. FastAPI jest wolniejsze o rzad wielkosci, bo placi za Pythona i runtime Pydantic.</p></section><section class="split"><div><p class="eyebrow">01 // METODOLOGIA</p><h2>CO DOKLADNIE ZMIERZONO</h2><p>Trasa <code>GET /hello</code> zwracajaca <code>Hello, World!</code>. 64 polaczenia keep-alive, 200 000 requestow, 10 000 warmup. Serwer przypiety do rdzeni 0-1, load generator do 2-5 przez <code>taskset</code>.</p><p>FastAPI: uvicorn 0.54 z dwoma workerami na tych samych dwoch rdzeniach. To porownanie runtime'ow na jednej maszynie, nie ranking absolutny.</p></div><div><p class="eyebrow">02 // REPRODUKCJA</p><h2>URUCHOM TO SAM</h2><pre><code>bash bench/run.sh</code></pre><p>Wyniki i warianty sa w <code>bench/RESULTS.md</code>. Walidacja nie jest czescia tego pomiaru - <code>ApiJson</code> doklada deserializacje i prace <code>validator</code>, zalezna od modelu i payloadu.</p></div></section><section class="bench"><p class="eyebrow">03 // WNIOSEK</p><h2>NIE NAJSZYBSZY NA SWIECIE. PO PROSTU BEZ NARZUTU.</h2><p>RustWeb nie probuje pobic axum wlasnym routerem. Bierze sprawdzony stos i doklada makra, walidacje oraz OpenAPI. Dlatego na trasie bez walidacji zostaje tyle samo pracy co w czystym axum.</p><p class="note">To jest cel: FastAPI-owe DX bez FastAPI-owego kosztu. Nie TechEmpower, nie benchmark marketingowy.</p><div class="actions"> <a class="button gold" href="/rustweb/about">POZNAJ MHTML</a> <a class="button ghost" href="/rustweb/">WROC NA START</a> </div></section></template>
<script>"use strict";
const updateYear = () => {
    const year = document.getElementById("year");
    if (year) {
        year.textContent = String(new Date().getFullYear());
    }
};
document.addEventListener("rweb:rendered", updateYear);
updateYear();

</script>
<script>(()=>{const t=new Map;document.querySelectorAll('template[data-rweb-route]').forEach(e=>t.set(e.dataset.rwebRoute,e));const base=document.querySelector('meta[name="rweb-base"]')?.content||'',a=document.getElementById('rweb-app'),f=t.get('/'),n=e=>{if(!e)e='/';if(base&&e.startsWith(base))e=e.slice(base.length)||'/';return e==='/'?'/':e.replace(/\/+$/,'')||'/'};const has=!!document.querySelector('meta[name="byrust"]'),al=document.querySelector('meta[name="byrust-alias"]')?.content||'byrust',sc=`${al}:`,ws=`web+${al}:`;const render=p=>{const q=n(p||location.pathname),x=t.get(q)||f;if(!x||!a)return;a.replaceChildren(x.content.cloneNode(!0));document.title=x.dataset.rwebTitle||document.title;document.querySelectorAll('[data-nav]').forEach(n=>n.classList.toggle('active',n.getAttribute('href')===base+q));document.dispatchEvent(new CustomEvent('rweb:rendered',{detail:{path:q}}));scrollTo(0,0)};const parse=u=>{try{const p=new URL(u);if(p.protocol!==sc&&p.protocol!==ws)return null;if(p.hostname&&p.hostname!=='self'&&p.hostname!==location.hostname)return null;return p}catch{return null}};if(has){try{const e=new URLSearchParams(location.search).get(al),p=e?parse(e):null;if(p){const u=base+p.pathname+p.search+p.hash;history.replaceState({},'',u);render(p.pathname)}}catch{}if(navigator.registerProtocolHandler){try{navigator.registerProtocolHandler(ws.slice(0,-1),`${location.origin}${base||''}/?${encodeURIComponent(al)}=%s`)}catch{}}}document.addEventListener('click',e=>{if(e.defaultPrevented||e.button!==0||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;const c=e.target.closest('a');if(!c||c.target||c.hasAttribute('download'))return;const h=c.getAttribute('href')||'';if(has&&(h.startsWith(`${al}://`)||h.startsWith(`web+${al}://`))){const p=parse(h);if(p){e.preventDefault();history.pushState({},'',base+p.pathname+p.search+p.hash);render(p.pathname)}return}const u=new URL(c.href,location.href);if(u.origin!==location.origin||u.hash)return;const q=n(u.pathname);if(q.startsWith('/api/')||q.startsWith('/docs')||q==='/openapi.json')return;e.preventDefault();history.pushState({},'',u);render()});addEventListener('popstate',()=>render());render()})();</script>
</body>
</html>
