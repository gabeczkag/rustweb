<title>RustWeb - FastAPI dla Rusta</title>
<style>:root{--bg:#070b14;--bg-soft:#0b1120;--panel:rgba(255,255,255,0.035);--panel-strong:rgba(255,255,255,0.06);--text:#e8eef8;--muted:#8b9bb4;--accent:#7dd3fc;--accent-2:#f472b6;--line:rgba(148,163,184,0.16);--radius:18px;--max:1080px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-height:100vh;background:radial-gradient(900px 600px at 15% -10%,rgba(125,211,252,0.12),transparent 60%),radial-gradient(800px 500px at 85% 10%,rgba(244,114,182,0.1),transparent 60%),var(--bg);color:var(--text);font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased}::selection{background:rgba(125,211,252,0.35);color:#fff}a{color:inherit;text-decoration:none}a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:3px;border-radius:6px}img{display:block}code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:0.92em}.nav{width:min(var(--max),100%);margin:0 auto;padding:26px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:inline-flex;align-items:center;gap:10px;font-weight:750;letter-spacing:-0.03em;font-size:17px}.brand .logo{width:28px;height:28px;border-radius:9px;box-shadow:0 0 30px rgba(125,211,252,0.18)}.nav nav{display:flex;align-items:center;gap:24px;color:var(--muted);font-size:14px}.nav nav a:hover{color:var(--text)}main{width:min(var(--max),100%);margin:0 auto;padding:0 24px 72px}.hero{padding:78px 0 54px}.eyebrow{margin:0 0 10px;color:var(--accent);font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase}h1{margin:18px 0 24px;max-width:940px;font-size:clamp(42px,7.4vw,78px);line-height:1.02;letter-spacing:-0.05em;background:linear-gradient(115deg,#f8fbff 20%,#bfe8ff 55%,#f8c7e2 90%);-webkit-background-clip:text;background-clip:text;color:transparent}.lead{max-width:760px;margin:0;color:var(--muted);font-size:clamp(17px,2vw,20px);line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.button{display:inline-flex;align-items:center;justify-content:center;padding:12px 22px;border:1px solid transparent;border-radius:999px;background:linear-gradient(135deg,var(--accent),#60a5fa);color:#04111f;font-size:14px;font-weight:750;letter-spacing:-0.01em;transition:transform 160ms ease,filter 160ms ease}.button:hover{transform:translateY(-1px);filter:brightness(1.06)}.button.ghost{background:transparent;border-color:var(--line);color:var(--text)}.button.ghost:hover{border-color:rgba(125,211,252,0.45);background:rgba(125,211,252,0.06)}.hint{margin:24px 0 0;color:var(--muted);font-size:13.5px}.hint code,.footer code{color:var(--accent)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;padding:34px 0 12px}.card{position:relative;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:linear-gradient(180deg,var(--panel-strong),var(--panel));overflow:hidden}.card::after{content:"";position:absolute;inset:0;background:radial-gradient(240px 120px at 10% 0%,rgba(125,211,252,0.08),transparent 70%);pointer-events:none}.card h2{position:relative;margin:16px 0 8px;font-size:17px;letter-spacing:-0.02em}.card p{position:relative;margin:0;color:var(--muted);font-size:14.5px}.dot{display:block;width:9px;height:9px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 0 22px rgba(125,211,252,0.55)}.split{display:grid;grid-template-columns:1fr 1.08fr;gap:42px;align-items:center;padding:64px 0;border-top:1px solid var(--line)}.split h2{margin:0 0 12px;font-size:clamp(26px,3vw,36px);line-height:1.12;letter-spacing:-0.035em}.split p{margin:0 0 14px;color:var(--muted)}pre{margin:0;padding:22px;border:1px solid var(--line);border-radius:16px;background:#050914;overflow:auto;font-size:13px;line-height:1.75;box-shadow:inset 0 1px 0 rgba(255,255,255,0.03)}pre code{color:#c9d7ea;white-space:pre-wrap;overflow-wrap:anywhere}.bench{padding:62px 0;border-top:1px solid var(--line)}.bench h2{margin:0 0 10px;font-size:clamp(26px,3vw,36px);line-height:1.12;letter-spacing:-0.035em}.bench > p{max-width:780px;color:var(--muted)}table{width:100%;margin-top:26px;border-collapse:collapse;font-size:14px}th,td{padding:14px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{color:var(--muted);font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase}td:first-child{min-width:220px;font-weight:650}.bar{height:5px;margin-top:8px;border-radius:999px;background:rgba(148,163,184,0.14);overflow:hidden}.bar span{display:block;width:var(--bar);height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--accent-2))}.note{margin:22px 0 0;padding-left:16px;border-left:2px solid var(--accent);color:var(--muted);font-size:13.5px}.footer{width:min(var(--max),100%);margin:0 auto;padding:26px 24px 46px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;border-top:1px solid var(--line);color:var(--muted);font-size:13px}.footer a:hover{color:var(--text)}@media (max-width:820px){.split{grid-template-columns:1fr;gap:24px}.nav{padding:20px 18px}.nav nav{gap:14px;font-size:13px}main{padding:0 18px 56px}.hero{padding:54px 0 36px}h1{font-size:46px}table{display:block;overflow-x:auto;white-space:nowrap}}.byrust-warning{position:sticky;top:0;z-index:9999;padding:10px 16px;background:#7f1d1d;color:#fff;font:600 13px/1.4 system-ui,sans-serif;text-align:center}</style>
</head>
<body>
<header class="nav"> <a class="brand" href="/rustweb/"> <svg class="logo" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#0b1120" /><path d="M17 47V17h12.2c7.5 0 12 4.1 12 10.2 0 4.2-2.1 7.3-5.9 8.9L43 47h-8.2l-6.6-9.5h-3.5V47H17Zm7.7-15.9h4.1c3.2 0 5-1.5 5-4.2 0-2.7-1.8-4.1-5-4.1h-4.1v8.3Z" fill="#7dd3fc" /><circle cx="47.5" cy="17.5" r="3.5" fill="#7dd3fc" /></svg> RustWeb </a> <nav> <a href="/rustweb/">Start</a> <a href="/rustweb/about">MHTML</a> <a href="/rustweb/bench">Benchmark</a> </nav></header><main id="rweb-app"></main><footer class="footer"> <span>RustWeb 0.1.0 - MHTML + .rweb - <span id="year"></span></span> <span><a href="/rustweb/">start</a> - <a href="/rustweb/about">MHTML</a> - <a href="/rustweb/bench">benchmark</a></span> </footer>
<noscript>MHTML needs JavaScript.</noscript>
<template data-rweb-route="/" data-rweb-title="RustWeb - FastAPI dla Rusta"><section class="hero"><p class="eyebrow">Rust - FastAPI style - low latency</p><h1>API w Rustcie, ktore pisze sie jak w FastAPI.</h1><p class="lead">Deklarujesz typy wejscia i wyjscia. RustWeb daje walidacje, bledy 422 w ksztalcie FastAPI, OpenAPI i Swagger UI. Bez warstwy posredniej w hot path.</p><div class="actions"> <a class="button" href="/rustweb/bench">Zobacz benchmark</a> <a class="button ghost" href="/rustweb/about">Jak dziala MHTML</a> </div><p class="hint">Ta strona jest skompilowana do jednego pliku <code>site.rweb</code> i serwowana przez RustWeb. Zero templatingu w request path.</p></section><section class="grid"> <article class="card"> <span class="dot"></span> <h2>Makra zamiast boilerplate'u</h2><p>#[get], #[post] i #[model] zamieniaja sygnatury funkcji w routing, walidacje i schematy OpenAPI. Rozwijaja sie w czasie kompilacji.</p></article><article class="card"> <span class="dot"></span> <h2>Bledy, ktorych nie trzeba mapowac</h2><p>ApiJson, ApiPath i ApiQuery zwracaja 422 z detail[]{type, loc, msg, ctx}. Ksztalt znany z FastAPI, bez recznego klejenia JSON-a.</p></article><article class="card"> <span class="dot"></span> <h2>MHTML zamiast szablonow</h2><p>Mini-HTML z interpolacja, @if i @for. Kompilator rweb sklada strony, CSS, TypeScript i assety w jeden plik .rweb.</p></article><article class="card"> <span class="dot"></span> <h2>Zero narzutu w hot path</h2><p>Cienka warstwa nad axum. Benchmark na tej samej maszynie: 210 750 req/s dla RustWeb i 208 173 req/s dla czystego axum.</p></article> </section><section class="split"><div><p class="eyebrow">DX</p><h2>Pisz jak w FastAPI</h2><p>Makro rozwija sie w czasie kompilacji, wiec routing i dokumentacja nie kosztuja nic w czasie zadania. Walidacja jest jedyna dodatkowa praca i dzieje sie tylko wtedy, gdy jej uzyjesz.</p></div><pre><code>#[rustweb::get("/users/{id}")]
async fn get_user(ApiPath(id): ApiPath&lt;u64&gt;) -&gt; ApiResult&lt;Json&lt;User&gt;&gt; {
    Ok(Json(User { id, name: "Ada".into(), age: 36 }))
}</code></pre></section><section class="bench"><p class="eyebrow">Pomiar, nie obietnica</p><h2>RustWeb vs axum vs FastAPI</h2><p>Ten sam komputer, ta sama trasa /hello, ten sam load generator: 64 polaczenia keep-alive, 200 000 requestow, serwer przypiety do 2 rdzeni. FastAPI to uvicorn z 2 workerami.</p><table><thead><tr><th>Serwer</th><th>Throughput</th><th>p99</th></tr></thead><tbody> <tr><td> RustWeb <div class="bar"><span style="--bar: 100%"></span></div></td><td>210 750 req/s</td><td>0.70 ms</td></tr><tr><td> plain axum <div class="bar"><span style="--bar: 99%"></span></div></td><td>208 173 req/s</td><td>0.74 ms</td></tr><tr><td> FastAPI + uvicorn <div class="bar"><span style="--bar: 7%"></span></div></td><td>13.8-14.3k req/s</td><td>4.5-5.0 ms</td></tr> </tbody></table><p class="note">RustWeb i axum sa w granicach szumu. FastAPI jest wolniejsze, bo placi za Pythona i runtime Pydantic - nie za sam ksztalt API.</p></section><section class="split"><div><p class="eyebrow">MHTML ? .rweb</p><h2>Jeden plik, zero zaleznosci</h2><p>Strony piszesz w MHTML-u, budujesz komenda <code>rweb build site</code>, a RustWeb uruchamia wynik przez <code>rustweb site/site.rweb</code>.</p><p>linker.json wskazuje strony, style, skrypty i assety. Kompilator renderuje MHTML, inline'uje CSS, transpiluje TypeScript i zamienia obrazy na data URI. Wynik to jeden plik .rweb.</p></div><pre><code>&lt;h1&gt;{{ title }}&lt;/h1&gt;
@if show_badge {
  &lt;span class="badge"&gt;{{ version }}&lt;/span&gt;
}
@for feature in features {
  &lt;article&gt;{{ feature.title }}&lt;/article&gt;
}</code></pre></section></template>
<template data-rweb-route="/about" data-rweb-title="MHTML i .rweb - RustWeb"><section class="hero"><p class="eyebrow">MHTML - mini-HTML</p><h1>HTML, ktory kompiluje sie w jeden plik.</h1><p class="lead">MHTML to nasz mini-HTML: znaczniki, interpolacja i dwie dyrektywy. Kompilator <code>rweb</code> sklada strony, CSS, TypeScript i assety w jeden <code>.rweb</code>, ktory uruchamia RustWeb.</p></section><section class="grid"><article class="card"> <span class="dot"></span> <h2>{{ expression }}</h2><p>Wartosci pochodza z JSON-a w <code>linker.json</code> i sa escapowane w tekscie oraz atrybutach. Dane uzytkownika nie wstrzykna HTML-a.</p></article><article class="card"> <span class="dot"></span> <h2>&#64;if i &#64;for</h2><p>Warunki i petle dzialaja na danych projektu. W petli masz <code>loop.index</code>, <code>loop.first</code> i <code>loop.last</code>.</p></article><article class="card"> <span class="dot"></span> <h2>linker.json</h2><p>Jeden manifest wskazuje strony, style, skrypty i assety. Wszystkie sciezki sa rozwiazywane wzgledem pliku manifestu.</p></article><article class="card"> <span class="dot"></span> <h2>Zero runtime templatingu</h2><p>Strony sa renderowane przy budowaniu. RustWeb serwuje gotowy HTML, wiec request nie placi za parser ani evaluator.</p></article></section><section class="split"><div><p class="eyebrow">Skladnia</p><h2>Maly jezyk, ktory wystarcza</h2><p>Bez wbudowanego JavaScriptu, bez setek helperow. HTML, interpolacja, <code>&#64;if</code>, <code>&#64;else</code> i <code>&#64;for</code> - dokladnie tyle, ile potrzebuje strona.</p><p class="note">Literalny szablon jest zaufany; escapowane sa tylko wartosci interpolowane. Dzieki temu mozesz pisac encje HTML i wlasne znaczniki bez podwojnego escapowania.</p></div><pre><code>&lt;h1&gt;{{ title }}&lt;/h1&gt;
@if show_badge {
  &lt;span class="badge"&gt;{{ version }}&lt;/span&gt;
}
@for feature in features {
  &lt;article&gt;{{ feature.title }}&lt;/article&gt;
}</code></pre></section><section class="split"><div><p class="eyebrow">Kompilacja</p><h2>Jeden plik .rweb</h2><p><code>linker.json</code> opisuje strony i zasoby. Kompilator renderuje MHTML, inline'uje CSS, transpiluje TypeScript przez <code>tsc</code> i zamienia obrazy na data URI.</p><p>Build: <code>rweb build site</code>. Podglad: <code>rweb inspect site/site.rweb</code>. Uruchomienie: <code>rustweb site/site.rweb</code>.</p></div><pre><code>{ "site": { "title": "RustWeb", "version": "0.1.0" }, "styles": ["assets/style.css"], "scripts": ["scripts/app.ts"], "assets": ["assets/logo.svg"], "pages": [ { "route": "/", "file": "pages/index.mhtml" } ] }</code></pre></section><section class="split"><div><p class="eyebrow">Protokol byrust</p><h2>HTTPS, ktore mowi wiecej</h2><p><code>linker.json</code> ustawia <code>protocol.name = "byrust"</code>, wersje, wymog HTTPS, alias i wlasne naglowki. Kompilator wpisuje je do <code>.rweb</code> jako meta i <code>byrust-config</code>.</p><p>Tozsamosc aplikacji: <code>RustWeb</code> - <code>c5319283-50e1-5a0e-984e-97033f25f18e</code>. Puste <code>app.uuid</code> generuje stabilny UUID; <code>"universal"</code> oznacza niskie zaufanie i pokazuje "Page is not safe".</p><p><code>rustweb</code> tworzy lokalne CA i podpisuje certyfikat per aplikacja/host. Universal UUID uzywa osobnego, celowo niezaufanego CA - przegladarka ostrzega, a strona pokazuje czerwony banner.</p><p>Przegladarka nadal widzi <code>https://</code> - tylko TLS z zaufanym certyfikatem daje bezpieczny kontekst. <code>byrust://</code> jest aliasem obslugiwanym przez router, a <code>web+byrust</code> moze zarejestrowac sie jako handler w przegladarce.</p><p>Sprobuj: <a href="byrust://self/bench">byrust://self/bench</a></p></div><pre><code>"protocol": {
  "name": "byrust",
  "version": 1,
  "https": true,
  "alias": "byrust"
}</code></pre></section><section class="bench"><p class="eyebrow">Hostowanie</p><h2>Jeden plik, mniej RAM-u</h2><p><code>.rweb</code> jest zwyklym plikiem HTML. RustWeb laduje go raz i serwuje jako fallback dla wszystkich tras SPA. Nie ma runtime'owego bundlera, drzewa szablonow ani osobnych assetow.</p><p class="note">Pomiar RSS po starcie, bez ruchu: ~6,6 MB dla rustweb i ~153 MB dla FastAPI + uvicorn z dwoma workerami. Jeden proces, jeden plik HTML, zero runtime'owego templatingu.</p></section></template>
<template data-rweb-route="/bench" data-rweb-title="Benchmark - RustWeb"><section class="hero"><p class="eyebrow">Benchmark - 0.1.0</p><h1>Ile kosztuje warstwa frameworka? Nic, co widac w pomiarze.</h1><p class="lead">Ten sam komputer, ta sama trasa /hello, ten sam load generator: 64 polaczenia keep-alive, 200 000 requestow, serwer przypiety do 2 rdzeni. FastAPI to uvicorn z 2 workerami.</p></section><section class="bench"><table><thead><tr><th>Serwer</th><th>Throughput</th><th>p99</th></tr></thead><tbody> <tr><td> RustWeb <div class="bar"><span style="--bar: 100%"></span></div></td><td>210 750 req/s</td><td>0.70 ms</td></tr><tr><td> plain axum <div class="bar"><span style="--bar: 99%"></span></div></td><td>208 173 req/s</td><td>0.74 ms</td></tr><tr><td> FastAPI + uvicorn <div class="bar"><span style="--bar: 7%"></span></div></td><td>13.8-14.3k req/s</td><td>4.5-5.0 ms</td></tr> </tbody></table><p class="note">RustWeb i axum mieszcza sie w granicach szumu: raz RustWeb jest o 1-2% szybszy, raz o 1% wolniejszy. FastAPI jest wolniejsze o rzad wielkosci, bo placi za Pythona i runtime Pydantic.</p></section><section class="split"><div><p class="eyebrow">Metodologia</p><h2>Co dokladnie zmierzono</h2><p>Trasa <code>GET /hello</code> zwracajaca <code>Hello, World!</code>. 64 polaczenia keep-alive, 200 000 requestow, 10 000 warmup. Serwer przypiety do rdzeni 0-1, load generator do 2-5 przez <code>taskset</code>.</p><p>FastAPI: uvicorn 0.54 z dwoma workerami na tych samych dwoch rdzeniach. To porownanie runtime'ow na jednej maszynie, nie ranking absolutny.</p></div><div><p class="eyebrow">Reprodukcja</p><h2>Uruchom to sam</h2><pre><code>bash bench/run.sh</code></pre><p>Wyniki i warianty sa w <code>bench/RESULTS.md</code>. Walidacja nie jest czescia tego pomiaru - <code>ApiJson</code> doklada deserializacje i prace <code>validator</code>, zalezna od modelu i payloadu.</p></div></section><section class="bench"><p class="eyebrow">Wniosek</p><h2>Nie "najszybszy na swiecie". Po prostu bez narzutu.</h2><p>RustWeb nie probuje pobic axum wlasnym routerem. Bierze sprawdzony stos i doklada makra, walidacje oraz OpenAPI. Dlatego na trasie bez walidacji zostaje tyle samo pracy co w czystym axum.</p><p class="note">To jest cel: FastAPI-owe DX bez FastAPI-owego kosztu. Nie TechEmpower, nie benchmark marketingowy.</p><div class="actions"> <a class="button" href="/rustweb/about">Jak dziala MHTML</a> <a class="button ghost" href="/rustweb/">Wroc na start</a> </div></section></template>
<script>"use strict";
const updateYear = () => {
    const year = document.getElementById("year");
    if (year) {
        year.textContent = String(new Date().getFullYear());
    }
};
document.addEventListener("rweb:rendered", updateYear);
updateYear();

</script>
<script>(()=>{const t=new Map;document.querySelectorAll('template[data-rweb-route]').forEach(e=>t.set(e.dataset.rwebRoute,e));const base=document.querySelector('meta[name="rweb-base"]')?.content||'',a=document.getElementById('rweb-app'),f=t.get('/'),n=e=>{if(!e)e='/';if(base&&e.startsWith(base))e=e.slice(base.length)||'/';return e==='/'?'/':e.replace(/\/+$/,'')||'/'};const has=!!document.querySelector('meta[name="byrust"]'),al=document.querySelector('meta[name="byrust-alias"]')?.content||'byrust',sc=`${al}:`,ws=`web+${al}:`;const render=p=>{const q=n(p||location.pathname),x=t.get(q)||f;if(!x||!a)return;a.replaceChildren(x.content.cloneNode(!0));document.title=x.dataset.rwebTitle||document.title;document.dispatchEvent(new CustomEvent('rweb:rendered',{detail:{path:q}}));scrollTo(0,0)};const parse=u=>{try{const p=new URL(u);if(p.protocol!==sc&&p.protocol!==ws)return null;if(p.hostname&&p.hostname!=='self'&&p.hostname!==location.hostname)return null;return p}catch{return null}};if(has){try{const e=new URLSearchParams(location.search).get(al),p=e?parse(e):null;if(p){const u=base+p.pathname+p.search+p.hash;history.replaceState({},'',u);render(p.pathname)}}catch{}if(navigator.registerProtocolHandler){try{navigator.registerProtocolHandler(ws.slice(0,-1),`${location.origin}${base||''}/?${encodeURIComponent(al)}=%s`)}catch{}}}document.addEventListener('click',e=>{if(e.defaultPrevented||e.button!==0||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;const c=e.target.closest('a');if(!c||c.target||c.hasAttribute('download'))return;const h=c.getAttribute('href')||'';if(has&&(h.startsWith(`${al}://`)||h.startsWith(`web+${al}://`))){const p=parse(h);if(p){e.preventDefault();history.pushState({},'',base+p.pathname+p.search+p.hash);render(p.pathname)}return}const u=new URL(c.href,location.href);if(u.origin!==location.origin||u.hash)return;const q=n(u.pathname);if(q.startsWith('/api/')||q.startsWith('/docs')||q==='/openapi.json')return;e.preventDefault();history.pushState({},'',u);render()});addEventListener('popstate',()=>render());render()})();</script>
</body>
</html>
